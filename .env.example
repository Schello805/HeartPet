PORT=3000
# Standard: im Heimnetz erreichbar. Fuer nur lokalen Zugriff: 127.0.0.1
HEARTPET_HOST=0.0.0.0
# Optional, wenn Erinnerungslinks eine feste Adresse verwenden sollen.
# HEARTPET_APP_URL=https://tiere.example.de
# Optional: mindestens 32 zufällige Zeichen. Ohne Wert wird ein Geheimnis sicher erzeugt.
# HEARTPET_SESSION_SECRET=
HEARTPET_SESSION_DAYS=30
# HEARTPET_SECURE_COOKIE=true
# HEARTPET_TRUST_PROXY=loopback
