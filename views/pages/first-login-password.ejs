<!DOCTYPE html>
<html lang="de">
  <head>
    <% const assetVersion = encodeURIComponent(typeof appRevision !== 'undefined' ? appRevision : 'dev'); %>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Passwort ändern | HeartPet</title>
    <meta name="robots" content="noindex,nofollow,noarchive,nosnippet" />
    <%- include('../partials/app-icons') %>
    <link rel="stylesheet" href="/static/vendor/bootstrap/bootstrap.min.css" />
    <link rel="stylesheet" href="/static/css/theme-foundation.css?v=<%= assetVersion %>" />
    <link rel="stylesheet" href="/static/css/theme-layout.css?v=<%= assetVersion %>" />
    <link rel="stylesheet" href="/static/css/theme-components.css?v=<%= assetVersion %>" />
  </head>
  <body class="bootstrap-app" data-bs-theme="light">
    <main class="container py-5 min-vh-100 d-flex align-items-center">
      <div class="row justify-content-center w-100"><div class="col-12 col-md-7 col-lg-5">
        <section class="card border-0 shadow-sm bg-body-tertiary"><div class="card-body p-4 p-lg-5">
          <h1 class="h4 mb-2">Eigenes Passwort festlegen</h1>
          <p class="text-body-secondary">Das Einmalpasswort war nur für den ersten Login bestimmt. Lege jetzt ein persönliches Passwort fest.</p>
          <% if (flash) { %><div class="alert <%= flash.type === 'error' ? 'alert-danger' : 'alert-success' %>" role="alert"><%= flash.message %></div><% } %>
          <form method="post" action="/first-login/password" class="vstack gap-3">
            <div><label class="form-label" for="first-password">Neues Passwort</label><input class="form-control" id="first-password" type="password" name="new_password" minlength="8" required autocomplete="new-password" /></div>
            <div><label class="form-label" for="first-password-confirm">Passwort wiederholen</label><input class="form-control" id="first-password-confirm" type="password" name="new_password_confirm" minlength="8" required autocomplete="new-password" /></div>
            <button class="btn btn-success" type="submit">Passwort speichern und HeartPet öffnen</button>
          </form>
        </div></section>
      </div></div>
    </main>
    <script src="/static/vendor/bootstrap/bootstrap.bundle.min.js"></script>
    <script src="/static/js/password-visibility.js?v=<%= assetVersion %>"></script>
    <script src="/static/js/app.js?v=<%= assetVersion %>"></script>
  </body>
</html>
