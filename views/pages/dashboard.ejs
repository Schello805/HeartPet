<%- include('../partials/top', { pageTitle, pageClass: 'dashboard-page' }) %>
<% const searchState = typeof search !== 'undefined' ? search : { q: '', searchable: false }; %>
<% const dashboardSearchResults = typeof searchResults !== 'undefined' ? searchResults : []; %>
<% const urgentList = typeof urgentReminders !== 'undefined' ? urgentReminders : []; %>
<% const attentionList = typeof attentionAnimals !== 'undefined' ? attentionAnimals : []; %>
<% const speciesOverview = typeof speciesCounts !== 'undefined' ? speciesCounts : []; %>
<% const issueCount = attentionList.length; %>
<% const hasPriorityContent = urgentList.length > 0 || upcomingReminders.length > 0 || attentionList.length > 0; %>
<% const coopState = typeof coop !== 'undefined' ? coop : { cameras: [], temperature: null, humidity: null, climateError: '', temperatureConfigured: false, humidityConfigured: false, doorConfigured: false, doorCloseConfigured: false, doorSensorConfigured: false, doorIsOpen: null, doorLevelConfigured: false, doorOpenPercent: null }; %>
<% const weatherState = typeof weather !== 'undefined' ? weather : { configured: false, location: '', error: '' }; %>
<% const hasCoopClimate = coopState.temperatureConfigured || coopState.humidityConfigured; %>
<% const hasDoorControl = coopState.doorConfigured || coopState.doorCloseConfigured; %>
<% const cameraGroups = []; %>
<% coopState.cameras.forEach((camera, cameraIndex) => { const groupName = camera.group || 'Kameras'; let group = cameraGroups.find((item) => item.name === groupName); if (!group) { group = { name: groupName, cameras: [] }; cameraGroups.push(group); } group.cameras.push({ camera, cameraIndex }); }); %>

<% if (searchState.searchable) { %>
  <section class="card border-0 dashboard-feed-card mb-2">
    <div class="card-body p-2">
      <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
        <h2 class="h6 mb-0">Suchergebnisse</h2>
        <span class="badge text-bg-secondary-subtle border"><%= dashboardSearchResults.length %> Treffer</span>
      </div>
      <% if (!dashboardSearchResults.length) { %>
        <p class="text-body-secondary mb-0 small">Keine Ergebnisse gefunden.</p>
      <% } else { %>
        <div class="list-group list-group-flush dashboard-compact-list">
          <% dashboardSearchResults.slice(0, 6).forEach((item) => { %>
            <a class="list-group-item list-group-item-action bg-transparent rounded-3 border px-3 py-2" href="<%= item.href %>">
              <div class="d-flex flex-wrap justify-content-between gap-2">
                <div>
                  <div class="fw-semibold"><%= item.title %></div>
                  <div class="small text-body-secondary"><%= item.kind %> | <%= item.subtitle %></div>
                </div>
                <div class="small text-body-secondary"><%= item.when || '' %></div>
              </div>
            </a>
          <% }) %>
        </div>
      <% } %>
    </div>
  </section>
<% } %>

<div class="row g-2 mb-2 dashboard-inventory-section">
  <div class="col-12">
    <section class="card border-0 h-100 dashboard-surface-card">
      <div class="card-body p-2">
        <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
          <div>
            <h2 class="h5 mb-1">Tierbestand</h2>
            <p class="text-body-secondary mb-0 small">Aktive Tiere nach Tierart.</p>
          </div>
          <a href="/animals" class="badge text-bg-primary text-decoration-none"><%= stats.animalCount %> Tiere</a>
        </div>

        <% if (!speciesOverview.length) { %>
          <a href="/animals/new" class="card border text-decoration-none h-100" data-drawer="animal-form">
            <div class="card-body p-2">
              <div class="fw-semibold mb-1">Noch keine Tiere angelegt</div>
              <div class="small text-body-secondary">Starte mit der ersten Tierakte.</div>
            </div>
          </a>
        <% } else { %>
          <div class="row g-2">
            <% speciesOverview.forEach((species) => { %>
              <div class="col-6 col-lg-4 col-xl-3">
                <a class="card h-100 border-0 text-decoration-none dashboard-stat-card dashboard-kpi-link" href="/animals<%= species.species_id ? `?species_id=${species.species_id}` : '' %>">
                  <div class="card-body p-2">
                    <div class="d-flex align-items-center gap-2 mb-1">
                      <span class="dashboard-species-icon" aria-hidden="true"><%= getAnimalSpeciesIcon(species.name) %></span>
                      <span class="small text-body-secondary"><%= species.name %></span>
                    </div>
                    <strong class="fw-semibold text-primary d-block"><%= species.count %></strong>
                  </div>
                </a>
              </div>
            <% }) %>
          </div>
        <% } %>
      </div>
    </section>
  </div>

</div>

<% if (hasPriorityContent) { %>
<div class="row g-2 dashboard-priority-grid dashboard-priority-section">
  <% if (urgentList.length > 0) { %>
  <div class="<%= upcomingReminders.length > 0 ? 'col-lg-6' : 'col-12' %>">
    <article class="card border-0 h-100 dashboard-feed-card dashboard-surface-card semantic-card <%= urgentList.length > 0 ? 'semantic-card--danger' : 'semantic-card--ok' %>" id="dringende-erinnerungen">
      <div class="card-body p-2">
        <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
          <div>
            <h2 class="h5 mb-1">Dringend</h2>
            <p class="text-body-secondary mb-0 small">Überfällig oder heute fällig.</p>
          </div>
          <span class="badge <%= urgentList.length > 0 ? 'text-bg-danger' : 'text-bg-success' %>"><%= urgentList.length %></span>
        </div>
          <div class="list-group list-group-flush dashboard-compact-list">
            <% urgentList.slice(0, 4).forEach((reminder) => { %>
              <% const reminderHref = reminder.animal_id ? `/animals/${reminder.animal_id}#animal-medizin` : null; %>
              <div class="list-group-item bg-transparent rounded-3 border px-3 py-2">
                <div class="d-flex justify-content-between align-items-start gap-3">
                  <<%= reminderHref ? 'a' : 'div' %> class="text-decoration-none text-reset flex-grow-1" <% if (reminderHref) { %>href="<%= reminderHref %>"<% } %>>
                    <div class="fw-semibold"><%= reminder.title %></div>
                    <div class="small text-body-secondary"><%= reminder.animal_name || "Ohne Tierzuordnung" %> | <%= reminder.reminder_type %></div>
                    <div class="small text-body-secondary mt-1">Fällig: <%= formatDateTime(reminder.due_at) %></div>
                  </<%= reminderHref ? 'a' : 'div' %>>
                  <span class="badge <%= reminder.urgency === 'overdue' ? 'text-bg-danger' : reminder.urgency === 'today' ? 'text-bg-warning' : 'text-bg-secondary' %>">
                    <%= reminder.urgency === 'overdue' ? 'Überfällig' : reminder.urgency === 'today' ? 'Heute' : 'Bald' %>
                  </span>
                </div>
                <% if (!reminder.completed_at && permissions.canManageReminders) { %>
                  <form method="post" action="/reminders/<%= reminder.id %>/complete" class="mt-2">
                    <button type="submit" class="btn btn-success btn-sm w-100" aria-label="Als erledigt markieren: <%= reminder.title %>">Erledigt</button>
                  </form>
                <% } %>
              </div>
            <% }) %>
          </div>
      </div>
    </article>
  </div>
  <% } %>

  <% if (upcomingReminders.length > 0) { %>
  <div class="<%= urgentList.length > 0 ? 'col-lg-6' : 'col-12' %>">
    <article class="card border-0 h-100 dashboard-feed-card dashboard-surface-card semantic-card <%= upcomingReminders.length > 0 ? 'semantic-card--info' : 'semantic-card--ok' %>" id="naechste-erinnerungen">
      <div class="card-body p-2">
        <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
          <div>
            <h2 class="h5 mb-1">Demnächst</h2>
            <p class="text-body-secondary mb-0 small">Offene Erinnerungen nach heute.</p>
          </div>
          <span class="badge <%= upcomingReminders.length > 0 ? 'text-bg-info' : 'text-bg-success' %>"><%= upcomingReminders.length %></span>
        </div>
          <div class="list-group list-group-flush dashboard-compact-list">
            <% upcomingReminders.slice(0, 4).forEach((reminder) => { %>
              <% const upcomingHref = reminder.animal_id ? `/animals/${reminder.animal_id}#animal-medizin` : null; %>
              <div class="list-group-item bg-transparent rounded-3 border px-3 py-2">
                <div class="d-flex flex-column justify-content-between gap-2">
                  <<%= upcomingHref ? 'a' : 'div' %> class="text-decoration-none text-reset" <% if (upcomingHref) { %>href="<%= upcomingHref %>"<% } %>>
                    <div class="fw-semibold"><%= reminder.title %></div>
                    <div class="small text-body-secondary"><%= reminder.animal_name || "Ohne Tierzuordnung" %> | <%= reminder.reminder_type %></div>
                    <div class="small text-body-secondary mt-1">Fällig: <%= formatDateTime(reminder.due_at) %></div>
                  </<%= upcomingHref ? 'a' : 'div' %>>
                  <% if (!reminder.completed_at && permissions.canManageReminders) { %>
                    <form method="post" action="/reminders/<%= reminder.id %>/complete">
                      <button type="submit" class="btn btn-success btn-sm w-100" aria-label="Als erledigt markieren: <%= reminder.title %>">Erledigt</button>
                    </form>
                  <% } %>
                </div>
              </div>
            <% }) %>
          </div>
      </div>
    </article>
  </div>
  <% } %>

  <% if (attentionList.length > 0) { %>
  <div class="col-12">
    <article class="card border-0 dashboard-surface-card semantic-card <%= issueCount > 0 ? 'semantic-card--warning' : 'semantic-card--ok' %>">
      <div class="card-body p-2">
        <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
          <div>
            <h2 class="h5 mb-1">Hinweise</h2>
            <p class="text-body-secondary mb-0 small">Nur konkrete offene Punkte. Nullmeldungen bleiben bewusst weg.</p>
          </div>
          <a href="/animals" class="small text-decoration-none">Tiere prüfen</a>
        </div>

          <div class="row g-2">
            <% attentionList.slice(0, 4).forEach((animal) => { %>
              <div class="col-12 col-md-6">
                <a class="card border text-decoration-none dashboard-kpi-link h-100" href="/animals?animal_id=<%= animal.id %>">
                  <div class="card-body p-2 d-flex align-items-center gap-2">
                    <% if (animal.profile_image_stored_name) { %>
                      <img class="dashboard-animal-thumb" src="/media/<%= animal.profile_image_stored_name %>" alt="" />
                    <% } else { %>
                      <span class="dashboard-animal-thumb dashboard-animal-thumb--fallback" title="<%= animal.species_name || 'Tier' %>"><%= getAnimalSpeciesIcon(animal.species_name) %></span>
                    <% } %>
                    <div class="min-w-0">
                      <strong class="d-block text-truncate"><span aria-hidden="true"><%= getAnimalSpeciesIcon(animal.species_name) %></span> <%= animal.name %></strong>
                      <div class="d-flex flex-wrap gap-1 mt-1">
                        <% (animal.dashboardAttentionReasons || []).forEach((reason) => { %>
                          <span class="badge text-bg-warning"><%= reason %></span>
                        <% }) %>
                      </div>
                    </div>
                  </div>
                </a>
              </div>
            <% }) %>
          </div>
      </div>
    </article>
  </div>
  <% } %>
</div>
<% } %>

<section class="card border-0 dashboard-surface-card dashboard-weather-card dashboard-weather-section mb-2">
  <div class="card-body p-2">
    <div class="d-flex justify-content-between align-items-center gap-2 mb-2">
      <div>
        <h2 class="h5 mb-1">Wetter in <%= weatherState.location || 'deinem Ort' %></h2>
        <p class="text-body-secondary small mb-0">Temperatur und Luftfeuchte am Standort.</p>
      </div>
      <span class="dashboard-visual-icon" aria-hidden="true"><%= weatherState.icon || '🌤️' %></span>
    </div>
    <% if (weatherState.error) { %>
      <div class="alert alert-warning py-2 mb-0 small"><%= weatherState.error %></div>
    <% } else if (weatherState.configured) { %>
      <div class="row g-2">
        <div class="col-6 col-lg-3"><div class="card border h-100"><div class="card-body p-2 text-center"><span class="dashboard-metric-icon" aria-hidden="true">🌡</span><span class="small text-body-secondary d-block"><%= weatherState.label || 'Aktuell' %></span><strong class="dashboard-weather-value"><%= Number.isFinite(weatherState.temperature) ? `${weatherState.temperature.toLocaleString('de-DE', { maximumFractionDigits: 1 })} °C` : '–' %></strong></div></div></div>
        <div class="col-6 col-lg-3"><div class="card border h-100"><div class="card-body p-2 text-center"><span class="dashboard-metric-icon" aria-hidden="true">💧</span><span class="small text-body-secondary d-block">Luftfeuchte außen</span><strong class="dashboard-weather-value"><%= Number.isFinite(weatherState.humidity) ? `${weatherState.humidity.toLocaleString('de-DE', { maximumFractionDigits: 0 })} %` : '–' %></strong></div></div></div>
      </div>
    <% } %>
  </div>
</section>

<% if (hasCoopClimate) { %>
<section class="card border-0 dashboard-surface-card dashboard-climate-section mb-2">
  <div class="card-body p-2">
    <div class="d-flex justify-content-between align-items-center mb-2"><h2 class="h5 mb-0">Klima im Stall</h2><span class="dashboard-visual-icon" aria-hidden="true">🌡️</span></div>
    <div class="row g-2">
      <% if (coopState.climateError) { %><div class="col-12"><div class="alert alert-warning py-2 mb-0 small"><%= coopState.climateError %></div></div><% } %>
      <% if (coopState.temperatureConfigured) { %><div class="col-6 col-lg-3"><div class="card border h-100"><div class="card-body p-2 text-center"><span class="dashboard-metric-icon" aria-hidden="true">🌡</span><span class="small text-body-secondary d-block">Temperatur</span><strong class="fs-4"><%= coopState.temperature !== null ? `${coopState.temperature.toLocaleString('de-DE', { maximumFractionDigits: 1 })} °C` : 'Nicht verfügbar' %></strong></div></div></div><% } %>
      <% if (coopState.humidityConfigured) { %><div class="col-6 col-lg-3"><div class="card border h-100"><div class="card-body p-2 text-center"><span class="dashboard-metric-icon" aria-hidden="true">💧</span><span class="small text-body-secondary d-block">Luftfeuchte</span><strong class="fs-4"><%= coopState.humidity !== null ? `${coopState.humidity.toLocaleString('de-DE', { maximumFractionDigits: 1 })} %` : 'Nicht verfügbar' %></strong></div></div></div><% } %>
    </div>
  </div>
</section>
<% } %>

<% if (hasDoorControl) { %>
<section class="card border-0 dashboard-surface-card dashboard-door-section mb-2" id="coop-control">
  <div class="card-body p-2">
    <div class="d-flex justify-content-between align-items-center gap-2 mb-2">
      <div><h2 class="h5 mb-1">Stalltür</h2><p class="small text-body-secondary mb-0">Tageszeiten, Position und Steuerung.</p></div>
      <span class="badge text-bg-primary-subtle border">Automatik</span>
    </div>
    <div class="dashboard-door-schedule dashboard-door-schedule--sunrise">
      <span class="dashboard-door-sun" aria-hidden="true">☀</span>
      <span><span class="small text-body-secondary d-block">Sonnenaufgang</span><small class="text-success-emphasis">Stalltür öffnet</small></span>
      <strong><%= weatherState.sunrise ? formatDateTime(weatherState.sunrise).slice(11) : '–' %></strong>
    </div>
    <div class="dashboard-door-hero">
      <div class="dashboard-door-percentage"><%= coopState.doorOpenPercent !== null ? `${coopState.doorOpenPercent} % geöffnet` : coopState.doorLevelConfigured ? 'Öffnungsgrad nicht verfügbar' : 'Öffnungsgrad nicht eingerichtet' %></div>
      <div class="dashboard-shutter-frame" style="--door-open: <%= coopState.doorOpenPercent !== null ? coopState.doorOpenPercent : coopState.doorIsOpen === true ? 100 : 0 %>%" aria-hidden="true">
        <div class="dashboard-shutter-panel"></div>
        <div class="dashboard-shutter-handle"></div>
      </div>
      <strong class="dashboard-door-status"><%= coopState.doorIsOpen === true ? 'Offen' : coopState.doorIsOpen === false ? 'Geschlossen' : 'Status unbekannt' %></strong>
    </div>
    <div class="dashboard-door-schedule dashboard-door-schedule--sunset">
      <span class="dashboard-door-sun" aria-hidden="true">☾</span>
      <span><span class="small text-body-secondary d-block">Sonnenuntergang</span><small class="text-primary-emphasis">Stalltür schließt</small></span>
      <strong><%= weatherState.sunset ? formatDateTime(weatherState.sunset).slice(11) : '–' %></strong>
    </div>
    <div class="row g-2 mt-1">
      <% if (coopState.doorConfigured) { %><div class="col-6 d-grid"><form method="post" action="/coop/door/open" class="d-grid" data-confirm="Die Stalltür jetzt öffnen?" data-confirm-modal data-confirm-title="Stalltür öffnen"><button type="submit" class="btn btn-primary dashboard-door-button">↗ Öffnen</button></form></div><% } %>
      <% if (coopState.doorCloseConfigured) { %><div class="col-6 d-grid"><form method="post" action="/coop/door/close" class="d-grid" data-confirm="Die Stalltür jetzt schließen?" data-confirm-modal data-confirm-title="Stalltür schließen"><button type="submit" class="btn btn-outline-primary dashboard-door-button">↘ Schließen</button></form></div><% } %>
    </div>
  </div>
</section>
<% } %>

<% if (coopState.cameras.length) { %>
<section class="card border-0 dashboard-surface-card dashboard-coop-section mb-2">
  <div class="card-body p-2">
    <div class="d-flex justify-content-between align-items-center mb-2"><h2 class="h5 mb-0">Kameras</h2><span class="badge text-bg-secondary-subtle border"><%= coopState.cameras.length %></span></div>
    <div class="vstack gap-3">
      <% cameraGroups.forEach((cameraGroup) => { %>
        <section>
          <h3 class="h6 text-body-secondary mb-2"><%= cameraGroup.name %></h3>
          <div class="dashboard-camera-grid">
          <% cameraGroup.cameras.forEach(({ camera, cameraIndex }) => { %>
          <figure class="card border h-100 mb-0 overflow-hidden dashboard-camera-card" data-camera-card data-camera-status-url="/coop/cameras/<%= cameraIndex %>/status" data-camera-stream-url="/coop/cameras/<%= cameraIndex %>/stream">
            <img src="/coop/cameras/<%= cameraIndex %>/frame" data-camera-frame-url="/coop/cameras/<%= cameraIndex %>/frame" class="card-img-top ratio ratio-16x9 object-fit-cover" alt="Kamerabild <%= camera.name %>" loading="lazy" data-camera-image />
            <div class="alert alert-warning rounded-0 mb-0 d-none small" data-camera-error></div>
            <figcaption class="card-body p-2 d-flex align-items-center justify-content-between gap-2">
              <strong>📷 <%= camera.name %></strong>
              <button type="button" class="btn btn-sm btn-outline-primary" data-camera-stream-toggle>Stream starten</button>
            </figcaption>
          </figure>
          <% }) %>
          </div>
        </section>
      <% }) %>
    </div>
  </div>
</section>
<% } %>

<%- include('../partials/bottom') %>
