<%- include('../partials/top', { pageTitle, pageClass: 'dashboard-page' }) %>
<% const searchState = typeof search !== 'undefined' ? search : { q: '', searchable: false }; %>
<% const dashboardSearchResults = typeof searchResults !== 'undefined' ? searchResults : []; %>
<% const healthState = typeof dashboardHealth !== 'undefined' ? dashboardHealth : { staleAnimals: [], animalsWithoutVeterinarian: [], animalsWithIncompleteProfile: [] }; %>
<% const urgentList = typeof urgentReminders !== 'undefined' ? urgentReminders : []; %>
<% const attentionList = typeof attentionAnimals !== 'undefined' ? attentionAnimals : []; %>
<% const speciesOverview = typeof speciesCounts !== 'undefined' ? speciesCounts : []; %>
<% const issueCount = healthState.staleAnimals.length + healthState.animalsWithoutVeterinarian.length + healthState.animalsWithIncompleteProfile.length + urgentList.length + upcomingReminders.length; %>

<section class="card border-0 dashboard-hero-card mb-2">
  <div class="card-body p-3">
    <div class="row g-3 align-items-center">
      <div class="col-lg-6">
        <div class="text-uppercase small fw-semibold text-body-secondary mb-1">Dashboard</div>
        <h2 class="h4 mb-1">Bestand und Handlungsbedarf auf einen Blick.</h2>
        <p class="text-body-secondary mb-0">Oben Bestand, darunter Erinnerungen, dann konkrete Hinweise. Jede Karte führt direkt in den passenden Bereich.</p>
      </div>
      <div class="col-lg-6">
        <form method="get" action="/" class="row g-2 dashboard-search-form">
          <div class="col-12 col-md">
            <div class="search-autocomplete-field">
              <input class="form-control" type="search" name="q" value="<%= searchState.q || '' %>" placeholder="Tiere, Dokumente, Ereignisse suchen ..." autocomplete="off" data-global-search-autocomplete="true" />
            </div>
          </div>
          <div class="col-12 col-md-auto">
            <button type="submit" class="btn btn-primary w-100">Suchen</button>
          </div>
        </form>
        <% if (searchState.q && !searchState.searchable) { %>
          <p class="small text-body-secondary mb-0 mt-2">Bitte mindestens 2 Zeichen eingeben.</p>
        <% } %>
      </div>
    </div>
  </div>
</section>

<% if (searchState.searchable) { %>
  <section class="card border-0 dashboard-feed-card mb-2">
    <div class="card-body p-3">
      <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
        <h2 class="h6 mb-0">Suchergebnisse</h2>
        <span class="badge text-bg-secondary-subtle border"><%= dashboardSearchResults.length %> Treffer</span>
      </div>
      <% if (!dashboardSearchResults.length) { %>
        <p class="text-body-secondary mb-0 small">Keine Ergebnisse gefunden.</p>
      <% } else { %>
        <div class="list-group list-group-flush dashboard-compact-list">
          <% dashboardSearchResults.slice(0, 6).forEach((item) => { %>
            <a class="list-group-item list-group-item-action bg-transparent rounded-3 border px-3 py-2" href="<%= item.href %>">
              <div class="d-flex flex-wrap justify-content-between gap-2">
                <div>
                  <div class="fw-semibold"><%= item.title %></div>
                  <div class="small text-body-secondary"><%= item.kind %> | <%= item.subtitle %></div>
                </div>
                <div class="small text-body-secondary"><%= item.when || '' %></div>
              </div>
            </a>
          <% }) %>
        </div>
      <% } %>
    </div>
  </section>
<% } %>

<div class="row g-2 mb-2">
  <div class="col-xl-5">
    <section class="card border-0 h-100 dashboard-surface-card">
      <div class="card-body p-3">
        <div class="d-flex justify-content-between align-items-start gap-2 mb-3">
          <div>
            <h2 class="h5 mb-1">Tierbestand</h2>
            <p class="text-body-secondary mb-0 small">Aktive Tiere nach Tierart.</p>
          </div>
          <a href="/animals" class="badge text-bg-primary text-decoration-none"><%= stats.animalCount %> Tiere</a>
        </div>

        <% if (!speciesOverview.length) { %>
          <a href="/animals/new" class="card border text-decoration-none h-100" data-drawer="animal-form">
            <div class="card-body p-3">
              <div class="fw-semibold mb-1">Noch keine Tiere angelegt</div>
              <div class="small text-body-secondary">Starte mit der ersten Tierakte.</div>
            </div>
          </a>
        <% } else { %>
          <div class="row g-2">
            <div class="col-12">
              <a class="card h-100 border-0 text-decoration-none dashboard-stat-card dashboard-kpi-link semantic-card semantic-card--info" href="/animals">
                <div class="card-body p-3">
                  <span class="small text-body-secondary d-block mb-1">Gesamt</span>
                  <strong class="fw-semibold text-primary d-block"><%= stats.animalCount %></strong>
                </div>
              </a>
            </div>
            <% speciesOverview.forEach((species) => { %>
              <div class="col-sm-6">
                <a class="card h-100 border-0 text-decoration-none dashboard-stat-card dashboard-kpi-link" href="/animals<%= species.species_id ? `?species_id=${species.species_id}` : '' %>">
                  <div class="card-body p-3">
                    <span class="small text-body-secondary d-block mb-1"><%= species.name %></span>
                    <strong class="fw-semibold text-primary d-block"><%= species.count %></strong>
                  </div>
                </a>
              </div>
            <% }) %>
          </div>
        <% } %>
      </div>
    </section>
  </div>

  <div class="col-xl-7">
    <section class="card border-0 h-100 dashboard-surface-card">
      <div class="card-body p-3">
        <div class="d-flex justify-content-between align-items-start gap-2 mb-3">
          <div>
            <h2 class="h5 mb-1">Erinnerungen</h2>
            <p class="text-body-secondary mb-0 small">Was aktuell offen ist oder bald ansteht.</p>
          </div>
          <a href="/#dringende-erinnerungen" class="small text-decoration-none">Details</a>
        </div>
        <div class="row g-2">
          <div class="col-6 col-lg-3">
            <a class="card h-100 border-0 text-decoration-none dashboard-stat-card dashboard-kpi-link semantic-card <%= stats.openReminderCount > 0 ? 'semantic-card--danger' : 'semantic-card--ok' %>" href="/animals#animal-medizin">
              <div class="card-body p-3">
                <span class="small text-body-secondary d-block mb-1">Offen</span>
                <strong class="fw-semibold d-block"><%= stats.openReminderCount %></strong>
              </div>
            </a>
          </div>
          <div class="col-6 col-lg-3">
            <a class="card h-100 border-0 text-decoration-none dashboard-stat-card dashboard-kpi-link semantic-card <%= stats.dueReminderCount > 0 ? 'semantic-card--danger' : 'semantic-card--ok' %>" href="/#dringende-erinnerungen">
              <div class="card-body p-3">
                <span class="small text-body-secondary d-block mb-1">Jetzt fällig</span>
                <strong class="fw-semibold d-block"><%= stats.dueReminderCount %></strong>
              </div>
            </a>
          </div>
          <div class="col-6 col-lg-3">
            <a class="card h-100 border-0 text-decoration-none dashboard-stat-card dashboard-kpi-link semantic-card <%= healthState.staleAnimals.length > 0 ? 'semantic-card--warning' : 'semantic-card--ok' %>" href="/animals">
              <div class="card-body p-3">
                <span class="small text-body-secondary d-block mb-1">7 Tage ruhig</span>
                <strong class="fw-semibold d-block"><%= healthState.staleAnimals.length %></strong>
              </div>
            </a>
          </div>
          <div class="col-6 col-lg-3">
            <a class="card h-100 border-0 text-decoration-none dashboard-stat-card dashboard-kpi-link semantic-card <%= upcomingReminders.length > 0 ? 'semantic-card--info' : 'semantic-card--ok' %>" href="/#naechste-erinnerungen">
              <div class="card-body p-3">
                <span class="small text-body-secondary d-block mb-1">Demnächst</span>
                <strong class="fw-semibold d-block"><%= upcomingReminders.length %></strong>
              </div>
            </a>
          </div>
        </div>
      </div>
    </section>
  </div>
</div>

<div class="row g-2 dashboard-priority-grid">
  <div class="col-lg-6">
    <article class="card border-0 h-100 dashboard-feed-card dashboard-surface-card semantic-card <%= urgentList.length > 0 ? 'semantic-card--danger' : 'semantic-card--ok' %>" id="dringende-erinnerungen">
      <div class="card-body p-3">
        <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
          <div>
            <h2 class="h5 mb-1">Dringend</h2>
            <p class="text-body-secondary mb-0 small">Überfällig oder heute fällig.</p>
          </div>
          <span class="badge <%= urgentList.length > 0 ? 'text-bg-danger' : 'text-bg-success' %>"><%= urgentList.length %></span>
        </div>
        <% if (urgentList.length === 0) { %>
          <p class="text-body-secondary mb-0 small">Keine dringenden Erinnerungen vorhanden.</p>
        <% } else { %>
          <div class="list-group list-group-flush dashboard-compact-list">
            <% urgentList.slice(0, 4).forEach((reminder) => { %>
              <% const reminderHref = reminder.animal_id ? `/animals/${reminder.animal_id}${reminder.source_kind ? '#animal-medizin' : '#animal-neu'}` : null; %>
              <<%= reminderHref ? 'a' : 'div' %> class="list-group-item <%= reminderHref ? 'list-group-item-action' : '' %> bg-transparent rounded-3 border px-3 py-2" <% if (reminderHref) { %>href="<%= reminderHref %>"<% } %>>
                <div class="d-flex justify-content-between align-items-start gap-3">
                  <div>
                    <div class="fw-semibold"><%= reminder.title %></div>
                    <div class="small text-body-secondary"><%= reminder.animal_name || "Ohne Tierzuordnung" %> | <%= reminder.reminder_type %></div>
                    <div class="small text-body-secondary mt-1">Fällig: <%= formatDateTime(reminder.due_at) %></div>
                  </div>
                  <span class="badge <%= reminder.urgency === 'overdue' ? 'text-bg-danger' : reminder.urgency === 'today' ? 'text-bg-warning' : 'text-bg-secondary' %>">
                    <%= reminder.urgency === 'overdue' ? 'Überfällig' : reminder.urgency === 'today' ? 'Heute' : 'Bald' %>
                  </span>
                </div>
              </<%= reminderHref ? 'a' : 'div' %>>
            <% }) %>
          </div>
        <% } %>
      </div>
    </article>
  </div>

  <div class="col-lg-6">
    <article class="card border-0 h-100 dashboard-feed-card dashboard-surface-card semantic-card <%= upcomingReminders.length > 0 ? 'semantic-card--info' : 'semantic-card--ok' %>" id="naechste-erinnerungen">
      <div class="card-body p-3">
        <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
          <div>
            <h2 class="h5 mb-1">Demnächst</h2>
            <p class="text-body-secondary mb-0 small">Offene Erinnerungen nach heute.</p>
          </div>
          <span class="badge <%= upcomingReminders.length > 0 ? 'text-bg-info' : 'text-bg-success' %>"><%= upcomingReminders.length %></span>
        </div>
        <% if (upcomingReminders.length === 0) { %>
          <p class="text-body-secondary mb-0 small">Keine kommenden Erinnerungen vorhanden.</p>
        <% } else { %>
          <div class="list-group list-group-flush dashboard-compact-list">
            <% upcomingReminders.slice(0, 4).forEach((reminder) => { %>
              <div class="list-group-item bg-transparent rounded-3 border px-3 py-2">
                <div class="d-flex flex-column justify-content-between gap-2">
                  <div>
                    <div class="fw-semibold"><%= reminder.title %></div>
                    <div class="small text-body-secondary"><%= reminder.animal_name || "Ohne Tierzuordnung" %> | <%= reminder.reminder_type %></div>
                    <div class="small text-body-secondary mt-1">Fällig: <%= formatDateTime(reminder.due_at) %></div>
                  </div>
                  <% if (!reminder.completed_at && permissions.canManageReminders) { %>
                    <form method="post" action="/reminders/<%= reminder.id %>/complete">
                      <button type="submit" class="btn btn-outline-secondary btn-sm">Als erledigt markieren</button>
                    </form>
                  <% } %>
                </div>
              </div>
            <% }) %>
          </div>
        <% } %>
      </div>
    </article>
  </div>

  <div class="col-12">
    <article class="card border-0 dashboard-surface-card semantic-card <%= issueCount > 0 ? 'semantic-card--warning' : 'semantic-card--ok' %>">
      <div class="card-body p-3">
        <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
          <div>
            <h2 class="h5 mb-1">Hinweise</h2>
            <p class="text-body-secondary mb-0 small">Nur konkrete offene Punkte. Nullmeldungen bleiben bewusst weg.</p>
          </div>
          <a href="/animals" class="small text-decoration-none">Tiere prüfen</a>
        </div>

        <% if (!attentionList.length) { %>
          <p class="text-body-secondary mb-0 small">Alles sauber. Keine offenen Hinweise für aktive Tiere.</p>
        <% } else { %>
          <div class="row g-2">
            <% attentionList.slice(0, 6).forEach((animal) => { %>
              <div class="col-md-6 col-xl-4">
                <a class="card h-100 border text-decoration-none dashboard-kpi-link" href="/animals/<%= animal.id %>">
                  <div class="card-body p-3">
                    <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                      <div>
                        <div class="fw-semibold"><%= animal.name %></div>
                        <div class="small text-body-secondary"><%= animal.species_name || '-' %></div>
                      </div>
                      <% if (animal.next_term) { %>
                        <span class="badge text-bg-secondary-subtle border"><%= animal.next_term.displayLabel %></span>
                      <% } %>
                    </div>
                    <div class="d-flex flex-wrap gap-1">
                      <% animal.dashboardAttentionReasons.slice(0, 4).forEach((reason) => { %>
                        <span class="badge text-bg-warning"><%= reason %></span>
                      <% }) %>
                    </div>
                  </div>
                </a>
              </div>
            <% }) %>
          </div>
        <% } %>
      </div>
    </article>
  </div>
</div>

<%- include('../partials/bottom') %>
