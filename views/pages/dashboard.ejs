<%- include('../partials/top', { pageTitle, pageClass: 'dashboard-page' }) %>
<% const searchState = typeof search !== 'undefined' ? search : { q: '', searchable: false }; %>
<% const dashboardSearchResults = typeof searchResults !== 'undefined' ? searchResults : []; %>
<% const healthState = typeof dashboardHealth !== 'undefined' ? dashboardHealth : { staleAnimals: [], animalsWithoutVeterinarian: [], animalsMissingRequiredDocuments: [], animalsWithIncompleteProfile: [] }; %>
<% const urgentList = typeof urgentReminders !== 'undefined' ? urgentReminders : []; %>
<% const attentionList = typeof attentionAnimals !== 'undefined' ? attentionAnimals : []; %>
<% const activityList = typeof recentActivity !== 'undefined' ? recentActivity : []; %>

<div class="row g-2 mb-2">
  <div class="col-12">
    <section class="card border-0 dashboard-hero-card">
      <div class="card-body p-4">
        <div class="row g-3 align-items-center">
          <div class="col-lg-6">
            <div class="text-uppercase small fw-semibold text-body-secondary mb-1">Heute</div>
            <h2 class="h3 mb-2">Bestand, Aufgaben, nächste Aktion.</h2>
            <p class="text-body-secondary mb-2">Das Dashboard zeigt nur, was jetzt relevant ist. Jede Karte führt direkt zum passenden Arbeitsbereich.</p>
            <div class="d-flex flex-wrap gap-2">
              <span class="badge text-bg-secondary-subtle border">Aktiver Bestand: <%= stats.animalCount %></span>
              <span class="badge text-bg-secondary-subtle border">Offene Erinnerungen: <%= stats.openReminderCount %></span>
              <span class="badge text-bg-secondary-subtle border">Heute fällig: <%= stats.dueReminderCount %></span>
            </div>
            <div class="d-flex flex-wrap gap-2 mt-2 dashboard-hero-actions">
              <a href="/animals" class="btn btn-outline-secondary btn-sm">Tiere öffnen</a>
              <% if (permissions.canEditAnimals) { %>
                <a href="/animals/new" class="btn btn-primary btn-sm" data-drawer="animal-form">Neues Tier</a>
              <% } %>
              <% if (permissions.canManageAdmin) { %>
                <a href="/admin/allgemein" class="btn btn-outline-secondary btn-sm">Verwaltung</a>
              <% } %>
            </div>
          </div>
          <div class="col-lg-6">
            <form method="get" action="/" class="row g-2 dashboard-search-form">
              <div class="col-12 col-md">
                <div class="search-autocomplete-field">
                  <input class="form-control" type="search" name="q" value="<%= searchState.q || '' %>" placeholder="Tiere, Dokumente, Ereignisse suchen ..." autocomplete="off" data-global-search-autocomplete="true" />
                </div>
              </div>
              <div class="col-12 col-md-auto">
                <button type="submit" class="btn btn-primary w-100">Suchen</button>
              </div>
            </form>
            <% if (searchState.q && !searchState.searchable) { %>
              <p class="small text-body-secondary mb-0 mt-2">Bitte mindestens 2 Zeichen eingeben.</p>
            <% } %>
          </div>
        </div>
      </div>
    </section>
  </div>

  <% if (searchState.searchable) { %>
    <div class="col-12">
      <section class="card border-0 dashboard-feed-card">
        <div class="card-body p-4">
          <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
            <h2 class="h5 mb-0">Suchergebnisse</h2>
            <span class="badge text-bg-secondary-subtle border"><%= dashboardSearchResults.length %> Treffer</span>
          </div>
          <% if (!dashboardSearchResults.length) { %>
            <p class="text-body-secondary mb-0">Keine Ergebnisse gefunden.</p>
          <% } else { %>
            <div class="list-group list-group-flush dashboard-compact-list">
              <% dashboardSearchResults.slice(0, 6).forEach((item) => { %>
                <a class="list-group-item list-group-item-action bg-transparent rounded-3 border px-3 py-3 mb-2" href="<%= item.href %>">
                  <div class="d-flex flex-wrap justify-content-between gap-2">
                    <div>
                      <div class="fw-semibold"><%= item.title %></div>
                      <div class="small text-body-secondary"><%= item.kind %> | <%= item.subtitle %></div>
                    </div>
                    <div class="small text-body-secondary"><%= item.when || '' %></div>
                  </div>
                </a>
              <% }) %>
            </div>
          <% } %>
        </div>
      </section>
    </div>
  <% } %>
</div>

<div class="row g-2 mb-2">
  <div class="col-6 col-xl-3">
    <a class="card h-100 border-0 text-decoration-none dashboard-stat-card dashboard-kpi-link" href="/animals">
      <div class="card-body p-4 text-primary dashboard-stat-primary">
        <span>Tiere</span>
        <strong><%= stats.animalCount %></strong>
        <small class="text-body-secondary d-block">Zur Tierübersicht</small>
      </div>
    </a>
  </div>
  <div class="col-6 col-xl-3">
    <a class="card h-100 border-0 text-decoration-none dashboard-stat-card dashboard-kpi-link" href="/animals#animal-dokumente">
      <div class="card-body p-4">
        <span class="small text-body-secondary d-block mb-2">Dokumente</span>
        <strong class="fw-semibold text-primary d-block mb-2"><%= stats.documentCount %></strong>
        <small class="text-body-secondary">Unterlagen und Bilder</small>
      </div>
    </a>
  </div>
  <div class="col-6 col-xl-3">
    <a class="card h-100 border-0 text-decoration-none dashboard-stat-card dashboard-kpi-link semantic-card <%= stats.openReminderCount > 0 ? 'semantic-card--danger' : 'semantic-card--ok' %>" href="/animals#animal-medizin">
      <div class="card-body p-4">
        <span class="small text-body-secondary d-block mb-2">Offene Erinnerungen</span>
        <strong class="fw-semibold text-primary d-block mb-2"><%= stats.openReminderCount %></strong>
        <small class="text-body-secondary">Was noch auf Rückmeldung wartet</small>
      </div>
    </a>
  </div>
  <div class="col-6 col-xl-3">
    <a class="card h-100 border-0 text-decoration-none dashboard-stat-card dashboard-kpi-link semantic-card <%= stats.dueReminderCount > 0 ? 'semantic-card--danger' : 'semantic-card--ok' %>" href="/#dringende-erinnerungen">
      <div class="card-body p-4">
        <span class="small text-body-secondary d-block mb-2">Jetzt fällig</span>
        <strong class="fw-semibold text-warning d-block mb-2"><%= stats.dueReminderCount %></strong>
        <small class="text-body-secondary">Heute oder überfällig</small>
      </div>
    </a>
  </div>
</div>

<div class="row g-2 mb-2">
  <div class="col-md-6 col-xl-3">
    <a class="card border-0 h-100 text-decoration-none dashboard-health-card dashboard-kpi-link semantic-card <%= healthState.staleAnimals.length > 0 ? 'semantic-card--warning' : 'semantic-card--ok' %>" href="/animals">
      <div class="card-body p-3">
        <span class="small text-body-secondary d-block mb-2">Seit 7 Tagen ruhig</span>
        <strong class="h3 d-block mb-2"><%= healthState.staleAnimals.length %></strong>
        <small class="text-body-secondary">Ohne frische Pflegeänderung</small>
      </div>
    </a>
  </div>
  <div class="col-md-6 col-xl-3">
    <a class="card border-0 h-100 text-decoration-none dashboard-health-card dashboard-kpi-link semantic-card <%= healthState.animalsWithoutVeterinarian.length > 0 ? 'semantic-card--warning' : 'semantic-card--ok' %>" href="/animals">
      <div class="card-body p-3">
        <span class="small text-body-secondary d-block mb-2">Tierarzt fehlt</span>
        <strong class="h3 d-block mb-2"><%= healthState.animalsWithoutVeterinarian.length %></strong>
        <small class="text-body-secondary">Ohne hinterlegte Betreuung</small>
      </div>
    </a>
  </div>
  <div class="col-md-6 col-xl-3">
    <a class="card border-0 h-100 text-decoration-none dashboard-health-card dashboard-kpi-link semantic-card <%= healthState.animalsMissingRequiredDocuments.length > 0 ? 'semantic-card--warning' : 'semantic-card--ok' %>" href="/animals#animal-dokumente">
      <div class="card-body p-3">
        <span class="small text-body-secondary d-block mb-2">Pflichtdokumente offen</span>
        <strong class="h3 d-block mb-2"><%= healthState.animalsMissingRequiredDocuments.length %></strong>
        <small class="text-body-secondary">Fehlende Kategorien</small>
      </div>
    </a>
  </div>
  <div class="col-md-6 col-xl-3">
    <a class="card border-0 h-100 text-decoration-none dashboard-health-card dashboard-kpi-link semantic-card <%= healthState.animalsWithIncompleteProfile.length > 0 ? 'semantic-card--warning' : 'semantic-card--ok' %>" href="/animals">
      <div class="card-body p-3">
        <span class="small text-body-secondary d-block mb-2">Stammdaten unvollständig</span>
        <strong class="h3 d-block mb-2"><%= healthState.animalsWithIncompleteProfile.length %></strong>
        <small class="text-body-secondary">Datum fehlt</small>
      </div>
    </a>
  </div>
</div>

<div class="row g-2 mb-2 dashboard-priority-grid">
  <div class="col-lg-6 col-xxl-3">
    <article class="card border-0 h-100 dashboard-feed-card dashboard-surface-card semantic-card <%= urgentList.length > 0 ? 'semantic-card--danger' : 'semantic-card--ok' %>" id="dringende-erinnerungen">
      <div class="card-body p-4">
        <div class="d-flex justify-content-between align-items-start gap-2 mb-3">
          <div>
            <h2 class="h5 mb-1">Dringend</h2>
            <p class="text-body-secondary mb-0 small">Überfällig oder heute fällig.</p>
          </div>
          <a href="/animals" class="small text-decoration-none">Öffnen</a>
        </div>
        <% if (urgentList.length === 0) { %>
          <p class="text-body-secondary mb-0 small">Keine dringenden Erinnerungen vorhanden.</p>
        <% } else { %>
          <div class="list-group list-group-flush dashboard-compact-list">
            <% urgentList.slice(0, 3).forEach((reminder) => { %>
              <% const reminderHref = reminder.animal_id ? `/animals/${reminder.animal_id}${reminder.source_kind ? '#animal-medizin' : '#animal-neu'}` : null; %>
              <<%= reminderHref ? 'a' : 'div' %> class="list-group-item <%= reminderHref ? 'list-group-item-action' : '' %> bg-transparent rounded-3 border px-3 py-3 mb-2" <% if (reminderHref) { %>href="<%= reminderHref %>"<% } %>>
                <div class="d-flex justify-content-between align-items-start gap-3">
                  <div>
                    <div class="fw-semibold"><%= reminder.title %></div>
                    <div class="small text-body-secondary"><%= reminder.animal_name || "Ohne Tierzuordnung" %> | <%= reminder.reminder_type %></div>
                    <div class="small text-body-secondary mt-1">Fällig: <%= formatDateTime(reminder.due_at) %></div>
                  </div>
                  <span class="badge <%= reminder.urgency === 'overdue' ? 'text-bg-danger' : reminder.urgency === 'today' ? 'text-bg-warning' : 'text-bg-secondary' %>">
                    <%= reminder.urgency === 'overdue' ? 'Überfällig' : reminder.urgency === 'today' ? 'Heute' : 'Bald' %>
                  </span>
                </div>
              </<%= reminderHref ? 'a' : 'div' %>>
            <% }) %>
          </div>
        <% } %>
      </div>
    </article>
  </div>

  <div class="col-lg-6 col-xxl-3">
    <article class="card border-0 h-100 dashboard-feed-card dashboard-surface-card semantic-card <%= upcomingReminders.length > 0 ? 'semantic-card--danger' : 'semantic-card--ok' %>" id="naechste-erinnerungen">
      <div class="card-body p-4">
        <div class="d-flex justify-content-between align-items-start gap-2 mb-3">
          <div>
            <h2 class="h5 mb-1">Als Nächstes</h2>
            <p class="text-body-secondary mb-0 small">Die nächsten offenen Termine.</p>
          </div>
          <a href="/animals" class="small text-decoration-none">Öffnen</a>
        </div>
        <% if (upcomingReminders.length === 0) { %>
          <p class="text-body-secondary mb-0 small">Keine offenen Erinnerungen vorhanden.</p>
        <% } else { %>
          <div class="list-group list-group-flush dashboard-compact-list">
            <% upcomingReminders.slice(0, 3).forEach((reminder) => { %>
              <div class="list-group-item bg-transparent rounded-3 border px-3 py-3 mb-2">
                <div class="d-flex flex-column justify-content-between gap-2">
                  <div>
                    <div class="fw-semibold"><%= reminder.title %></div>
                    <div class="small text-body-secondary"><%= reminder.animal_name || "Ohne Tierzuordnung" %> | <%= reminder.reminder_type %></div>
                    <div class="small text-body-secondary mt-1">Fällig: <%= formatDateTime(reminder.due_at) %></div>
                  </div>
                  <% if (!reminder.completed_at && permissions.canManageReminders) { %>
                    <form method="post" action="/reminders/<%= reminder.id %>/complete">
                      <button type="submit" class="btn btn-outline-secondary btn-sm">Als erledigt markieren</button>
                    </form>
                  <% } %>
                </div>
              </div>
            <% }) %>
          </div>
        <% } %>
      </div>
    </article>
  </div>

  <div class="col-lg-6 col-xxl-3">
    <article class="card border-0 h-100 dashboard-surface-card semantic-card <%= attentionList.length > 0 ? 'semantic-card--warning' : 'semantic-card--ok' %>">
      <div class="card-body p-4">
        <div class="d-flex justify-content-between align-items-start gap-2 mb-3">
          <div>
            <h2 class="h5 mb-1">Braucht Aufmerksamkeit</h2>
            <p class="text-body-secondary mb-0 small">Tiere mit offenen Punkten.</p>
          </div>
          <a href="/animals" class="small text-decoration-none">Alle Tiere</a>
        </div>
        <% if (!attentionList.length) { %>
          <p class="text-body-secondary mb-0 small">Aktuell braucht kein Tier besondere Aufmerksamkeit.</p>
        <% } else { %>
          <div class="list-group list-group-flush dashboard-compact-list">
            <% attentionList.slice(0, 3).forEach((animal) => { %>
              <a class="list-group-item list-group-item-action bg-transparent rounded-3 border px-3 py-3 mb-2" href="/animals/<%= animal.id %>">
                <div class="d-flex flex-wrap justify-content-between gap-2">
                  <div>
                    <div class="fw-semibold"><%= animal.name %></div>
                    <div class="small text-body-secondary"><%= animal.species_name || '-' %><%= animal.veterinarian_name ? ` · ${animal.veterinarian_name}` : ' · Tierarzt fehlt' %></div>
                  </div>
                  <div class="d-flex flex-wrap gap-2">
                    <% if (animal.overdueReminderCount > 0) { %>
                      <span class="badge text-bg-danger"><%= animal.overdueReminderCount %> überfällig</span>
                    <% } else if (animal.openReminderCount > 0) { %>
                      <span class="badge text-bg-warning"><%= animal.openReminderCount %> offen</span>
                    <% } %>
                    <% if (animal.next_term) { %>
                      <span class="badge text-bg-secondary-subtle border"><%= animal.next_term.displayLabel %></span>
                    <% } %>
                  </div>
                </div>
              </a>
            <% }) %>
          </div>
        <% } %>
      </div>
    </article>
  </div>

  <div class="col-lg-6 col-xxl-3">
    <article class="card border-0 h-100 dashboard-surface-card">
      <div class="card-body p-4">
        <div class="d-flex justify-content-between align-items-start gap-2 mb-3">
          <div>
            <h2 class="h5 mb-1">Pflegequalität</h2>
            <p class="text-body-secondary mb-0 small">Bestand sauber und vollständig halten.</p>
          </div>
          <a href="/animals" class="small text-decoration-none">Prüfen</a>
        </div>
        <div class="dashboard-health-summary">
          <a href="/animals#animal-dokumente" class="dashboard-health-link semantic-card <%= healthState.animalsMissingRequiredDocuments.length > 0 ? 'semantic-card--warning' : 'semantic-card--ok' %>">
            <strong><%= healthState.animalsMissingRequiredDocuments.length %></strong>
            <span>Pflichtdokumente offen</span>
          </a>
          <a href="/animals" class="dashboard-health-link semantic-card <%= healthState.animalsWithIncompleteProfile.length > 0 ? 'semantic-card--warning' : 'semantic-card--ok' %>">
            <strong><%= healthState.animalsWithIncompleteProfile.length %></strong>
            <span>Profile ergänzen</span>
          </a>
          <a href="/animals" class="dashboard-health-link semantic-card <%= healthState.animalsWithoutVeterinarian.length > 0 ? 'semantic-card--warning' : 'semantic-card--ok' %>">
            <strong><%= healthState.animalsWithoutVeterinarian.length %></strong>
            <span>Tierarzt fehlt</span>
          </a>
          <a href="/animals" class="dashboard-health-link semantic-card <%= healthState.staleAnimals.length > 0 ? 'semantic-card--warning' : 'semantic-card--ok' %>">
            <strong><%= healthState.staleAnimals.length %></strong>
            <span>Ruht seit 7 Tagen</span>
          </a>
        </div>
      </div>
    </article>
  </div>
</div>

<div class="row g-2">
  <div class="col-xl-6">
    <article class="card border-0 h-100 dashboard-feed-card">
      <div class="card-body p-4">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
          <div>
            <h2 class="h5 mb-1">Neueste Tierakten</h2>
            <p class="text-body-secondary mb-0 small">Schneller Einstieg in die zuletzt gepflegten Akten.</p>
          </div>
          <a href="/animals" class="btn btn-outline-secondary btn-sm">Alle anzeigen</a>
        </div>
        <% if (recentAnimals.length === 0) { %>
          <p class="text-body-secondary mb-0 small">Es wurden noch keine Tiere angelegt.</p>
        <% } else { %>
          <div class="list-group list-group-flush dashboard-compact-list">
            <% recentAnimals.slice(0, 4).forEach((animal) => { %>
              <a class="list-group-item list-group-item-action bg-transparent rounded-3 border px-3 py-3 mb-2" href="/animals/<%= animal.id %>">
                <div class="d-flex flex-wrap justify-content-between gap-2">
                  <div>
                    <div class="fw-semibold"><%= animal.name %></div>
                    <div class="text-body-secondary"><%= animal.species_name || "-" %> | <%= animal.status %></div>
                  </div>
                  <div class="small text-body-secondary"><%= formatDate(animal.intake_date) %></div>
                </div>
              </a>
            <% }) %>
          </div>
        <% } %>
      </div>
    </article>
  </div>

  <div class="col-xl-6">
    <article class="card border-0 h-100 dashboard-feed-card">
      <div class="card-body p-4">
        <div class="mb-3">
          <h2 class="h5 mb-1">Zuletzt geändert</h2>
          <p class="text-body-secondary mb-0 small">Die letzten Vorgänge im Bestand.</p>
        </div>
        <% if (!activityList.length) { %>
          <p class="text-body-secondary mb-0 small">Noch keine Aktivität vorhanden.</p>
        <% } else { %>
          <div class="list-group list-group-flush dashboard-compact-list">
            <% activityList.slice(0, 4).forEach((entry) => { %>
              <<%= entry.animalId ? 'a' : 'div' %> class="list-group-item <%= entry.animalId ? 'list-group-item-action' : '' %> bg-transparent rounded-3 border px-3 py-3 mb-2" <% if (entry.animalId) { %>href="/animals/<%= entry.animalId %>"<% } %>>
                <div class="d-flex flex-wrap justify-content-between gap-2">
                  <div>
                    <div class="fw-semibold"><%= entry.title %></div>
                    <div class="small text-body-secondary"><%= entry.details %></div>
                  </div>
                  <div class="small text-body-secondary"><%= formatDateTime(entry.at) %></div>
                </div>
              </<%= entry.animalId ? 'a' : 'div' %>>
            <% }) %>
          </div>
        <% } %>
      </div>
    </article>
  </div>

  <div class="col-xl-6">
    <section class="card border-0 h-100">
      <div class="card-body p-4">
        <div class="mb-3">
          <h2 class="h5 mb-1">Schnell weiter</h2>
          <p class="text-body-secondary mb-0 small">Direkte Einstiege.</p>
        </div>
        <div class="row g-2">
          <% if (permissions.canEditAnimals) { %>
            <div class="col-md-6">
              <a href="/animals/new" class="card border h-100 text-decoration-none" data-drawer="animal-form">
                <div class="card-body p-3">
                  <div class="fw-semibold mb-1">Tier anlegen</div>
                  <div class="small text-body-secondary">Neue Akte starten.</div>
                </div>
              </a>
            </div>
          <% } %>
          <% if (permissions.canManageAdmin) { %>
            <div class="col-md-6">
              <a href="/admin/allgemein" class="card border h-100 text-decoration-none">
                <div class="card-body p-3">
                  <div class="fw-semibold mb-1">Verwaltung</div>
                  <div class="small text-body-secondary">Benutzer, Kanäle und Stammdaten.</div>
                </div>
              </a>
            </div>
          <% } %>
          <div class="col-md-6">
            <a href="/hilfe" class="card border h-100 text-decoration-none">
              <div class="card-body p-3">
                <div class="fw-semibold mb-1">Hilfe</div>
                <div class="small text-body-secondary">Anleitungen und Betrieb.</div>
              </div>
            </a>
          </div>
        </div>
      </div>
    </section>
  </div>
</div>

<%- include('../partials/bottom') %>
