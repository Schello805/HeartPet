<% const sectionState = typeof animalSection !== 'undefined' ? animalSection : { key: 'active', workspaceTitle: 'Tierbestand', workspaceIntro: '', totalLabel: 'Einträge', allowStatusFilter: true }; %>
<% const sectionBasePath = sectionState.basePath || '/animals'; %>
<%- include('../partials/top', { pageTitle, pageClass: `animals-page animals-page--${sectionState.key}` }) %>
<% const selectedAnimalState = typeof selectedAnimal !== 'undefined' ? selectedAnimal : null; %>
<% const selectedAnimalViewState = typeof selectedAnimalView !== 'undefined' ? selectedAnimalView : null; %>
<% const hasAnimalFilters = Boolean(filters.search || filters.speciesId || (sectionState.allowStatusFilter && filters.status)); %>

<% if (sectionState.key === 'resting') { %>
<section class="card border-0">
  <div class="card-body p-4">
    <div class="mb-4">
      <div class="text-uppercase small fw-semibold text-body-secondary mb-2">Ruhestätte</div>
      <h2 class="h3 mb-2">In liebevoller Erinnerung</h2>
      <p class="text-body-secondary mb-0">
        Hier bleiben verstorbene Tiere mit ihrer Akte sichtbar. Die Ansicht ist bewusst ruhig gehalten und vom aktiven Bestand getrennt.
      </p>
    </div>

    <% if (animals.length === 0) { %>
      <div class="card border bg-body-tertiary-subtle">
        <div class="card-body p-4">
          <h3 class="h5 mb-2">Noch keine Einträge</h3>
          <p class="text-body-secondary mb-1">Aktuell wurde noch kein Tier in die Ruhestätte übernommen.</p>
          <div class="small text-body-secondary">Sobald ein Tier als verstorben markiert wird, erscheint seine Akte hier getrennt vom aktiven Bestand in einer stilleren Ansicht.</div>
        </div>
      </div>
    <% } else { %>
      <div class="row g-3">
        <% animals.forEach((animal) => { %>
          <div class="col-md-6 col-xl-4">
            <a href="/animals/<%= animal.id %>" class="card h-100 border text-decoration-none">
              <% if (animal.profile_image_stored_name) { %>
                <img class="card-img-top object-fit-cover" src="/media/<%= animal.profile_image_stored_name %>" alt="Profilbild von <%= animal.name %>" style="height: 220px;" />
              <% } else { %>
                <div class="card-img-top d-flex align-items-center justify-content-center bg-secondary-subtle fw-semibold fs-1" style="height: 220px;"><%= getAnimalInitial(animal.name) %></div>
              <% } %>
              <div class="card-body">
                <div class="text-uppercase small fw-semibold text-body-secondary mb-2">In Erinnerung</div>
                <h3 class="h4 mb-1"><%= animal.name %></h3>
                <p class="text-body-secondary mb-3"><%= animal.species_name || 'Tier' %><%= animal.breed ? ` · ${animal.breed}` : '' %></p>
                <div class="row g-3 small">
                  <div class="col-6">
                    <div class="text-body-secondary"><%= animal.status_context_date ? 'Abschied' : 'Geboren' %></div>
                    <div class="fw-semibold"><%= animal.status_context_date ? formatDate(animal.status_context_date) : formatDate(animal.birth_date) %></div>
                  </div>
                  <div class="col-6">
                    <div class="text-body-secondary"><%= animal.status_context_name ? 'Ort / Zusammenhang' : 'Bei dir seit' %></div>
                    <div class="fw-semibold"><%= animal.status_context_name || formatDate(animal.intake_date) %></div>
                  </div>
                </div>
                <% if (animal.memorial_note || animal.notes) { %>
                  <p class="mt-3 mb-0 small text-body-secondary"><%= animal.memorial_note || animal.notes %></p>
                <% } %>
              </div>
            </a>
          </div>
        <% }) %>
      </div>
    <% } %>
  </div>
</section>
<% } else { %>
<div class="row g-3">
  <div class="col-12">
    <section class="card border-0 animals-compact-card animals-toolbar-card">
      <div class="card-body p-3 d-flex flex-column flex-lg-row justify-content-between align-items-start align-items-lg-center gap-2">
        <div>
          <h2 class="h5 mb-1"><%= sectionState.workspaceTitle || 'Tierübersicht' %></h2>
          <p class="text-body-secondary mb-0 small"><%= sectionState.workspaceIntro || 'Auswählen, Akte öffnen, direkt weiterarbeiten.' %></p>
        </div>
        <div class="d-flex flex-wrap gap-2">
          <% if (permissions.canEditAnimals && sectionState.key === 'active') { %>
            <a href="/animals/new" class="btn btn-primary btn-sm" data-drawer="animal-form">Neues Tier</a>
          <% } %>
          <a href="<%= sectionBasePath %>" class="btn btn-outline-secondary btn-sm">Aktualisieren</a>
        </div>
      </div>
    </section>
  </div>

  <div class="col-12">
    <section class="card border-0 animals-compact-card animals-filter-card">
      <div class="card-body p-3">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
          <div>
            <h2 class="h6 mb-1">Filter</h2>
            <p class="text-body-secondary mb-0 small"><%= hasAnimalFilters ? 'Aktive Filter eingrenzen die Liste.' : 'Bei Bedarf Suche, Tierart oder Sortierung öffnen.' %></p>
          </div>
          <div class="d-flex align-items-center gap-2">
            <span class="badge text-bg-secondary-subtle border"><%= pagination.totalCount %> <%= sectionState.totalLabel %></span>
            <button class="btn btn-outline-secondary btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#animalFilterCollapse" aria-expanded="<%= hasAnimalFilters ? 'true' : 'false' %>" aria-controls="animalFilterCollapse">
              <%= hasAnimalFilters ? 'Filter ändern' : 'Filter anzeigen' %>
            </button>
          </div>
        </div>
        <form method="get" action="<%= sectionBasePath %>" class="collapse <%= hasAnimalFilters ? 'show' : '' %> row g-2 align-items-end animals-filter-form mt-3" id="animalFilterCollapse">
          <div class="col-lg-5">
            <label class="form-label">Suche</label>
            <div class="search-autocomplete-field">
              <input class="form-control" type="text" name="q" value="<%= filters.search %>" placeholder="Name, Herkunft oder Rasse" data-global-search-autocomplete="true" />
            </div>
          </div>
          <div class="col-sm-6 col-lg-2">
            <label class="form-label">Tierart</label>
            <select class="form-select" name="species_id">
              <option value="">Alle</option>
              <% speciesOptions.forEach((item) => { %>
                <option value="<%= item.id %>" <%= String(filters.speciesId || '') === String(item.id) ? 'selected' : '' %>><%= item.name %></option>
              <% }) %>
            </select>
          </div>
          <% if (sectionState.allowStatusFilter) { %>
            <div class="col-sm-6 col-lg-2">
              <label class="form-label">Status</label>
              <select class="form-select" name="status">
                <option value="">Alle</option>
                <option value="Vermittelt" <%= filters.status === 'Vermittelt' ? 'selected' : '' %>>Vermittelt</option>
                <option value="Verkauft" <%= filters.status === 'Verkauft' ? 'selected' : '' %>>Verkauft</option>
              </select>
            </div>
          <% } else { %>
            <input type="hidden" name="status" value="<%= filters.status || (sectionState.allowedStatuses ? sectionState.allowedStatuses[0] : 'Aktiv') %>" />
          <% } %>
          <div class="col-sm-6 col-lg-2">
            <label class="form-label">Sortierung</label>
            <select class="form-select" name="sort">
              <option value="name_asc" <%= filters.sort === 'name_asc' ? 'selected' : '' %>>Name A-Z</option>
              <option value="name_desc" <%= filters.sort === 'name_desc' ? 'selected' : '' %>>Name Z-A</option>
              <option value="intake_desc" <%= filters.sort === 'intake_desc' ? 'selected' : '' %>>Aufnahme neu zuerst</option>
              <option value="intake_asc" <%= filters.sort === 'intake_asc' ? 'selected' : '' %>>Aufnahme alt zuerst</option>
              <option value="created_desc" <%= filters.sort === 'created_desc' ? 'selected' : '' %>>Zuletzt angelegt</option>
              <option value="next_term_asc" <%= filters.sort === 'next_term_asc' ? 'selected' : '' %>>Nächster Termin</option>
            </select>
          </div>
          <% if (selectedAnimalState) { %>
            <input type="hidden" name="animal_id" value="<%= selectedAnimalState.id %>" />
          <% } %>
          <div class="col-sm-6 col-lg-1 d-grid">
            <button type="submit" class="btn btn-primary">Anwenden</button>
          </div>
          <div class="col-sm-6 col-lg-auto d-grid">
            <a href="<%= sectionBasePath %>" class="btn btn-outline-secondary">Zurücksetzen</a>
          </div>
        </form>
      </div>
    </section>
  </div>

  <div class="col-12">
    <section class="card border-0 animals-compact-card animals-list-card">
      <div class="card-body p-3">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
          <div>
            <h2 class="h5 mb-1">Tierliste</h2>
            <p class="text-body-secondary mb-0 small">
              Wähle ein Tier aus der Liste. Danach öffnet sich die passende Akte direkt darunter.
            </p>
          </div>
          <div class="d-flex align-items-center gap-2">
            <span class="badge text-bg-secondary-subtle border"><%= animals.length %> sichtbar</span>
          </div>
        </div>

        <% if (animals.length === 0) { %>
          <div class="card border bg-body-tertiary-subtle">
            <div class="card-body">
              <h3 class="h6 mb-2">
                <%= sectionState.key === 'history'
                  ? 'Noch keine historischen Einträge'
                  : 'Noch kein aktiver Bestand' %>
              </h3>
              <p class="text-body-secondary mb-0">
                <%= sectionState.key === 'history'
                  ? 'Sobald Tiere als vermittelt oder verkauft markiert werden, erscheinen sie hier gesammelt in der Historie.'
                  : 'Noch keine aktiven Tiere vorhanden. Lege dein erstes Tier über „Neues Tier“ an.' %>
              </p>
            </div>
          </div>
        <% } else { %>
          <div id="animals-list-collapse">
            <div class="list-group animals-choice-list">
              <% animals.forEach((animal) => { %>
                <% const rowParams = new URLSearchParams(); %>
                <% if (filters.search) rowParams.set('q', filters.search); %>
                <% if (filters.status) rowParams.set('status', filters.status); %>
                <% if (filters.speciesId) rowParams.set('species_id', filters.speciesId); %>
                <% if (filters.sort) rowParams.set('sort', filters.sort); %>
                <% if (pagination.currentPage > 1) rowParams.set('page', String(pagination.currentPage)); %>
                <% rowParams.set('animal_id', String(animal.id)); %>
                <a
                  href="<%= sectionBasePath %>?<%= rowParams.toString() %>#selected-animal"
                  class="list-group-item list-group-item-action bg-transparent px-3 py-2 animal-list-item <%= selectedAnimalState && String(selectedAnimalState.id) === String(animal.id) ? 'active' : '' %>"
                  data-animal-workspace-link="true"
                  data-no-soft-nav="true"
                  data-panel-url="/animals/<%= animal.id %>/workspace-panel?<%= rowParams.toString() %>"
                >
                  <div class="d-flex flex-column flex-lg-row justify-content-between gap-3">
                    <div class="d-flex gap-3 align-items-center">
                      <% if (animal.profile_image_stored_name) { %>
                        <img class="rounded object-fit-cover" src="/media/<%= animal.profile_image_stored_name %>" alt="Profilbild von <%= animal.name %>" width="56" height="56" />
                      <% } else { %>
                        <div class="rounded bg-secondary-subtle d-flex align-items-center justify-content-center fw-semibold" style="width:56px;height:56px;"><%= getAnimalInitial(animal.name) %></div>
                      <% } %>
                      <div>
                        <div class="fw-semibold"><%= animal.name %></div>
                        <div class="small text-body-secondary"><%= animal.species_name || '-' %><%= animal.breed ? ` · ${animal.breed}` : '' %></div>
                        <div class="d-flex flex-wrap gap-2 mt-1">
                          <% if (animal.overdueReminderCount > 0) { %>
                            <span class="badge text-bg-danger"><%= animal.overdueReminderCount %> überfällig</span>
                          <% } else if (animal.openReminderCount > 0) { %>
                            <span class="badge text-bg-warning"><%= animal.openReminderCount %> offen</span>
                          <% } %>
                          <% if (animal.next_term) { %>
                            <span class="badge text-bg-secondary-subtle border"><%= animal.next_term.type %>: <%= animal.next_term.displayLabel %></span>
                          <% } %>
                          <% if (sectionState.key === 'history' && animal.statusSummary) { %>
                            <span class="badge text-bg-secondary-subtle border"><%= animal.statusSummary %></span>
                          <% } %>
                        </div>
                      </div>
                    </div>
                    <div class="text-lg-end animal-list-item-meta">
                      <div class="small text-body-secondary"><%= animal.veterinarian_name || 'Kein Tierarzt hinterlegt' %></div>
                      <div class="small text-body-secondary"><%= animal.updated_at ? `Zuletzt geändert ${formatDateTime(animal.updated_at)}` : '' %></div>
                      <div class="animal-list-item-action">Akte öffnen</div>
                    </div>
                  </div>
                </a>
              <% }) %>
            </div>

            <% if (pagination.totalPages > 1) { %>
              <nav class="mt-3">
                <ul class="pagination pagination-sm mb-0">
                  <% for (let page = 1; page <= pagination.totalPages; page += 1) { %>
                    <% const url = `${sectionBasePath}?q=${encodeURIComponent(filters.search || '')}&status=${encodeURIComponent(filters.status || '')}&species_id=${encodeURIComponent(filters.speciesId || '')}&sort=${encodeURIComponent(filters.sort || 'name_asc')}&page=${page}${selectedAnimalState ? `&animal_id=${selectedAnimalState.id}` : ''}`; %>
                    <li class="page-item <%= page === pagination.currentPage ? 'active' : '' %>">
                      <a href="<%= url %>" class="page-link"><%= page %></a>
                    </li>
                  <% } %>
                </ul>
              </nav>
            <% } %>
          </div>
        <% } %>
      </div>
    </section>
  </div>

  <div class="col-12">
    <section id="selected-animal" data-animal-workspace-target tabindex="-1">
      <%- include('./animal-workspace-detail', { selectedAnimal: selectedAnimalState, selectedAnimalView: selectedAnimalViewState, animalSection: sectionState }) %>
    </section>
  </div>
</div>
<% } %>

<%- include('../partials/bottom') %>
