<% const sectionState = typeof animalSection !== 'undefined' ? animalSection : { key: 'active', workspaceTitle: 'Tierbestand', workspaceIntro: '', totalLabel: 'Einträge', allowStatusFilter: true }; %>
<% const sectionBasePath = sectionState.basePath || '/animals'; %>
<% const selectedAnimalState = typeof selectedAnimal !== 'undefined' ? selectedAnimal : null; %>
<% const selectedAnimalViewState = typeof selectedAnimalView !== 'undefined' ? selectedAnimalView : null; %>
<% const cleanHistoryValue = (value) => { const text = String(value || '').trim(); return /^[\s,"'”“„‘’‚`´]+$/.test(text) ? '' : text; }; %>
<%- include('../partials/top', { pageTitle, pageClass: `animals-page animals-page--${sectionState.key}${selectedAnimalState ? ' animals-page--selected' : ''}` }) %>
<% const hasAnimalFilters = Boolean(filters.search || filters.speciesId || (sectionState.allowStatusFilter && filters.status)); %>

<% if (sectionState.key === 'history' && disposalGuidance) { %>
  <details class="card border-0 bg-body-tertiary mb-3 masterdata-accordion history-disposal-guidance">
    <summary class="masterdata-accordion-summary">
      <span><strong>Hinweis nach dem Tod eines Tieres</strong><small><%= disposalGuidance.federalState ? `${disposalGuidance.federalState} · Entsorgung, Bestattung und zuständige Anlagen` : 'Bundesland auswählen, um lokale Anlagen anzuzeigen' %></small></span>
      <span class="badge text-bg-warning">Bitte prüfen</span>
    </summary>
    <div class="card-body vstack gap-3">
      <% if (!disposalGuidance.federalState) { %>
        <div class="alert alert-warning mb-0">Lege unter <a href="/admin/benachrichtigungen">Verwaltung · Benachrichtigungen</a> zuerst das Bundesland dieser Instanz fest.</div>
      <% } else { %>
        <div class="d-flex flex-wrap align-items-center gap-2">
          <span class="text-body-secondary">Ausgewähltes Bundesland:</span>
          <strong class="status-chip status-ok"><%= disposalGuidance.federalState %></strong>
        </div>
      <% } %>
      <div>
        <h3 class="h6"><%= disposalGuidance.federalState ? `Für ${disposalGuidance.federalState}: bundesweite Regeln und örtliche Prüfung` : 'Was bundesweit gilt' %></h3>
        <ul class="mb-0">
          <li>Ein einzelnes Heimtier darf auf dem eigenen Grundstück vergraben werden, wenn dieses geeignet ist, nicht im Wasserschutzgebiet und nicht unmittelbar an öffentlichen Wegen oder Plätzen liegt.</li>
          <li>Über dem Tierkörper müssen mindestens 50 cm Erde liegen. Wasserrecht und zusätzliche Anordnungen der zuständigen Behörde bleiben unberührt.</li>
          <li><strong>Wichtig:</strong> Auf dem eigenen Grundstück dürfen nur einzelne Heimtiere bestattet werden. Nutz- oder landwirtschaftlich gehaltene Tiere, insbesondere Geflügel und Pferde, müssen grundsätzlich über die zuständige Tierkörperbeseitigung abgegeben werden. Bei unklarer Einordnung entscheidet das <%= disposalGuidance.authorityLabel %>.</li>
          <li>Bei unklarer Todesursache, Seuchenverdacht oder amtlichen Schutzmaßnahmen nichts vergraben oder transportieren, sondern sofort das <%= disposalGuidance.authorityLabel %> kontaktieren.</li>
          <li>Biotonne und Kompost sind keine zulässige Entsorgung. Zugelassene Tierkrematorien, Tierfriedhöfe oder die zuständige Tierkörperbeseitigung sind mögliche Wege.</li>
        </ul>
      </div>
      <div class="alert alert-secondary mb-0">Diese Übersicht ist eine Orientierung und keine Einzelfallfreigabe. Rechtsstand geprüft am <strong><%= disposalGuidance.lastReviewed %></strong>. Im Zweifel entscheidet die zuständige Behörde.</div>
      <div>
        <h3 class="h6">Amtliche Quellen</h3>
        <div class="d-flex flex-wrap gap-2"><% disposalGuidance.officialSources.forEach((source) => { %><a class="btn btn-outline-secondary btn-sm" href="<%= source.url %>" target="_blank" rel="noopener noreferrer"><%= source.label %></a><% }) %></div>
      </div>
      <div>
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2"><h3 class="h6 mb-0">Hinterlegte Tierkörperbeseitigungsanlagen<%= disposalGuidance.federalState ? ` in ${disposalGuidance.federalState}` : '' %></h3><% if (permissions.canManageAdmin) { %><a class="btn btn-outline-primary btn-sm" href="/admin/stammdaten">Anlagen verwalten</a><% } %></div>
        <% if (!disposalFacilities.length) { %>
          <p class="text-body-secondary mb-0">Noch keine passende Anlage hinterlegt. Die Zuständigkeit richtet sich häufig nach Landkreis oder kreisfreier Stadt und sollte beim Veterinäramt bestätigt werden.</p>
        <% } else { %>
          <div class="row g-3"><% disposalFacilities.forEach((facility) => { %><div class="col-lg-6"><article class="card border bg-body h-100"><div class="card-body"><div class="d-flex flex-wrap gap-2 align-items-center mb-2"><strong><%= facility.name %></strong><% if (facility.pickup_available) { %><span class="status-chip status-ok">Abholung möglich</span><% } %></div><p class="mb-1"><%= [facility.street, facility.postal_code, facility.city].filter(Boolean).join(', ') || 'Adresse nicht hinterlegt' %></p><p class="mb-2"><% if (facility.phone) { %><a href="tel:<%= facility.phone %>"><%= facility.phone %></a><% } %><%= facility.phone && facility.email ? ' · ' : '' %><% if (facility.email) { %><a href="mailto:<%= facility.email %>"><%= facility.email %></a><% } %></p><% if (facility.opening_hours) { %><p class="small mb-1"><strong>Öffnungszeiten:</strong> <%= facility.opening_hours %></p><% } %><% if (facility.pricing) { %><p class="small mb-1"><strong>Preise:</strong> <%= facility.pricing %></p><% } %><% if (facility.pickup_details) { %><p class="small mb-1"><strong>Abholung:</strong> <%= facility.pickup_details %></p><% } %><% if (facility.website) { %><a href="<%= facility.website %>" target="_blank" rel="noopener noreferrer">Website und aktuelle Angaben prüfen</a><% } %></div></article></div><% }) %></div>
        <% } %>
      </div>
    </div>
  </details>
<% } %>

<div class="row g-3">
  <div class="col-12">
    <section class="card border-0 animals-compact-card animals-filter-card">
      <div class="card-body p-2">
        <div class="d-flex justify-content-between align-items-center gap-2">
          <h2 class="h6 mb-0">Tiere filtern</h2>
          <div class="d-flex align-items-center gap-2">
            <span class="badge text-bg-secondary-subtle border"><%= pagination.totalCount %> <%= sectionState.totalLabel %></span>
            <% if (hasAnimalFilters) { %><span class="badge text-bg-info">aktiv</span><% } %>
            <button class="btn btn-outline-secondary btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#animalFilterCollapse" aria-expanded="false" aria-controls="animalFilterCollapse">
              Filter
            </button>
          </div>
        </div>
        <form method="get" action="<%= sectionBasePath %>" class="collapse row g-2 align-items-end animals-filter-form mt-2 pt-2 border-top" id="animalFilterCollapse">
          <div class="col-lg-5">
            <label class="form-label">Suche</label>
            <div class="search-autocomplete-field">
              <input class="form-control" type="text" name="q" value="<%= filters.search %>" placeholder="Name, Herkunft oder Rasse" data-global-search-autocomplete="true" />
            </div>
          </div>
          <div class="col-sm-6 col-lg-2">
            <label class="form-label">Tierart</label>
            <select class="form-select" name="species_id">
              <option value="">Alle</option>
              <% speciesOptions.forEach((item) => { %>
                <option value="<%= item.id %>" <%= String(filters.speciesId || '') === String(item.id) ? 'selected' : '' %>><%= item.name %></option>
              <% }) %>
            </select>
          </div>
          <% if (sectionState.allowStatusFilter) { %>
            <div class="col-sm-6 col-lg-2">
              <label class="form-label">Status</label>
              <select class="form-select" name="status">
                <option value="">Alle</option>
                <option value="Vermittelt" <%= filters.status === 'Vermittelt' ? 'selected' : '' %>>Vermittelt</option>
                <option value="Verkauft" <%= filters.status === 'Verkauft' ? 'selected' : '' %>>Verkauft</option>
                <option value="Verstorben" <%= filters.status === 'Verstorben' ? 'selected' : '' %>>Verstorben</option>
              </select>
            </div>
          <% } else { %>
            <input type="hidden" name="status" value="<%= filters.status || (sectionState.allowedStatuses ? sectionState.allowedStatuses[0] : 'Aktiv') %>" />
          <% } %>
          <div class="col-sm-6 col-lg-2">
            <label class="form-label">Sortierung</label>
            <select class="form-select" name="sort">
              <option value="name_asc" <%= filters.sort === 'name_asc' ? 'selected' : '' %>>Name A-Z</option>
              <option value="name_desc" <%= filters.sort === 'name_desc' ? 'selected' : '' %>>Name Z-A</option>
              <option value="intake_desc" <%= filters.sort === 'intake_desc' ? 'selected' : '' %>>Aufnahme neu zuerst</option>
              <option value="intake_asc" <%= filters.sort === 'intake_asc' ? 'selected' : '' %>>Aufnahme alt zuerst</option>
              <option value="created_desc" <%= filters.sort === 'created_desc' ? 'selected' : '' %>>Zuletzt angelegt</option>
              <option value="next_term_asc" <%= filters.sort === 'next_term_asc' ? 'selected' : '' %>>Nächster Termin</option>
            </select>
          </div>
          <% if (selectedAnimalState) { %>
            <input type="hidden" name="animal_id" value="<%= selectedAnimalState.id %>" />
          <% } %>
          <div class="col-sm-6 col-lg-1 d-grid">
            <button type="submit" class="btn btn-primary">Anwenden</button>
          </div>
          <div class="col-sm-6 col-lg-auto d-grid">
            <a href="<%= sectionBasePath %>" class="btn btn-outline-secondary">Zurücksetzen</a>
          </div>
        </form>
      </div>
    </section>
  </div>

  <div class="col-12">
    <section class="card border-0 animals-compact-card animals-list-card">
      <div class="card-body p-2">
        <div class="d-flex justify-content-between align-items-center gap-2 mb-2">
          <h2 class="h6 mb-0">Tier auswählen</h2>
          <div class="d-flex align-items-center gap-2">
            <span class="badge text-bg-secondary-subtle border"><%= animals.length %></span>
            <% if (sectionState.key === 'active' && permissions.canManageHealth && animals.length > 1) { %>
              <% const bulkVaccinationParams = new URLSearchParams(); %>
              <% if (filters.speciesId) bulkVaccinationParams.set('species_id', filters.speciesId); %>
              <a href="/animals/vaccinations/bulk/new?<%= bulkVaccinationParams.toString() %>" class="btn btn-outline-primary btn-sm" data-drawer="animal-entry">Gruppenimpfung</a>
            <% } %>
          </div>
        </div>

        <% if (animals.length === 0) { %>
          <div class="card border bg-body-tertiary-subtle">
            <div class="card-body">
              <h3 class="h6 mb-2">
                <%= sectionState.key === 'history'
                  ? 'Noch keine historischen Einträge'
                  : 'Noch kein aktiver Bestand' %>
              </h3>
              <p class="text-body-secondary mb-0">
                <%= sectionState.key === 'history'
                  ? 'Sobald Tiere als vermittelt, verkauft oder verstorben markiert werden, erscheinen sie hier gesammelt in der Historie.'
                  : 'Noch keine aktiven Tiere vorhanden. Ein neues Tier kannst du auf dem Dashboard anlegen.' %>
              </p>
            </div>
          </div>
        <% } else { %>
          <div id="animals-list-collapse">
            <div class="animals-choice-list">
              <% animals.forEach((animal) => { %>
                <% const historyContext = cleanHistoryValue(animal.status_context_name); %>
                <% const historyMemorialNote = cleanHistoryValue(animal.memorial_note); %>
                <% const rowParams = new URLSearchParams(); %>
                <% if (filters.search) rowParams.set('q', filters.search); %>
                <% if (filters.status) rowParams.set('status', filters.status); %>
                <% if (filters.speciesId) rowParams.set('species_id', filters.speciesId); %>
                <% if (filters.sort) rowParams.set('sort', filters.sort); %>
                <% if (pagination.currentPage > 1) rowParams.set('page', String(pagination.currentPage)); %>
                <% rowParams.set('animal_id', String(animal.id)); %>
                <a
                  href="<%= sectionBasePath %>?<%= rowParams.toString() %>#selected-animal"
                  class="card border text-decoration-none animal-list-item <%= sectionState.key === 'history' ? 'animal-list-item--history' : '' %> <%= animal.status === 'Verstorben' ? 'animal-list-item--deceased' : '' %> <%= selectedAnimalState && String(selectedAnimalState.id) === String(animal.id) ? 'active' : '' %>"
                  data-animal-workspace-link="true"
                  data-no-soft-nav="true"
                  data-panel-url="/animals/<%= animal.id %>/workspace-panel?<%= rowParams.toString() %>"
                >
                  <div class="card-body p-2 d-flex align-items-center gap-2">
                    <% if (animal.profile_image_stored_name) { %>
                      <img class="animal-choice-thumb" src="/media/<%= animal.profile_image_stored_name %>" alt="Profilbild von <%= animal.name %>" loading="lazy" />
                    <% } else { %>
                      <span class="animal-choice-thumb animal-choice-thumb--fallback" aria-hidden="true"><%= getAnimalSpeciesIcon(animal.species_name) %></span>
                    <% } %>
                    <div class="animal-choice-copy min-w-0">
                      <div class="fw-semibold text-truncate"><span class="animal-species-icon" aria-hidden="true"><%= getAnimalSpeciesIcon(animal.species_name) %></span> <%= animal.name %></div>
                      <div class="small text-body-secondary text-truncate"><%= animal.species_name || '-' %></div>
                      <% if (animal.overdueReminderCount > 0) { %>
                        <span class="badge text-bg-danger mt-1"><%= animal.overdueReminderCount %> überfällig</span>
                      <% } else if (animal.openReminderCount > 0) { %>
                        <span class="badge text-bg-warning mt-1"><%= animal.openReminderCount %> offen</span>
                      <% } else if (sectionState.key === 'history' && animal.status === 'Verstorben') { %>
                        <span class="animal-history-status animal-history-status--deceased mt-1">
                          <span aria-hidden="true">†</span>
                          Verstorben<%= animal.status_context_date ? ` · ${formatDate(animal.status_context_date)}` : '' %>
                        </span>
                        <% if (historyContext) { %>
                          <span class="animal-history-context text-truncate"><%= historyContext %></span>
                        <% } %>
                        <% if (historyMemorialNote) { %>
                          <span class="animal-history-context text-truncate"><%= historyMemorialNote %></span>
                        <% } %>
                      <% } else if (sectionState.key === 'history' && animal.statusSummary) { %>
                        <span class="badge text-bg-secondary-subtle border mt-1"><%= animal.statusSummary %></span>
                      <% } %>
                    </div>
                  </div>
                </a>
              <% }) %>
            </div>

            <% if (pagination.totalPages > 1) { %>
              <nav class="mt-3">
                <ul class="pagination pagination-sm mb-0">
                  <% for (let page = 1; page <= pagination.totalPages; page += 1) { %>
                    <% const url = `${sectionBasePath}?q=${encodeURIComponent(filters.search || '')}&status=${encodeURIComponent(filters.status || '')}&species_id=${encodeURIComponent(filters.speciesId || '')}&sort=${encodeURIComponent(filters.sort || 'name_asc')}&page=${page}${selectedAnimalState ? `&animal_id=${selectedAnimalState.id}` : ''}`; %>
                    <li class="page-item <%= page === pagination.currentPage ? 'active' : '' %>">
                      <a href="<%= url %>" class="page-link"><%= page %></a>
                    </li>
                  <% } %>
                </ul>
              </nav>
            <% } %>
          </div>
        <% } %>
      </div>
    </section>
  </div>

  <div class="col-12">
    <section id="selected-animal" data-animal-workspace-target tabindex="-1">
      <%- include('./animal-workspace-detail', { selectedAnimal: selectedAnimalState, selectedAnimalView: selectedAnimalViewState, animalSection: sectionState }) %>
    </section>
  </div>
</div>

<%- include('../partials/bottom') %>
