<% const sectionState = typeof animalSection !== 'undefined' ? animalSection : { key: 'active', workspaceTitle: 'Tierbestand', workspaceIntro: '', totalLabel: 'Einträge', allowStatusFilter: true }; %>
<% const sectionBasePath = sectionState.basePath || '/animals'; %>
<%- include('../partials/top', { pageTitle, pageClass: `animals-page animals-page--${sectionState.key}` }) %>
<% const selectedAnimalState = typeof selectedAnimal !== 'undefined' ? selectedAnimal : null; %>
<% const selectedAnimalViewState = typeof selectedAnimalView !== 'undefined' ? selectedAnimalView : null; %>
<% const hasAnimalFilters = Boolean(filters.search || filters.speciesId || (sectionState.allowStatusFilter && filters.status)); %>

<div class="row g-3">
  <div class="col-12">
    <section class="card border-0 animals-compact-card animals-filter-card">
      <div class="card-body p-3">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
          <div>
            <h2 class="h6 mb-1">Filter</h2>
            <p class="text-body-secondary mb-0 small"><%= hasAnimalFilters ? 'Aktive Filter eingrenzen die Liste.' : 'Bei Bedarf Suche, Tierart oder Sortierung öffnen.' %></p>
          </div>
          <div class="d-flex align-items-center gap-2">
            <span class="badge text-bg-secondary-subtle border"><%= pagination.totalCount %> <%= sectionState.totalLabel %></span>
            <button class="btn btn-outline-secondary btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#animalFilterCollapse" aria-expanded="<%= hasAnimalFilters ? 'true' : 'false' %>" aria-controls="animalFilterCollapse">
              <%= hasAnimalFilters ? 'Filter ändern' : 'Filter anzeigen' %>
            </button>
          </div>
        </div>
        <form method="get" action="<%= sectionBasePath %>" class="collapse <%= hasAnimalFilters ? 'show' : '' %> row g-2 align-items-end animals-filter-form mt-3" id="animalFilterCollapse">
          <div class="col-lg-5">
            <label class="form-label">Suche</label>
            <div class="search-autocomplete-field">
              <input class="form-control" type="text" name="q" value="<%= filters.search %>" placeholder="Name, Herkunft oder Rasse" data-global-search-autocomplete="true" />
            </div>
          </div>
          <div class="col-sm-6 col-lg-2">
            <label class="form-label">Tierart</label>
            <select class="form-select" name="species_id">
              <option value="">Alle</option>
              <% speciesOptions.forEach((item) => { %>
                <option value="<%= item.id %>" <%= String(filters.speciesId || '') === String(item.id) ? 'selected' : '' %>><%= item.name %></option>
              <% }) %>
            </select>
          </div>
          <% if (sectionState.allowStatusFilter) { %>
            <div class="col-sm-6 col-lg-2">
              <label class="form-label">Status</label>
              <select class="form-select" name="status">
                <option value="">Alle</option>
                <option value="Vermittelt" <%= filters.status === 'Vermittelt' ? 'selected' : '' %>>Vermittelt</option>
                <option value="Verkauft" <%= filters.status === 'Verkauft' ? 'selected' : '' %>>Verkauft</option>
                <option value="Verstorben" <%= filters.status === 'Verstorben' ? 'selected' : '' %>>Verstorben</option>
              </select>
            </div>
          <% } else { %>
            <input type="hidden" name="status" value="<%= filters.status || (sectionState.allowedStatuses ? sectionState.allowedStatuses[0] : 'Aktiv') %>" />
          <% } %>
          <div class="col-sm-6 col-lg-2">
            <label class="form-label">Sortierung</label>
            <select class="form-select" name="sort">
              <option value="name_asc" <%= filters.sort === 'name_asc' ? 'selected' : '' %>>Name A-Z</option>
              <option value="name_desc" <%= filters.sort === 'name_desc' ? 'selected' : '' %>>Name Z-A</option>
              <option value="intake_desc" <%= filters.sort === 'intake_desc' ? 'selected' : '' %>>Aufnahme neu zuerst</option>
              <option value="intake_asc" <%= filters.sort === 'intake_asc' ? 'selected' : '' %>>Aufnahme alt zuerst</option>
              <option value="created_desc" <%= filters.sort === 'created_desc' ? 'selected' : '' %>>Zuletzt angelegt</option>
              <option value="next_term_asc" <%= filters.sort === 'next_term_asc' ? 'selected' : '' %>>Nächster Termin</option>
            </select>
          </div>
          <% if (selectedAnimalState) { %>
            <input type="hidden" name="animal_id" value="<%= selectedAnimalState.id %>" />
          <% } %>
          <div class="col-sm-6 col-lg-1 d-grid">
            <button type="submit" class="btn btn-primary">Anwenden</button>
          </div>
          <div class="col-sm-6 col-lg-auto d-grid">
            <a href="<%= sectionBasePath %>" class="btn btn-outline-secondary">Zurücksetzen</a>
          </div>
        </form>
      </div>
    </section>
  </div>

  <div class="col-12">
    <section class="card border-0 animals-compact-card animals-list-card">
      <div class="card-body p-2">
        <div class="d-flex justify-content-between align-items-center gap-2 mb-2">
          <h2 class="h6 mb-0">Tier auswählen</h2>
          <span class="badge text-bg-secondary-subtle border"><%= animals.length %></span>
        </div>

        <% if (animals.length === 0) { %>
          <div class="card border bg-body-tertiary-subtle">
            <div class="card-body">
              <h3 class="h6 mb-2">
                <%= sectionState.key === 'history'
                  ? 'Noch keine historischen Einträge'
                  : 'Noch kein aktiver Bestand' %>
              </h3>
              <p class="text-body-secondary mb-0">
                <%= sectionState.key === 'history'
                  ? 'Sobald Tiere als vermittelt, verkauft oder verstorben markiert werden, erscheinen sie hier gesammelt in der Historie.'
                  : 'Noch keine aktiven Tiere vorhanden. Ein neues Tier kannst du auf dem Dashboard anlegen.' %>
              </p>
            </div>
          </div>
        <% } else { %>
          <div id="animals-list-collapse">
            <div class="animals-choice-list">
              <% animals.forEach((animal) => { %>
                <% const rowParams = new URLSearchParams(); %>
                <% if (filters.search) rowParams.set('q', filters.search); %>
                <% if (filters.status) rowParams.set('status', filters.status); %>
                <% if (filters.speciesId) rowParams.set('species_id', filters.speciesId); %>
                <% if (filters.sort) rowParams.set('sort', filters.sort); %>
                <% if (pagination.currentPage > 1) rowParams.set('page', String(pagination.currentPage)); %>
                <% rowParams.set('animal_id', String(animal.id)); %>
                <a
                  href="<%= sectionBasePath %>?<%= rowParams.toString() %>"
                  class="card border text-decoration-none animal-list-item <%= selectedAnimalState && String(selectedAnimalState.id) === String(animal.id) ? 'active' : '' %>"
                  data-animal-workspace-link="true"
                  data-no-soft-nav="true"
                  data-panel-url="/animals/<%= animal.id %>/workspace-panel?<%= rowParams.toString() %>"
                >
                  <div class="card-body p-2">
                    <div class="fw-semibold text-truncate"><%= animal.name %></div>
                    <div class="small text-body-secondary text-truncate"><%= animal.species_name || '-' %></div>
                    <% if (animal.overdueReminderCount > 0) { %>
                      <span class="badge text-bg-danger mt-1"><%= animal.overdueReminderCount %> überfällig</span>
                    <% } else if (animal.openReminderCount > 0) { %>
                      <span class="badge text-bg-warning mt-1"><%= animal.openReminderCount %> offen</span>
                    <% } else if (sectionState.key === 'history' && animal.statusSummary) { %>
                      <span class="badge text-bg-secondary-subtle border mt-1"><%= animal.statusSummary %></span>
                    <% } %>
                  </div>
                </a>
              <% }) %>
            </div>

            <% if (pagination.totalPages > 1) { %>
              <nav class="mt-3">
                <ul class="pagination pagination-sm mb-0">
                  <% for (let page = 1; page <= pagination.totalPages; page += 1) { %>
                    <% const url = `${sectionBasePath}?q=${encodeURIComponent(filters.search || '')}&status=${encodeURIComponent(filters.status || '')}&species_id=${encodeURIComponent(filters.speciesId || '')}&sort=${encodeURIComponent(filters.sort || 'name_asc')}&page=${page}${selectedAnimalState ? `&animal_id=${selectedAnimalState.id}` : ''}`; %>
                    <li class="page-item <%= page === pagination.currentPage ? 'active' : '' %>">
                      <a href="<%= url %>" class="page-link"><%= page %></a>
                    </li>
                  <% } %>
                </ul>
              </nav>
            <% } %>
          </div>
        <% } %>
      </div>
    </section>
  </div>

  <div class="col-12">
    <section id="selected-animal" data-animal-workspace-target tabindex="-1">
      <%- include('./animal-workspace-detail', { selectedAnimal: selectedAnimalState, selectedAnimalView: selectedAnimalViewState, animalSection: sectionState }) %>
    </section>
  </div>
</div>

<%- include('../partials/bottom') %>
