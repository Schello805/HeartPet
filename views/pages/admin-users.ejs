<%- include('../partials/top', { pageTitle, pageClass: 'admin-page' }) %>

<% const me = (typeof selfUser !== 'undefined' ? selfUser : null) || currentUser || {}; %>
<% const managedUsers = (users || []).filter((user) => {
  const sameId = String(user.id) === String(me.id || "");
  const sameMail = String(user.email || "").trim().toLowerCase() === String(me.email || "").trim().toLowerCase();
  return !sameId && !sameMail;
}); %>

<div class="vstack gap-3">
  <section class="card border-0 bg-body-tertiary admin-intro-card">
    <div class="card-body d-flex flex-column flex-lg-row justify-content-between align-items-start gap-3">
      <div>
        <p class="eyebrow mb-1">Benutzer</p>
        <h2 class="h4 mb-2">Zugänge klar trennen</h2>
        <p class="text-body-secondary mb-0">Eigenes Konto oben, weitere Nutzer darunter.</p>
      </div>
      <span class="status-chip status-muted"><%= managedUsers.length %> weitere Nutzer</span>
    </div>
  </section>

  <div class="row g-3">
    <div class="col-12">
      <section class="card border-0 bg-body-tertiary admin-section-card">
        <div class="card-body">
          <div class="d-flex flex-column flex-lg-row justify-content-between align-items-start gap-3 mb-3">
            <div>
              <h3 class="h5 mb-1">Eigenes Konto</h3>
              <p class="text-body-secondary mb-0">Dieses Konto betrifft nur deinen eigenen Login, deine E-Mail-Adresse und dein Passwort.</p>
            </div>
            <div class="card border bg-body form-section-card">
              <div class="card-body py-2 px-3">
                <strong class="d-block"><%= me.name || 'Administrator' %></strong>
                <small class="text-body-secondary"><%= me.email || '-' %> · <%= getRoleLabel(me.role || 'admin') %></small>
              </div>
            </div>
          </div>

          <div class="row g-3">
            <div class="col-lg-6">
              <section class="card border bg-body h-100 form-section-card">
                <div class="card-body">
                  <form method="post" action="/admin/profile" class="vstack gap-3">
                    <div>
                      <h4 class="h6 mb-2">Profildaten</h4>
                      <p class="text-body-secondary mb-0">Neue E-Mail gilt erst nach Bestätigung.</p>
                    </div>
                    <div class="row g-3">
                      <div class="col-12">
                        <label class="form-label" for="self-name">Name</label>
                        <input class="form-control" id="self-name" type="text" name="name" required value="<%= me.name || '' %>" />
                      </div>
                      <div class="col-12">
                        <label class="form-label" for="self-email">E-Mail</label>
                        <input class="form-control" id="self-email" type="email" name="email" required value="<%= me.email || '' %>" />
                      </div>
                    </div>
                    <div class="d-flex justify-content-end pt-2 border-top">
                      <button type="submit" class="btn btn-primary">Profil speichern</button>
                    </div>
                  </form>
                </div>
              </section>
            </div>

            <div class="col-lg-6">
              <section class="card border bg-body h-100 form-section-card">
                <div class="card-body">
                  <form method="post" action="/admin/password" class="vstack gap-3">
                    <div>
                      <h4 class="h6 mb-2">Passwort ändern</h4>
                      <p class="text-body-secondary mb-0">Gilt direkt für das nächste Login.</p>
                    </div>
                    <div class="row g-3">
                      <div class="col-12">
                        <label class="form-label" for="current-password">Aktuelles Passwort</label>
                        <input class="form-control" id="current-password" type="password" name="current_password" required />
                      </div>
                      <div class="col-12">
                        <label class="form-label" for="new-password">Neues Passwort</label>
                        <input class="form-control" id="new-password" type="password" name="new_password" required minlength="8" />
                        <div class="form-text">Mindestens 8 Zeichen. Kompromittierte Passwörter werden datenschutzfreundlich mit Have I Been Pwned geprüft.</div>
                      </div>
                      <div class="col-12">
                        <label class="form-label" for="new-password-confirm">Neues Passwort wiederholen</label>
                        <input class="form-control" id="new-password-confirm" type="password" name="new_password_confirm" required minlength="8" />
                      </div>
                    </div>
                    <div class="d-flex justify-content-end pt-2 border-top">
                      <button type="submit" class="btn btn-primary">Passwort aktualisieren</button>
                    </div>
                  </form>
                </div>
              </section>
            </div>
          </div>
        </div>
      </section>
    </div>

    <div class="col-12">
      <section class="card border-0 bg-body-tertiary admin-section-card">
        <div class="card-body d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3">
          <div>
            <h3 class="h5 mb-1">Weitere Nutzer</h3>
            <p class="text-body-secondary mb-0">Zugänge für Familie, Mitarbeitende oder Helfer.</p>
          </div>
          <a href="/admin/users/new" class="btn btn-primary" data-drawer="admin-user">Benutzer anlegen</a>
        </div>
      </section>
    </div>

    <div class="col-12">
      <section class="card border-0 bg-body-tertiary admin-section-card">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-center gap-3 mb-3">
            <div>
              <h3 class="h5 mb-1">Bestehende Nutzer</h3>
              <p class="text-body-secondary mb-0">Rollen, Rechte und Kontaktdaten direkt pro Karte.</p>
            </div>
            <span class="badge text-bg-secondary"><%= managedUsers.length %></span>
          </div>

          <% if (managedUsers.length === 0) { %>
            <div class="card border bg-body">
              <div class="card-body">
                <strong class="d-block mb-1">Noch keine weiteren Nutzer</strong>
                <p class="text-body-secondary mb-0">Aktuell existieren keine zusätzlichen Zugänge. Dein eigenes Konto steht oben separat.</p>
              </div>
            </div>
          <% } else { %>
            <div class="row g-3">
              <% managedUsers.forEach((user) => { %>
                <div class="col-12 col-xl-6">
                  <div class="card border bg-body h-100">
                    <div class="card-body d-grid gap-3">
                      <div class="d-flex flex-column flex-lg-row justify-content-between align-items-start gap-2">
                        <div>
                          <strong class="d-block mb-1"><%= user.name %></strong>
                          <p class="mb-1 text-body-secondary"><%= user.email %> · <%= getRoleLabel(user.role) %></p>
                          <small class="text-body-secondary">
                            Rechte:
                            <%= [
                              user.can_edit_animals ? 'Tiere' : null,
                              user.can_manage_documents ? 'Dokumente' : null,
                              user.can_manage_gallery ? 'Galerie' : null,
                              user.can_manage_health ? 'Medizin' : null,
                              user.can_manage_feedings ? 'Fütterung' : null,
                              user.can_manage_notes ? 'Protokolle' : null,
                              user.can_manage_reminders ? 'Erinnerungen' : null
                            ].filter(Boolean).join(', ') || 'Keine Zusatzrechte' %>
                          </small>
                        </div>
                        <span class="status-chip <%= user.must_change_password ? 'status-warning' : 'status-ok' %>"><%= user.must_change_password ? 'Passwortwechsel offen' : 'Aktiv' %></span>
                      </div>

                      <div class="d-flex flex-wrap gap-2">
                        <a href="/admin/users/<%= user.id %>/edit" class="btn btn-outline-secondary btn-sm" data-drawer="admin-user">Bearbeiten</a>
                        <% if (user.must_change_password) { %>
                          <button type="submit" class="btn btn-outline-primary btn-sm" form="user-resend-invite-<%= user.id %>">
                            Einladung erneut senden
                          </button>
                        <% } %>
                        <button type="submit" class="btn btn-outline-danger btn-sm" form="user-delete-<%= user.id %>">Löschen</button>
                      </div>

                      <small class="text-body-secondary">E-Mail-Änderungen werden erst nach Bestätigung durch den Nutzer aktiv.</small>
                    </div>
                  </div>
                </div>
                <% if (user.must_change_password) { %>
                  <form method="post" action="/admin/users/<%= user.id %>/resend-invite" id="user-resend-invite-<%= user.id %>" class="hidden-form">
                    <input type="hidden" name="return_to" value="/admin/benutzer" />
                  </form>
                <% } %>
                <form method="post" action="/admin/users/<%= user.id %>/delete" id="user-delete-<%= user.id %>" class="hidden-form" data-confirm="Benutzer wirklich löschen?"></form>
              <% }) %>
            </div>
          <% } %>
        </div>
      </section>
    </div>
  </div>
</div>

<%- include('../partials/bottom') %>
