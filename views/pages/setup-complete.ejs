<!DOCTYPE html>
<html lang="de">
  <head>
    <% const assetVersion = encodeURIComponent(typeof appRevision !== 'undefined' ? appRevision : 'dev'); %>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= pageTitle %> | HeartPet</title>
    <meta name="robots" content="noindex,nofollow,noarchive,nosnippet" />
    <link rel="stylesheet" href="/static/vendor/bootstrap/bootstrap.min.css" />
    <link rel="stylesheet" href="/static/css/theme-foundation.css?v=<%= assetVersion %>" />
    <link rel="stylesheet" href="/static/css/theme-layout.css?v=<%= assetVersion %>" />
    <link rel="stylesheet" href="/static/css/theme-components.css?v=<%= assetVersion %>" />
  </head>
  <body class="bootstrap-app" data-bs-theme="light">
    <main class="container py-5 min-vh-100 d-flex align-items-center">
      <div class="row justify-content-center w-100">
        <div class="col-12 col-lg-8">
          <section class="card border-0 shadow-sm bg-body-tertiary">
            <div class="card-body p-4 p-lg-5 vstack gap-4">
              <div>
                <p class="eyebrow mb-1">Abschlussprüfung</p>
                <h1 class="h3 mb-2">HeartPet ist eingerichtet</h1>
                <p class="text-body-secondary mb-0">Administrator, Datenbank und erste Tierakte wurden erfolgreich angelegt.</p>
              </div>

              <div class="vstack gap-2">
                <div class="card border bg-body"><div class="card-body py-3"><span class="ui-status ui-status--ok"><span class="ui-status__dot"></span>Datenbank und Anmeldung funktionieren</span></div></div>
                <div class="card border bg-body"><div class="card-body py-3"><span class="ui-status ui-status--ok"><span class="ui-status__dot"></span>Betriebsart: <%= accessMode === 'domain' ? 'Domain mit HTTPS' : 'Lokales Heimnetz' %></span></div></div>
                <div class="card border bg-body"><div class="card-body py-3">
                  <span class="ui-status <%= addressMatches ? 'ui-status--ok' : 'ui-status--error' %>"><span class="ui-status__dot"></span><%= addressMatches ? 'Aufgerufene Adresse stimmt' : 'Adresse noch nicht über die konfigurierte Domain aufgerufen' %></span>
                  <small class="d-block text-body-secondary mt-2">Konfiguriert: <code><%= appBaseUrl %></code><br />Aktuell: <code><%= currentUrl %></code></small>
                </div></div>
              </div>

              <% if (!addressMatches && accessMode === 'domain') { %>
                <div class="alert alert-warning mb-0">Prüfe DNS, TLS-Zertifikat und Reverse Proxy. Öffne danach <strong><%= appBaseUrl %></strong>.</div>
              <% } %>

              <div class="d-flex flex-wrap justify-content-end gap-2 border-top pt-3">
                <a class="btn btn-outline-secondary" href="/admin/systemlog">Installationsdiagnose</a>
                <a class="btn btn-primary" href="<%= animalId ? `/animals/${animalId}` : '/' %>">HeartPet öffnen</a>
              </div>
            </div>
          </section>
        </div>
      </div>
    </main>
  </body>
</html>
