<section class="drawer-fragment card border-0 bg-body-tertiary" data-drawer-fragment="animal-entry" data-drawer-title="Gruppenimpfung">
  <div class="card-body p-3 p-md-4">
    <div class="mb-3">
      <p class="eyebrow mb-1">Mehrere Tiere</p>
      <h2 class="h5 mb-1">Impfung gemeinsam eintragen</h2>
      <p class="text-body-secondary small mb-0">Impfdaten einmal erfassen und anschließend allen ausgewählten Tieren zuordnen.</p>
    </div>

    <form method="post" action="/animals/vaccinations/bulk" class="d-grid gap-3" data-drawer-form="true">
      <input type="hidden" name="return_to" value="<%= returnTo %>" />

      <section class="card border bg-body form-section-card">
        <div class="card-body">
          <div class="row g-3">
            <div class="col-12">
              <label class="form-label" for="bulk-vaccination-name">Impfstoff / Impfung</label>
              <input class="form-control" id="bulk-vaccination-name" name="name" type="text" required placeholder="z. B. Newcastle-Schluckimpfung" />
            </div>
            <div class="col-sm-6">
              <label class="form-label" for="bulk-vaccination-date">Impfdatum</label>
              <input class="form-control" id="bulk-vaccination-date" name="vaccination_date" type="date" value="<%= today %>" required />
            </div>
            <div class="col-sm-6">
              <label class="form-label" for="bulk-vaccination-next">Nächste Fälligkeit</label>
              <input class="form-control" id="bulk-vaccination-next" name="next_due_date" type="date" />
            </div>
            <div class="col-12">
              <div class="form-check">
                <input class="form-check-input" id="bulk-vaccination-reminder" name="reminder_enabled" type="checkbox" value="1" />
                <label class="form-check-label" for="bulk-vaccination-reminder">Erinnerung für die nächste Fälligkeit anlegen</label>
              </div>
            </div>
            <div class="col-12">
              <label class="form-label" for="bulk-vaccination-notes">Notizen</label>
              <textarea class="form-control" id="bulk-vaccination-notes" name="notes" rows="2" placeholder="z. B. über das Trinkwasser verabreicht"></textarea>
            </div>
          </div>
        </div>
      </section>

      <section class="card border bg-body form-section-card" data-bulk-selection>
        <div class="card-body d-grid gap-3">
          <div class="d-flex justify-content-between align-items-center gap-2">
            <div>
              <h3 class="h6 mb-1">Tiere auswählen</h3>
              <p class="small text-body-secondary mb-0"><%= animals.length %> aktive Tiere verfügbar</p>
            </div>
            <div class="form-check mb-0">
              <input class="form-check-input" id="bulk-select-all" type="checkbox" data-bulk-select-all />
              <label class="form-check-label" for="bulk-select-all">Alle</label>
            </div>
          </div>

          <% if (animals.length > 0) { %>
            <div class="row g-2">
              <% animals.forEach((animal) => { %>
                <div class="col-12 col-sm-6">
                  <label class="card border h-100 bulk-animal-option">
                    <span class="card-body p-2 d-flex align-items-center gap-2">
                      <input class="form-check-input mt-0" type="checkbox" name="animal_ids" value="<%= animal.id %>" data-bulk-animal />
                      <span class="min-w-0">
                        <strong class="d-block text-truncate"><%= animal.name %></strong>
                        <small class="text-body-secondary"><%= animal.species_name || 'Tier' %></small>
                      </span>
                    </span>
                  </label>
                </div>
              <% }) %>
            </div>
          <% } else { %>
            <p class="text-body-secondary mb-0">Keine passenden aktiven Tiere vorhanden.</p>
          <% } %>
        </div>
      </section>

      <div class="d-flex flex-wrap gap-2 pt-2 border-top mobile-form-actions">
        <button type="submit" class="btn btn-success" <%= animals.length === 0 ? 'disabled' : '' %>>Für ausgewählte Tiere speichern</button>
        <button type="button" class="btn btn-outline-secondary" data-drawer-close>Abbrechen</button>
      </div>
    </form>
  </div>
</section>
