<% const isEmbeddedView = typeof embedded !== 'undefined' && embedded; %>
<% if (!isEmbeddedView) { %>
  <%- include('../partials/top', { pageTitle }) %>
<% } %>
<% const reminderSourceMap = typeof sourceReminderMap !== 'undefined' ? sourceReminderMap : {}; %>
<% const freeReminders = typeof manualReminders !== 'undefined' ? manualReminders : []; %>
<% const animalTimeline = typeof timeline !== 'undefined' ? timeline : []; %>
<% const reminderStatsState = typeof reminderStats !== 'undefined' ? reminderStats : { total: 0, open: 0, done: 0, overdue: 0 }; %>
<% const activityLogState = typeof activityLog !== 'undefined' ? activityLog : []; %>
<% const workflowSummaryState = typeof workflowSummary !== 'undefined' ? workflowSummary : { missingRequiredCategories: [], isProfileIncomplete: false, hasVeterinarian: true }; %>
<% const microchipLinkState = typeof microchipLinks !== 'undefined' ? microchipLinks : { checks: [], nextSteps: [] }; %>
<%
  const activeVeterinarianName = animal.veterinarian_name || animal.species_veterinarian_name || '';
  const activeVeterinarianAddress = animal.veterinarian_name
    ? [animal.veterinarian_street, animal.veterinarian_postal_code, animal.veterinarian_city, animal.veterinarian_country].filter(Boolean).join(', ')
    : [animal.species_veterinarian_street, animal.species_veterinarian_postal_code, animal.species_veterinarian_city, animal.species_veterinarian_country].filter(Boolean).join(', ');
  const activeVeterinarianEmail = animal.veterinarian_name ? (animal.veterinarian_email || '') : (animal.species_veterinarian_email || '');
  const activeVeterinarianPhone = animal.veterinarian_name ? (animal.veterinarian_phone || '') : (animal.species_veterinarian_phone || '');
  const hasVeterinarianContact = Boolean(activeVeterinarianName && (activeVeterinarianAddress || activeVeterinarianEmail || activeVeterinarianPhone));
%>
<% 
  const resolveAnimalLifecycle = typeof getAnimalLifecycle === 'function'
    ? getAnimalLifecycle
    : (status) => {
        const allowedStatuses = ['Aktiv', 'Vermittelt', 'Verkauft', 'Verstorben'];
        const normalizedStatus = allowedStatuses.includes(String(status || '').trim()) ? String(status || '').trim() : 'Aktiv';
        const inHistory = normalizedStatus === 'Vermittelt' || normalizedStatus === 'Verkauft';
        const inRestingPlace = normalizedStatus === 'Verstorben';
        return {
          status: normalizedStatus,
          isActive: normalizedStatus === 'Aktiv',
          isArchived: normalizedStatus !== 'Aktiv',
          inHistory,
          inRestingPlace,
          label: inRestingPlace
            ? 'Diese Akte liegt als verstorbenes Tier in der Historie und wird nur noch dokumentiert.'
            : inHistory
              ? 'Diese Akte liegt in der Historie und ist nicht mehr Teil des aktiven Bestands.'
              : 'Diese Akte ist aktiv.',
          hint: inRestingPlace
            ? 'Neue Erinnerungen oder Alltags-Einträge sollten hier nicht mehr entstehen. Bestehende Informationen bleiben zur Erinnerung erhalten.'
            : inHistory
              ? 'Neue Alltags-Einträge und laufende Erinnerungen sind für historische Tiere standardmäßig beendet.'
              : '',
        };
      };
  const openReminderCount = reminderBuckets.overdue.length + reminderBuckets.open.length;
  const nextFocusLabel = related.vaccinations[0]
    ? `Impfung: ${related.vaccinations[0].name}`
    : ((related.appointments || [])[0] ? `Termin: ${(related.appointments || [])[0].title}` : 'Kein Termin hinterlegt');
  const focusFacts = [];
  if (openReminderCount > 0) {
    focusFacts.push(`${openReminderCount} offene Erinnerung${openReminderCount === 1 ? '' : 'en'}`);
  }
  if (related.vaccinations.length > 0) {
    focusFacts.push(`${related.vaccinations.length} Impfung${related.vaccinations.length === 1 ? '' : 'en'} im Blick`);
  }
  if ((related.appointments || []).length > 0) {
    focusFacts.push(`${(related.appointments || []).length} Termin${(related.appointments || []).length === 1 ? '' : 'e'} hinterlegt`);
  }
  if (!focusFacts.length) {
    focusFacts.push('Akte ist aktuell gut gepflegt');
  }
  const lifecycle = resolveAnimalLifecycle(animal.status);
  const statusContextLabel = lifecycle.inRestingPlace
    ? 'Ort / Zusammenhang'
    : lifecycle.inHistory
      ? (animal.status === 'Verkauft' ? 'Verkauft an' : 'Vermittelt an')
      : '';
  const statusDateLabel = lifecycle.inRestingPlace
    ? 'Abschied am'
    : lifecycle.inHistory
      ? (animal.status === 'Verkauft' ? 'Verkauft am' : 'Vermittelt am')
      : '';
  const animalIsActive = lifecycle.isActive;
  const canManageFeedingsNow = permissions.canManageFeedings && animalIsActive;
  const canManageNotesNow = permissions.canManageNotes && animalIsActive;
  const canManageHealthNow = permissions.canManageHealth && animalIsActive;
  const canManageRemindersNow = permissions.canManageReminders && animalIsActive;
  const canManageDocumentsNow = permissions.canManageDocuments && animalIsActive;
  const canManageGalleryNow = permissions.canManageGallery && animalIsActive;
  const primaryActions = [
    (canManageHealthNow || canManageRemindersNow || canManageFeedingsNow || canManageNotesNow) ? { label: 'Aktion hinzufügen', hint: 'Danach Medikament, Impfung, Termin, Erinnerung, Fütterung oder Notiz auswählen', href: `/animals/${animal.id}/events/new`, drawer: 'animal-entry', tone: 'primary' } : null,
  ].filter(Boolean);
  const cleanMemorialValue = (value) => {
    const text = String(value || '').trim();
    return /^[\s,"'”“„‘’‚`´]+$/.test(text) ? '' : text;
  };
  const memorialNote = cleanMemorialValue(animal.memorial_note);
  const memorialPlace = cleanMemorialValue(animal.status_context_name);
  const animalViewState = {
    reminderSourceMap,
    freeReminders,
    reminderStatsState,
    activityLogState,
    workflowSummaryState,
    microchipLinkState,
    activeVeterinarianName,
    activeVeterinarianAddress,
    activeVeterinarianEmail,
    activeVeterinarianPhone,
    hasVeterinarianContact,
    openReminderCount,
    nextFocusLabel,
    focusFacts,
    lifecycle,
    statusContextLabel,
    statusDateLabel,
    animalIsActive,
    canManageFeedingsNow,
    canManageNotesNow,
    canManageHealthNow,
    canManageRemindersNow,
    canManageDocumentsNow,
    canManageGalleryNow,
    primaryActions,
    memorialNote,
    memorialPlace,
  };
%>

<%- include('./animal-show/_header', animalViewState) %>

<%- include('./animal-show/_overview', animalViewState) %>
<%- include('./animal-show/_timeline', { animal, animalTimeline, formatDateTime }) %>

<%- include('./animal-show/_records', animalViewState) %>

<% if (!isEmbeddedView) { %>
  <%- include('../partials/bottom') %>
<% } %>
