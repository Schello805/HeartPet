<!DOCTYPE html>
<html lang="de">
  <head>
    <% const assetVersion = encodeURIComponent(typeof appRevision !== 'undefined' ? appRevision : 'dev'); %>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>Neues Passwort | HeartPet</title>
    <meta name="robots" content="noindex,nofollow,noarchive,nosnippet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css" integrity="sha384-LN+7fdVzj6u52u30Kp6M/trliBMCMKTyK833zpbD+pXdCLuTusPj697FH4R/5mcr" crossorigin="anonymous" />
    <link rel="stylesheet" href="/static/css/theme-foundation.css?v=<%= assetVersion %>" />
    <link rel="stylesheet" href="/static/css/theme-layout.css?v=<%= assetVersion %>" />
    <link rel="stylesheet" href="/static/css/theme-components.css?v=<%= assetVersion %>" />
  </head>
  <body class="bootstrap-app" data-bs-theme="light">
    <main class="container py-5 min-vh-100 d-flex align-items-center"><div class="row justify-content-center w-100"><div class="col-12 col-md-7 col-lg-5"><section class="card border-0 shadow-sm bg-body-tertiary"><div class="card-body p-4">
      <h1 class="h4 mb-2">Neues Passwort festlegen</h1>
      <% if (flash) { %><div class="alert <%= flash.type === 'error' ? 'alert-danger' : 'alert-success' %>"><%= flash.message %></div><% } %>
      <% if (!valid) { %>
        <p class="text-body-secondary">Dieser Link ist ungültig, bereits verwendet oder abgelaufen.</p><a class="btn btn-primary" href="/password-forgot">Neuen Link anfordern</a>
      <% } else { %>
        <p class="text-body-secondary">Mindestens 8 Zeichen. Bekannte kompromittierte Passwörter werden abgelehnt.</p>
        <form method="post" action="/password-reset" class="vstack gap-3">
          <input type="hidden" name="token" value="<%= token %>" />
          <div><label class="form-label" for="reset-password">Neues Passwort</label><input class="form-control" id="reset-password" type="password" name="new_password" minlength="8" required autocomplete="new-password" /></div>
          <div><label class="form-label" for="reset-password-confirm">Passwort wiederholen</label><input class="form-control" id="reset-password-confirm" type="password" name="new_password_confirm" minlength="8" required autocomplete="new-password" /></div>
          <button class="btn btn-success" type="submit">Passwort speichern</button>
        </form>
      <% } %>
    </div></section></div></div></main>
  </body>
</html>
