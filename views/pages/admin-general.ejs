<%- include('../partials/top', { pageTitle, pageClass: 'admin-page' }) %>
<% const applyInfoPageContent = typeof applyInfoPagePlaceholders === 'function' ? applyInfoPagePlaceholders : (value) => String(value || ''); %>

<div class="vstack gap-3">
  <section class="card border-0 bg-body-tertiary admin-intro-card">
    <div class="card-body d-flex flex-column flex-lg-row justify-content-between align-items-start gap-3">
      <div>
        <p class="eyebrow mb-1">Allgemein</p>
        <h2 class="h4 mb-2">Instanz und Kontakt</h2>
        <p class="text-body-secondary mb-0">Name, Logo und interner Hilfekontakt an einem Ort.</p>
      </div>
      <span class="status-chip status-muted">Allgemeine Angaben</span>
    </div>
  </section>

  <section class="card border-0 bg-body-tertiary admin-section-card">
    <div class="card-body">
      <form method="post" action="/admin/settings" enctype="multipart/form-data" class="vstack gap-4 compact-workflow-form">
        <input type="hidden" name="_fields" value="app_name,app_domain,organization_name,help_contact" />

        <div class="row g-3">
          <div class="col-lg-6">
            <section class="card border bg-body h-100 form-section-card">
              <div class="card-body">
                <div class="mb-3">
                  <h3 class="h5 mb-1">App und Außenwirkung</h3>
                  <p class="text-body-secondary mb-0">Name, Domain und Organisation für die sichtbare Instanz.</p>
                </div>
                <div class="row g-3">
                  <div class="col-12">
                    <label class="form-label" for="app_name">App-Name</label>
                    <input class="form-control" id="app_name" type="text" name="app_name" value="<%= settings.app_name || '' %>" />
                  </div>
                  <div class="col-12">
                    <label class="form-label" for="app_domain">Domain</label>
                    <input class="form-control" id="app_domain" type="text" name="app_domain" value="<%= settings.app_domain || '' %>" />
                  </div>
                  <div class="col-12">
                    <label class="form-label" for="organization_name_general">Name der Haltung / Organisation</label>
                    <input class="form-control" id="organization_name_general" type="text" name="organization_name" value="<%= settings.organization_name || '' %>" />
                  </div>
                  <div class="col-12">
                    <label class="form-label" for="help_contact">Kontakt für Hilfe</label>
                    <input class="form-control" id="help_contact" type="text" name="help_contact" value="<%= settings.help_contact || '' %>" />
                  </div>
                </div>
              </div>
            </section>
          </div>

          <div class="col-lg-6">
            <section class="card border bg-body h-100 form-section-card">
              <div class="card-body">
                <div class="mb-3">
                  <h3 class="h5 mb-1">Logo</h3>
                  <p class="text-body-secondary mb-0">Sichtbar im Menü, Login und als App-Icon.</p>
                </div>
                <div class="d-flex flex-column flex-md-row gap-3 align-items-start">
                  <img class="brand-logo" src="<%= appLogoUrl || '/static/images/logo-heartpet.png' %>" alt="Aktuelles App-Logo" />
                  <div class="flex-grow-1 w-100">
                    <label class="form-label" for="app_logo">Neues Logo hochladen</label>
                    <input class="form-control" id="app_logo" type="file" name="app_logo" accept="image/png,image/jpeg,image/webp,image/svg+xml,image/x-icon,image/vnd.microsoft.icon" />
                  </div>
                </div>
              </div>
            </section>
          </div>

        </div>

        <div class="d-flex justify-content-end pt-2 border-top">
          <button type="submit" class="btn btn-primary">Allgemeine Einstellungen speichern</button>
        </div>
      </form>
    </div>
  </section>

  <section class="card border-0 bg-body-tertiary admin-section-card" id="huehnerstall">
    <div class="card-body">
      <form method="post" action="/admin/settings" class="vstack gap-3 compact-workflow-form">
        <input type="hidden" name="_fields" value="coop_camera_streams,homematic_door_open_url,homematic_door_close_url,homematic_climate_url,homematic_xmlapi_token,homematic_temperature_url,homematic_humidity_url" />
        <div>
          <p class="eyebrow mb-1">Hühnerstall</p>
          <h2 class="h4 mb-1">Kameras und Steuerung</h2>
          <p class="text-body-secondary mb-0">Streams, Stalltür und Klimawerte für das Dashboard konfigurieren.</p>
        </div>
        <div class="row g-3">
          <div class="col-lg-6">
            <label class="form-label" for="coop_camera_streams">Kameras</label>
            <textarea class="form-control font-monospace" id="coop_camera_streams" name="coop_camera_streams" rows="6" placeholder="Stall innen|http://192.168.1.20/stream&#10;Auslauf|http://192.168.1.21/snapshot.jpg"><%= settings.coop_camera_streams || '' %></textarea>
            <div class="form-text">Eine Kamera pro Zeile: <code>Name|URL</code>. Verwende eine direkte MJPEG- oder Bild-URL.</div>
          </div>
          <div class="col-lg-6">
            <div class="vstack gap-3">
              <div>
                <label class="form-label" for="homematic_door_open_url">Befehl „Stalltür öffnen“</label>
                <input class="form-control" id="homematic_door_open_url" type="url" name="homematic_door_open_url" value="<%= settings.homematic_door_open_url || '' %>" placeholder="http://homematic.local/..." />
              </div>
              <div>
                <label class="form-label" for="homematic_door_close_url">Befehl „Stalltür schließen“</label>
                <input class="form-control" id="homematic_door_close_url" type="url" name="homematic_door_close_url" value="<%= settings.homematic_door_close_url || '' %>" placeholder="http://homematic.local/..." />
              </div>
              <div>
                <label class="form-label" for="homematic_climate_url">Klima-URL für Gerät oder Kanal</label>
                <input class="form-control" id="homematic_climate_url" type="url" name="homematic_climate_url" value="<%= settings.homematic_climate_url || '' %>" placeholder="http://192.168.1.22/addons/xmlapi/state.cgi?channel_id=2361" />
                <div class="form-text">Gerät: <code>?device_id=2341</code>, Kanal: <code>?channel_id=2361</code>. Das Token wird separat ergänzt.</div>
              </div>
              <div>
                <label class="form-label" for="homematic_xmlapi_token">XML-API-Token (sid)</label>
                <input class="form-control" id="homematic_xmlapi_token" type="password" name="homematic_xmlapi_token" value="<%= settings.homematic_xmlapi_token || '' %>" autocomplete="off" placeholder="Token aus der XML-API-Verwaltung" />
                <div class="form-text">XML-API 2.x verlangt dieses Token bei jeder Abfrage.</div>
              </div>
              <div class="alert alert-secondary mb-0" data-climate-status data-status-url="/admin/coop/climate-status">
                <strong class="d-block">Verbindung wird geprüft …</strong>
                <span class="small">HeartPet ruft die hinterlegte XML-API jetzt vom Server aus ab.</span>
              </div>
              <details>
                <summary class="small fw-semibold">Alternative Einzel-URLs</summary>
                <div class="row g-3 mt-1">
                  <div class="col-md-6">
                    <label class="form-label" for="homematic_temperature_url">Temperatur-URL</label>
                    <input class="form-control" id="homematic_temperature_url" type="url" name="homematic_temperature_url" value="<%= settings.homematic_temperature_url || '' %>" placeholder="http://homematic.local/..." />
                  </div>
                  <div class="col-md-6">
                    <label class="form-label" for="homematic_humidity_url">Luftfeuchte-URL</label>
                    <input class="form-control" id="homematic_humidity_url" type="url" name="homematic_humidity_url" value="<%= settings.homematic_humidity_url || '' %>" placeholder="http://homematic.local/..." />
                  </div>
                </div>
              </details>
              <div class="alert alert-info mb-0 small">Die URLs werden vom HeartPet-Server aufgerufen. CCU und Kameras müssen daher aus dessen Netzwerk erreichbar sein. Klima unterstützt XML-API, JSON oder einzelne Zahlenwerte.</div>
            </div>
          </div>
        </div>
        <div class="d-flex justify-content-end">
          <button type="submit" class="btn btn-primary">Hühnerstall speichern</button>
        </div>
      </form>
    </div>
  </section>

  <div class="row g-3">
    <div class="col-12">
      <section class="card border-0 bg-body-tertiary h-100 admin-section-card">
        <div class="card-body">
          <form method="post" action="/admin/settings" class="vstack gap-3 h-100 compact-workflow-form">
            <input type="hidden" name="_fields" value="contact_text" />
            <div>
              <h3 class="h5 mb-1">Kontakt</h3>
              <p class="text-body-secondary mb-0">Interne Kontaktinformationen für die Benutzer dieser Instanz.</p>
            </div>
            <textarea class="form-control flex-grow-1" name="contact_text" rows="8" placeholder="Kontaktinformationen"><%= applyInfoPageContent(settings.contact_text || '') %></textarea>
            <div class="d-flex justify-content-end">
              <button type="submit" class="btn btn-primary">Kontaktseite speichern</button>
            </div>
          </form>
        </div>
      </section>
    </div>

  </div>
</div>

<%- include('../partials/bottom') %>
