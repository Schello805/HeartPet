<%- include('../partials/top', { pageTitle, pageClass: 'admin-page' }) %>
<% const applyInfoPageContent = typeof applyInfoPagePlaceholders === 'function' ? applyInfoPagePlaceholders : (value) => String(value || ''); %>

<div class="vstack gap-3">
  <% if (currentPath !== '/admin/stall') { %>
  <section class="card border-0 bg-body-tertiary admin-intro-card">
    <div class="card-body d-flex flex-column flex-lg-row justify-content-between align-items-start gap-3">
      <div>
        <p class="eyebrow mb-1">Allgemein</p>
        <h2 class="h4 mb-2">Instanz und Kontakt</h2>
        <p class="text-body-secondary mb-0">Name, Logo und interner Hilfekontakt an einem Ort.</p>
      </div>
      <span class="status-chip status-muted">Allgemeine Angaben</span>
    </div>
  </section>

  <section class="card border-0 bg-body-tertiary admin-section-card">
    <div class="card-body">
      <form method="post" action="/admin/settings" enctype="multipart/form-data" class="vstack gap-4 compact-workflow-form">
        <input type="hidden" name="_fields" value="app_name,app_domain,organization_name,help_contact" />

        <div class="row g-3">
          <div class="col-lg-6">
            <section class="card border bg-body h-100 form-section-card">
              <div class="card-body">
                <div class="mb-3">
                  <h3 class="h5 mb-1">App und Außenwirkung</h3>
                  <p class="text-body-secondary mb-0">Name, Domain und Organisation für die sichtbare Instanz.</p>
                </div>
                <div class="row g-3">
                  <div class="col-12">
                    <label class="form-label" for="app_name">App-Name</label>
                    <input class="form-control" id="app_name" type="text" name="app_name" value="<%= settings.app_name || '' %>" />
                  </div>
                  <div class="col-12">
                    <label class="form-label" for="app_domain">Domain</label>
                    <input class="form-control" id="app_domain" type="text" name="app_domain" value="<%= settings.app_domain || '' %>" />
                  </div>
                  <div class="col-12">
                    <label class="form-label" for="organization_name_general">Name der Haltung / Organisation</label>
                    <input class="form-control" id="organization_name_general" type="text" name="organization_name" value="<%= settings.organization_name || '' %>" />
                  </div>
                  <div class="col-12">
                    <label class="form-label" for="help_contact">Kontakt für Hilfe</label>
                    <input class="form-control" id="help_contact" type="text" name="help_contact" value="<%= settings.help_contact || '' %>" />
                  </div>
                </div>
              </div>
            </section>
          </div>

          <div class="col-lg-6">
            <section class="card border bg-body h-100 form-section-card">
              <div class="card-body">
                <div class="mb-3">
                  <h3 class="h5 mb-1">Logo</h3>
                  <p class="text-body-secondary mb-0">Sichtbar im Menü, Login und als App-Icon.</p>
                </div>
                <div class="d-flex flex-column flex-md-row gap-3 align-items-start">
                  <img class="brand-logo" src="<%= appLogoUrl || '/static/images/logo-heartpet.png' %>" alt="Aktuelles App-Logo" />
                  <div class="flex-grow-1 w-100">
                    <label class="form-label" for="app_logo">Neues Logo hochladen</label>
                    <input class="form-control" id="app_logo" type="file" name="app_logo" accept="image/png,image/jpeg,image/webp,image/svg+xml,image/x-icon,image/vnd.microsoft.icon" />
                  </div>
                </div>
              </div>
            </section>
          </div>

        </div>

        <div class="d-flex justify-content-end pt-2 border-top">
          <button type="submit" class="btn btn-primary">Allgemeine Einstellungen speichern</button>
        </div>
      </form>
    </div>
  </section>
  <% } %>

  <% if (currentPath === '/admin/stall') { %>
  <section class="card border-0 bg-body-tertiary admin-section-card" id="huehnerstall">
    <div class="card-body">
      <form method="post" action="/admin/settings" class="vstack gap-3 compact-workflow-form">
        <input type="hidden" name="_fields" value="weather_location_name,weather_latitude,weather_longitude,coop_camera_streams,homematic_ccu_url,homematic_xmlapi_token,homematic_ccu_username,homematic_ccu_password,homematic_door_open_datapoint_id,homematic_door_close_datapoint_id,homematic_door_open_value,homematic_door_close_value,homematic_door_sensor_datapoint_id,homematic_door_sensor_true_state,homematic_door_level_datapoint_id,homematic_temperature_datapoint_id,homematic_humidity_datapoint_id" />
        <div>
          <p class="eyebrow mb-1">Hühnerstall</p>
          <h2 class="h4 mb-1">Wetter, Kameras und Steuerung</h2>
          <p class="text-body-secondary mb-0">Außenwetter, Streams, Stalltür und Klimawerte für das Dashboard konfigurieren.</p>
        </div>
        <section class="card border bg-body">
          <div class="card-body">
            <h3 class="h6 mb-2">Wetterstandort</h3>
            <div class="row g-3">
              <div class="col-md-6">
                <label class="form-label" for="weather_location_name">Ort</label>
                <input class="form-control" id="weather_location_name" name="weather_location_name" value="<%= settings.weather_location_name || '' %>" placeholder="Herrieden" />
              </div>
              <div class="col-6 col-md-3">
                <label class="form-label" for="weather_latitude">Breitengrad</label>
                <input class="form-control" id="weather_latitude" name="weather_latitude" type="number" min="-90" max="90" step="0.0001" value="<%= settings.weather_latitude || '' %>" placeholder="49.2378" />
              </div>
              <div class="col-6 col-md-3">
                <label class="form-label" for="weather_longitude">Längengrad</label>
                <input class="form-control" id="weather_longitude" name="weather_longitude" type="number" min="-180" max="180" step="0.0001" value="<%= settings.weather_longitude || '' %>" placeholder="10.5035" />
              </div>
            </div>
            <div class="form-text">HeartPet lädt aktuelles Wetter, Sonnenaufgang und Sonnenuntergang ohne API-Schlüssel von Open-Meteo. Koordinaten bestimmen den genauen Standort.</div>
          </div>
        </section>
        <div class="row g-3">
          <div class="col-lg-6">
            <div data-camera-settings>
              <div class="d-flex align-items-center justify-content-between gap-2 mb-2">
                <label class="form-label mb-0">Kameras</label>
                <button type="button" class="btn btn-sm btn-outline-primary" data-camera-add>Kamera hinzufügen</button>
              </div>
              <textarea class="d-none" id="coop_camera_streams" name="coop_camera_streams" data-camera-config><%= settings.coop_camera_streams || '' %></textarea>
              <div class="vstack gap-3" data-camera-settings-list></div>
              <template data-camera-settings-template>
                <section class="card border bg-body camera-settings-card">
                  <div class="card-body vstack gap-3">
                    <div class="d-flex justify-content-between align-items-center gap-2">
                      <strong data-camera-heading>Kamera</strong>
                      <div class="btn-group" role="group" aria-label="Kamera sortieren oder entfernen">
                        <button type="button" class="btn btn-sm btn-outline-secondary" data-camera-move-up title="Nach oben" aria-label="Kamera nach oben verschieben">↑</button>
                        <button type="button" class="btn btn-sm btn-outline-secondary" data-camera-move-down title="Nach unten" aria-label="Kamera nach unten verschieben">↓</button>
                        <button type="button" class="btn btn-sm btn-outline-danger" data-camera-remove>Entfernen</button>
                      </div>
                    </div>
                    <div>
                      <label class="form-label">Name</label>
                      <input type="text" class="form-control" placeholder="Stall innen" data-camera-name />
                    </div>
                    <div>
                      <label class="form-label">Gruppe / Abschnitt</label>
                      <input type="text" class="form-control" placeholder="Hühnerstall" data-camera-group />
                      <div class="form-text">Kameras mit derselben Gruppenbezeichnung erscheinen gemeinsam im Dashboard.</div>
                    </div>
                    <div>
                      <label class="form-label">Standbild-URL</label>
                      <input type="url" class="form-control" placeholder="http://benutzer:passwort@192.168.1.172/snapshot.jpg" data-camera-snapshot-url />
                      <div class="form-text">Dieses Bild wird beim Öffnen des Dashboards einmal geladen.</div>
                    </div>
                    <div class="ratio ratio-16x9 rounded border overflow-hidden bg-body-tertiary d-none" data-camera-preview-wrap>
                      <img class="w-100 h-100 object-fit-cover" alt="Kameravorschau" data-camera-preview />
                    </div>
                    <div class="alert alert-warning py-2 mb-0 d-none small" data-camera-preview-error></div>
                    <div>
                      <label class="form-label">Stream-URL</label>
                      <input type="url" class="form-control" placeholder="rtsp://benutzer:passwort@192.168.1.172:554/live/ch0" data-camera-stream-url />
                      <div class="form-text">Der Stream wird nur nach einem Klick auf „Stream starten“ geladen.</div>
                    </div>
                  </div>
                </section>
              </template>
              <p class="text-body-secondary small mb-0 mt-2" data-camera-empty>Bislang ist keine Kamera eingetragen.</p>
            </div>
            <div class="alert alert-secondary mt-2 mb-0 small" role="alert">
              <strong>Wansview W2:</strong> Hauptstream meist <code>rtsp://BENUTZER:PASSWORT@IP:554/live/ch0</code>, kleiner Stream <code>/live/ch1</code>. Auf dem HeartPet-Server muss <code>ffmpeg -version</code> funktionieren. Zugangsdaten mit Sonderzeichen müssen URL-kodiert sein, beispielsweise <code>!</code> als <code>%21</code>.
            </div>
          </div>
          <div class="col-lg-6">
            <div class="vstack gap-3">
              <section class="card border bg-body">
                <div class="card-body">
                  <h3 class="h6 mb-2">OpenCCU und Homematic XML-API</h3>
                  <div class="alert alert-info small mb-3">
                    <strong class="d-block mb-1">Aktuelle Einrichtung für OpenCCU</strong>
                    <ol class="mb-0 ps-3">
                      <li>In OpenCCU unter <strong>Einstellungen → Systemsteuerung → Zusatzsoftware → XML-API → Einstellen</strong> einen Zugriffstoken registrieren.</li>
                      <li>Als Adresse die OpenCCU-Basis mit <code>/addons/xmlapi/</code> eintragen.</li>
                      <li>Den statischen XML-API-Token vollständig und ohne <code>@</code>-Zeichen eintragen.</li>
                      <li>Speichern und anschließend die Datenpunkte direkt aus OpenCCU auswählen.</li>
                    </ol>
                  </div>
                  <div class="row g-2">
                    <div class="col-12">
                      <label class="form-label" for="homematic_ccu_url">1. XML-API-Adresse</label>
                      <input class="form-control" id="homematic_ccu_url" type="url" name="homematic_ccu_url" value="<%= settings.homematic_ccu_url || '' %>" placeholder="http://192.168.1.22/addons/xmlapi/" />
                      <div class="form-text">Empfohlen: <code>http://OPENCCU-IP/addons/xmlapi/</code> oder HTTPS, falls es in OpenCCU eingerichtet ist. Der alte Pfad <code>/config/xmlapi/</code> wird nur noch aus Kompatibilitätsgründen akzeptiert.</div>
                    </div>
                    <div class="col-12">
                      <label class="form-label" for="homematic_xmlapi_token">2. XML-API-Token (sid)</label>
                      <input class="form-control font-monospace" id="homematic_xmlapi_token" name="homematic_xmlapi_token" value="<%= settings.homematic_xmlapi_token || '' %>" autocomplete="off" placeholder="zum Beispiel RdNQqjPaQbLSsslS" />
                      <div class="form-text">XML-API 2.x verlangt für jeden Aufruf einen registrierten Token als Parameter <code>sid</code>. Die kurze <code>@…@</code>-SID aus der OpenCCU-WebUI ist eine andere, vorübergehende Sitzung und hier falsch.</div>
                    </div>
                    <div class="col-md-6"><label class="form-label" for="homematic_ccu_username">OpenCCU-Benutzername (optionaler Ausweichweg)</label><input class="form-control" id="homematic_ccu_username" name="homematic_ccu_username" value="<%= settings.homematic_ccu_username || '' %>" autocomplete="username" placeholder="bei XML-API-Token nicht nötig" /></div>
                    <div class="col-md-6"><label class="form-label" for="homematic_ccu_password">OpenCCU-Passwort (optionaler Ausweichweg)</label><input class="form-control" id="homematic_ccu_password" type="password" name="homematic_ccu_password" value="" autocomplete="new-password" placeholder="<%= settings.homematic_ccu_password ? 'Gespeichert, leer lassen zum Beibehalten' : 'bei XML-API-Token nicht nötig' %>" /></div>
                  </div>
                  <details class="mt-3">
                    <summary class="fw-semibold">Ausführliche Beispiele und Browser-Test</summary>
                    <div class="small mt-2 vstack gap-2">
                      <p class="mb-0"><strong>Token registrieren:</strong> Die XML-API-Oberfläche in der OpenCCU-Zusatzsoftware verwendet <code>tokenregister.cgi</code>. <code>tokenlist.cgi</code> listet vorhandene Tokens. In HeartPet gehört nur der Tokenwert hinein, beispielsweise <code>RdNQqjPaQbLSsslS</code>.</p>
                      <p class="mb-0"><strong>Empfohlene Eingabe:</strong><br />Adresse: <code>http://192.168.1.22/addons/xmlapi/</code><br />Token: <code>RdNQqjPaQbLSsslS</code></p>
                      <p class="mb-0"><strong>OpenCCU-Browser-Test:</strong><br /><code>http://192.168.1.22/addons/xmlapi/state.cgi?sid=RdNQqjPaQbLSsslS&amp;datapoint_id=2363,2362</code><br />Es muss XML mit beiden Datenpunkten erscheinen. <code>&lt;not_authenticated/&gt;</code> bedeutet, dass OpenCCU den Token nicht akzeptiert.</p>
                      <p class="mb-0"><strong>Technische Grundlage:</strong> HeartPet verwendet <code>state.cgi?datapoint_id=…</code> zum Lesen sowie <code>statechange.cgi?ise_id=…&amp;new_value=…</code> zum Schalten, jeweils mit dem registrierten Token als <code>sid</code>.</p>
                    </div>
                  </details>
                </div>
              </section>
              <section class="card border bg-body" data-homematic-door-setup data-discovery-url="/admin/coop/homematic-datapoints">
                <div class="card-body vstack gap-3">
                  <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                    <div><h3 class="h6 mb-1">Stalltür über OpenCCU schalten</h3><p class="small text-body-secondary mb-0">HeartPet erzeugt die XML-API-Aufrufe aus ISE-ID und Wert.</p></div>
                    <span class="badge text-bg-primary-subtle border">Ein oder zwei Kanäle</span>
                  </div>
                  <div class="alert alert-secondary py-2 mb-0 small d-none" data-homematic-discovery-status></div>
                  <div class="row g-2">
                    <div class="col-md-6"><label class="form-label" for="homematic_door_open_datapoint_id">ISE-ID Öffnen</label><div class="input-group"><input class="form-control" id="homematic_door_open_datapoint_id" inputmode="numeric" pattern="[0-9]+" name="homematic_door_open_datapoint_id" value="<%= settings.homematic_door_open_datapoint_id || settings.homematic_door_command_datapoint_id || '' %>" placeholder="13006" /><button class="btn btn-outline-secondary" type="button" data-homematic-discover data-homematic-target="homematic_door_open_datapoint_id" data-homematic-writable="true">Auswählen</button></div></div>
                    <div class="col-md-6"><label class="form-label" for="homematic_door_close_datapoint_id">ISE-ID Schließen</label><div class="input-group"><input class="form-control" id="homematic_door_close_datapoint_id" inputmode="numeric" pattern="[0-9]+" name="homematic_door_close_datapoint_id" value="<%= settings.homematic_door_close_datapoint_id || settings.homematic_door_command_datapoint_id || '' %>" placeholder="13006" /><button class="btn btn-outline-secondary" type="button" data-homematic-discover data-homematic-target="homematic_door_close_datapoint_id" data-homematic-writable="true">Auswählen</button></div></div>
                    <div class="col-6"><label class="form-label" for="homematic_door_open_value">Wert für Öffnen</label><input class="form-control" id="homematic_door_open_value" name="homematic_door_open_value" inputmode="decimal" value="<%= settings.homematic_door_open_value || '0.0' %>" /></div>
                    <div class="col-6"><label class="form-label" for="homematic_door_close_value">Wert für Schließen</label><input class="form-control" id="homematic_door_close_value" name="homematic_door_close_value" inputmode="decimal" value="<%= settings.homematic_door_close_value || '1.0' %>" /></div>
                  </div>
                  <div class="form-text"><strong>Bestätigte HeartPet-Konfiguration:</strong> Öffnen <code>ISE 13006 / 0.0</code>, Schließen <code>ISE 13006 / 1.0</code>. Die ISE-ID ist installationsabhängig und wird aus OpenCCU ausgewählt; nur die Bedienlogik <code>LEVEL 0…1</code> ist allgemein.</div>
                  <div class="row g-2">
                    <div class="col-6 d-grid"><button type="button" class="btn btn-outline-primary" data-door-test="open" data-test-url="/admin/coop/door-test/open">Öffnen testen</button></div>
                    <div class="col-6 d-grid"><button type="button" class="btn btn-outline-primary" data-door-test="close" data-test-url="/admin/coop/door-test/close">Schließen testen</button></div>
                  </div>
                  <div class="alert alert-secondary py-2 mb-0 small d-none" data-door-test-status></div>
                </div>
              </section>
              <div class="modal fade" id="homematic-device-picker" tabindex="-1" aria-labelledby="homematic-device-picker-title" aria-hidden="true" data-homematic-picker>
                <div class="modal-dialog modal-dialog-centered modal-lg modal-dialog-scrollable">
                  <div class="modal-content border-0 shadow-lg">
                    <div class="modal-header">
                      <div><h2 class="modal-title h5 mb-1" id="homematic-device-picker-title" data-homematic-picker-title>Datenpunkt auswählen</h2><p class="small text-body-secondary mb-0" data-homematic-picker-description>Passende CCU-Datenpunkte werden angezeigt.</p></div>
                      <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Schließen"></button>
                    </div>
                    <div class="modal-body p-3">
                      <label class="form-label" for="homematic-device-search">Gerät, Kanal, Typ oder ISE-ID suchen</label>
                      <input class="form-control form-control-lg mb-3" id="homematic-device-search" type="search" placeholder="Zum Beispiel Hühnerklappe, LEVEL oder 12990" autocomplete="off" data-homematic-search />
                      <div class="small text-body-secondary mb-2" data-homematic-result-count></div>
                      <div class="list-group homematic-device-results" data-homematic-results></div>
                    </div>
                  </div>
                </div>
              </div>
              <div class="row g-2">
                <div class="col-12">
                  <label class="form-label" for="homematic_door_level_datapoint_id">ISE-ID Öffnungsgrad (LEVEL)</label>
                  <div class="input-group"><input class="form-control" id="homematic_door_level_datapoint_id" inputmode="numeric" pattern="[0-9]+" name="homematic_door_level_datapoint_id" value="<%= settings.homematic_door_level_datapoint_id || '' %>" placeholder="12983" /><button class="btn btn-outline-secondary" type="button" data-homematic-discover data-homematic-target="homematic_door_level_datapoint_id" data-homematic-types="LEVEL">Auswählen</button></div>
                  <div class="form-text">Hier einen lesbaren <code>LEVEL</code>-Datenpunkt für die tatsächliche Position auswählen. In deiner OpenCCU-Installation ist <code>12983</code> ein möglicher Statuskanal; für die eindeutige Endlage hat der separate Türsensor Vorrang.</div>
                </div>
                <div class="col-md-6">
                  <label class="form-label" for="homematic_door_sensor_datapoint_id">ISE-ID Türsensor</label>
                  <div class="input-group"><input class="form-control" id="homematic_door_sensor_datapoint_id" inputmode="numeric" pattern="[0-9]+" name="homematic_door_sensor_datapoint_id" value="<%= settings.homematic_door_sensor_datapoint_id || '' %>" placeholder="3152" /><button class="btn btn-outline-secondary" type="button" data-homematic-discover data-homematic-target="homematic_door_sensor_datapoint_id" data-homematic-types="STATE">Auswählen</button></div>
                </div>
                <div class="col-md-6">
                  <label class="form-label" for="homematic_door_sensor_true_state">Sensorwert true bedeutet</label>
                  <select class="form-select" id="homematic_door_sensor_true_state" name="homematic_door_sensor_true_state">
                    <option value="open" <%= settings.homematic_door_sensor_true_state !== 'closed' ? 'selected' : '' %>>Tür offen</option>
                    <option value="closed" <%= settings.homematic_door_sensor_true_state === 'closed' ? 'selected' : '' %>>Tür geschlossen</option>
                  </select>
                </div>
                <div class="form-text">Für deinen separaten Kontaktsensor ist der STATE-Datenpunkt <code>3152</code>. Die Zuordnung kann bei umgekehrt montiertem Magnetkontakt gewechselt werden.</div>
              </div>
              <div class="row g-2">
                <div class="col-md-6">
                  <label class="form-label" for="homematic_temperature_datapoint_id">Datenpunkt Temperatur</label>
                  <div class="input-group"><input class="form-control" id="homematic_temperature_datapoint_id" inputmode="numeric" pattern="[0-9]+" name="homematic_temperature_datapoint_id" value="<%= settings.homematic_temperature_datapoint_id || settings.homematic_climate_channel_id || '' %>" placeholder="2363" /><button class="btn btn-outline-secondary" type="button" data-homematic-discover data-homematic-target="homematic_temperature_datapoint_id" data-homematic-types="TEMPERATURE">Auswählen</button></div>
                </div>
                <div class="col-md-6">
                  <label class="form-label" for="homematic_humidity_datapoint_id">Datenpunkt Luftfeuchte</label>
                  <div class="input-group"><input class="form-control" id="homematic_humidity_datapoint_id" inputmode="numeric" pattern="[0-9]+" name="homematic_humidity_datapoint_id" value="<%= settings.homematic_humidity_datapoint_id || '' %>" placeholder="2362" /><button class="btn btn-outline-secondary" type="button" data-homematic-discover data-homematic-target="homematic_humidity_datapoint_id" data-homematic-types="HUMIDITY">Auswählen</button></div>
                </div>
                <div class="form-text">Hier stehen nur die numerischen Datenpunkt-IDs, keine URLs. Beispiel: Temperatur <code>2363</code>, Luftfeuchte <code>2362</code>. Die IDs findest du in der XML-Ausgabe von <code>statelist.cgi?sid=TOKEN</code> beim jeweiligen Sensor.</div>
              </div>
              <div class="alert alert-secondary mb-0" data-climate-status data-status-url="/admin/coop/climate-status">
                <strong class="d-block">Verbindung wird geprüft …</strong>
                <span class="small">HeartPet prüft Token und Datenpunkte direkt über die XML-API.</span>
              </div>
              <div class="alert alert-info mb-0 small">OpenCCU und Kameras müssen aus dem Netzwerk des HeartPet-Servers erreichbar sein. Die OpenCCU-WebUI und XML-API sollten nicht ungeschützt aus dem Internet erreichbar sein.</div>
            </div>
          </div>
        </div>
        <div class="d-grid d-sm-flex justify-content-sm-end pt-3 border-top">
          <button type="submit" class="btn btn-primary btn-lg px-4">Alle Stall-Einstellungen speichern</button>
        </div>
      </form>
    </div>
  </section>
  <% } %>

  <% if (currentPath !== '/admin/stall') { %>
  <div class="row g-3">
    <div class="col-12">
      <section class="card border-0 bg-body-tertiary h-100 admin-section-card">
        <div class="card-body">
          <form method="post" action="/admin/settings" class="vstack gap-3 h-100 compact-workflow-form">
            <input type="hidden" name="_fields" value="contact_text" />
            <div>
              <h3 class="h5 mb-1">Kontakt</h3>
              <p class="text-body-secondary mb-0">Interne Kontaktinformationen für die Benutzer dieser Instanz.</p>
            </div>
            <textarea class="form-control flex-grow-1" name="contact_text" rows="8" placeholder="Kontaktinformationen"><%= applyInfoPageContent(settings.contact_text || '') %></textarea>
            <div class="d-flex justify-content-end">
              <button type="submit" class="btn btn-primary">Kontaktseite speichern</button>
            </div>
          </form>
        </div>
      </section>
    </div>

  </div>
  <% } %>
</div>

