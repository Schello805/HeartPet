<% if (lifecycle.inRestingPlace) { %>
  <section class="card border-0 shadow-sm animal-memorial-card">
    <div class="animal-memorial-portrait">
      <% if (animal.profile_image_stored_name) { %>
        <img src="/media/<%= animal.profile_image_stored_name %>" alt="Erinnerungsbild von <%= animal.name %>" />
      <% } else { %>
        <span aria-hidden="true"><%= getAnimalSpeciesIcon(animal.species_name) %></span>
      <% } %>
    </div>
    <div class="animal-memorial-content">
      <p class="eyebrow mb-1">In liebevoller Erinnerung</p>
      <h2><%= animal.name %></h2>
      <p class="animal-memorial-dates">
        <%= animal.birth_date ? formatDate(animal.birth_date) : 'Geburtsdatum unbekannt' %>
        <span aria-hidden="true">·</span>
        † <%= animal.status_context_date ? formatDate(animal.status_context_date) : 'Abschiedsdatum unbekannt' %>
      </p>
      <p class="animal-memorial-species"><%= getAnimalSpeciesIcon(animal.species_name) %> <%= animal.species_name || 'Tier' %></p>
      <% if (memorialNote) { %>
        <blockquote><%= memorialNote %></blockquote>
      <% } %>
      <% if (memorialPlace) { %>
        <p class="animal-memorial-place"><span>Ort / Zusammenhang</span><strong><%= memorialPlace %></strong></p>
      <% } %>
      <% if (permissions.canEditAnimals && typeof runtimeFeatures !== 'undefined' && runtimeFeatures.memorialNoteEditor) { %>
        <details class="animal-memorial-editor">
          <summary><%= memorialNote ? 'Erinnerung bearbeiten' : 'Erinnerung hinzufügen' %></summary>
          <form method="post" action="/animals/<%= animal.id %>/memorial-note">
            <input type="hidden" name="return_to" value="<%= currentPath %>" />
            <label class="form-label" for="memorial-note-<%= animal.id %>">Erinnerungstext</label>
            <textarea class="form-control" id="memorial-note-<%= animal.id %>" name="memorial_note" rows="4" maxlength="2000" placeholder="Eine persönliche Erinnerung an <%= animal.name %>"><%= memorialNote %></textarea>
            <button class="btn btn-primary btn-sm" type="submit">Erinnerung speichern</button>
          </form>
        </details>
      <% } %>
    </div>
  </section>
<% } else { %>
<section class="card border-0 shadow-sm animal-hero-card">
  <div class="animal-hero-profile">
    <div class="profile-image-panel">
      <% if (canManageGalleryNow) { %>
        <div class="profile-image-frame">
          <% if (animal.profile_image_stored_name) { %>
            <img class="animal-profile-image" src="/media/<%= animal.profile_image_stored_name %>" alt="Profilbild von <%= animal.name %>" />
          <% } else { %>
            <div class="animal-profile-image animal-profile-fallback" title="<%= animal.species_name || 'Tier' %>"><%= getAnimalSpeciesIcon(animal.species_name) %></div>
          <% } %>
        </div>
      <% } else { %>
        <div class="profile-image-frame">
          <% if (animal.profile_image_stored_name) { %>
            <img class="animal-profile-image" src="/media/<%= animal.profile_image_stored_name %>" alt="Profilbild von <%= animal.name %>" />
          <% } else { %>
            <div class="animal-profile-image animal-profile-fallback" title="<%= animal.species_name || 'Tier' %>"><%= getAnimalSpeciesIcon(animal.species_name) %></div>
          <% } %>
        </div>
      <% } %>
    </div>
  </div>
  <div class="animal-hero-content">
    <div class="animal-hero-head">
      <div class="animal-hero-title">
        <p class="eyebrow"><span aria-hidden="true"><%= getAnimalSpeciesIcon(animal.species_name) %></span> <%= animal.species_name || 'Tier' %></p>
        <h2><%= animal.name %></h2>
      </div>
      <div class="hero-actions">
        <% if (permissions.canEditAnimals) { %>
          <a href="/animals/<%= animal.id %>/edit" class="btn btn-primary btn-sm icon-button" data-drawer="animal-form" aria-label="Tier bearbeiten" title="Tier bearbeiten">
            <span aria-hidden="true">✎</span>
            <span class="visually-hidden">Tier bearbeiten</span>
          </a>
          <button type="submit" class="btn btn-outline-secondary btn-sm icon-button" form="animal-duplicate-<%= animal.id %>" aria-label="Tier mit allen Daten kopieren" title="Tier mit allen Daten kopieren">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="9" y="9" width="11" height="11" rx="2" />
              <path d="M15 9V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v7a2 2 0 0 0 2 2h3" />
            </svg>
            <span class="visually-hidden">Tier mit allen Daten kopieren</span>
          </button>
        <% } %>
        <a href="/animals/<%= animal.id %>/export/pdf" class="btn btn-outline-secondary btn-sm icon-button hero-pdf-button" aria-label="Als PDF exportieren" title="Als PDF exportieren">
          <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M6 2.75h7l5 5V21.25H6z" />
            <path d="M13 2.75v5h5" />
            <text x="8" y="17.2" fill="currentColor" stroke="none" font-size="5.2" font-family="sans-serif" font-weight="800">PDF</text>
          </svg>
          <span class="visually-hidden">Als PDF exportieren</span>
        </a>
        <% if (typeof runtimeFeatures !== 'undefined' && runtimeFeatures.calendarExport) { %><a href="/animals/<%= animal.id %>/calendar.ics" class="btn btn-outline-secondary btn-sm icon-button" aria-label="Kalender für dieses Tier exportieren" title="Kalender exportieren">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M16 3v4M8 3v4M3 10h18"/><path d="M8 14h3M8 17h5"/></svg>
          <span class="visually-hidden">Kalender für dieses Tier exportieren</span>
        </a><% } %>
      </div>
    </div>
    <div class="animal-hero-meta-grid">
      <article class="animal-hero-meta-card">
        <span>Alter</span>
        <strong><%= getAnimalAge(animal.birth_date) %></strong>
      </article>
      <article class="animal-hero-meta-card">
        <span>Aufnahme</span>
        <strong><%= formatDate(animal.intake_date) %></strong>
      </article>
      <article class="animal-hero-meta-card">
        <span>Geburtsdatum</span>
        <strong><%= formatDate(animal.birth_date) %></strong>
      </article>
      <article class="animal-hero-meta-card <%= hasVeterinarianContact ? 'has-action' : '' %>">
        <% if (hasVeterinarianContact) { %>
          <button type="button" class="animal-vet-trigger" data-vet-contact-toggle="<%= animal.id %>" aria-haspopup="dialog" aria-expanded="false">
            <span>Tierarzt</span>
            <strong><%= activeVeterinarianName %></strong>
            <small>Kontaktdaten anzeigen</small>
          </button>
        <% } else { %>
          <span>Tierarzt</span>
          <strong><%= activeVeterinarianName || '-' %></strong>
        <% } %>
      </article>
    </div>
  </div>
</section>

<%- include('./_quick-actions', { primaryActions }) %>

<% if (!animalIsActive) { %>
  <section class="card border-0 shadow-sm mb-3">
    <div class="card-body d-grid gap-2">
      <div class="d-flex flex-wrap justify-content-between align-items-start gap-2">
        <div>
          <p class="eyebrow mb-1">Historie</p>
          <h3 class="h5 mb-1"><%= lifecycle.label %></h3>
          <p class="text-body-secondary mb-0"><%= lifecycle.hint %></p>
        </div>
        <span class="status-chip <%= lifecycle.inRestingPlace ? 'status-muted' : 'status-warning' %>"><%= lifecycle.status %></span>
      </div>
      <div class="row g-2">
        <% if (animal.status_context_date) { %>
          <div class="col-md-4">
            <article class="card border bg-body-tertiary h-100 semantic-card <%= reminderStatsState.open > 0 ? 'semantic-card--danger' : 'semantic-card--ok' %>">
              <div class="card-body p-3 d-grid gap-1">
                <span class="small text-body-secondary"><%= statusDateLabel %></span>
                <strong><%= formatDate(animal.status_context_date) %></strong>
              </div>
            </article>
          </div>
        <% } %>
        <% if (memorialPlace) { %>
          <div class="col-md-4">
            <article class="card border bg-body-tertiary h-100">
              <div class="card-body p-3 d-grid gap-1">
                <span class="small text-body-secondary"><%= statusContextLabel %></span>
                <strong><%= memorialPlace %></strong>
              </div>
            </article>
          </div>
        <% } %>
        <% if (memorialNote) { %>
          <div class="col-md-4">
            <article class="card border bg-body-tertiary h-100">
              <div class="card-body p-3 d-grid gap-1">
                <span class="small text-body-secondary"><%= lifecycle.inRestingPlace ? 'Erinnerung' : 'Hinweis' %></span>
                <strong><%= memorialNote %></strong>
              </div>
            </article>
          </div>
        <% } %>
      </div>
    </div>
  </section>
<% } %>
<% } %>
