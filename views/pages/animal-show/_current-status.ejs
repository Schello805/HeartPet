<% if (openReminderCount > 0) { %>
  <section class="card border-0 shadow-sm mb-3 animal-current-status-card semantic-card semantic-card--danger">
    <div class="card-body p-3 d-flex flex-column flex-lg-row justify-content-between align-items-start align-items-lg-center gap-3">
      <div>
        <p class="eyebrow mb-1">Aktueller Stand</p>
        <h3 class="h5 mb-1"><%= openReminderCount %> offene Erinnerung<%= openReminderCount === 1 ? '' : 'en' %></h3>
        <p class="text-body-secondary small mb-0"><%= reminderStatsState.overdue ? `${reminderStatsState.overdue} davon überfällig` : focusFacts[0] %></p>
      </div>
      <div class="d-flex flex-wrap gap-2 align-items-center">
        <span class="badge text-bg-secondary-subtle border"><%= nextFocusLabel %></span>
        <button class="btn btn-outline-danger btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#animalRecordDetails" aria-controls="animalRecordDetails">Erinnerungen ansehen</button>
      </div>
    </div>
  </section>
<% } %>
