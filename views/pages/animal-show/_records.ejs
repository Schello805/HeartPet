<% if (!lifecycle.inRestingPlace) { %>
<section class="card border-0 shadow-sm mb-3 animal-details-entry">
  <div class="card-body p-3 d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-2">
    <div>
      <h3 class="h5 mb-1">Weitere Details</h3>
      <p class="small text-body-secondary mb-0">Medizin, Stammdaten, Chronik, Dokumente und Fotos nur bei Bedarf öffnen.</p>
    </div>
    <button class="btn btn-outline-secondary" type="button" data-bs-toggle="collapse" data-bs-target="#animalRecordDetails" aria-expanded="false" aria-controls="animalRecordDetails">Details anzeigen</button>
  </div>
</section>

<div class="collapse" id="animalRecordDetails">
<% } %>
<section class="accordion animal-record-accordion" id="animalRecordAccordion">
<%- include('./_master-data') %>

<%- include('./_health') %>

<%- include('./_media') %>
</section>
</div>
