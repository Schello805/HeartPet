<section class="card border-0 shadow-sm mb-3 animal-timeline-overview" id="animal-timeline">
  <div class="card-body p-3 d-grid gap-3">
    <div>
      <h3 class="h5 mb-1">Timeline</h3>
      <p class="small text-body-secondary mb-0"><%= animalTimeline.length %> Verlaufseinträge</p>
    </div>
    <% if (animalTimeline.length === 0) { %>
      <p class="empty-state mb-0">Noch keine Timeline-Einträge vorhanden.</p>
    <% } else { %>
      <div class="detail-entry-grid detail-entry-grid--timeline" data-timeline-primary>
        <% animalTimeline.slice(0, 10).forEach((entry) => { %>
          <div class="card border-0 bg-body-tertiary detail-entry-card d-flex flex-column justify-content-between gap-3">
            <div class="card-body d-grid gap-1 p-3 flex-grow-1">
              <strong><%= entry.title %></strong>
              <p><%= entry.type %> | <%= formatDateTime(entry.at) %></p>
              <% if (entry.details) { %><small><%= entry.details %></small><% } %>
            </div>
          </div>
        <% }) %>
      </div>
      <% if (animalTimeline.length > 10) { %>
        <% const timelineMoreId = `animal-timeline-more-${animal.id}`; %>
        <div class="collapse" id="<%= timelineMoreId %>" data-timeline-more>
          <div class="detail-entry-grid detail-entry-grid--timeline pt-2">
            <% animalTimeline.slice(10).forEach((entry) => { %>
              <div class="card border-0 bg-body-tertiary detail-entry-card d-flex flex-column justify-content-between gap-3">
                <div class="card-body d-grid gap-1 p-3 flex-grow-1">
                  <strong><%= entry.title %></strong>
                  <p><%= entry.type %> | <%= formatDateTime(entry.at) %></p>
                  <% if (entry.details) { %><small><%= entry.details %></small><% } %>
                </div>
              </div>
            <% }) %>
          </div>
        </div>
        <button class="btn btn-outline-secondary justify-self-start" type="button" data-bs-toggle="collapse"
          data-bs-target="#<%= timelineMoreId %>" aria-expanded="false" aria-controls="<%= timelineMoreId %>"
          data-timeline-more-toggle data-more-label="Mehr anzeigen (<%= animalTimeline.length - 10 %>)" data-less-label="Weniger anzeigen">
          Mehr anzeigen (<%= animalTimeline.length - 10 %>)
        </button>
      <% } %>
    <% } %>
  </div>
</section>
