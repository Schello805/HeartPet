<% if (permissions.canEditAnimals && !lifecycle.inRestingPlace) { %>
  <form method="post" action="/animals/<%= animal.id %>/duplicate" id="animal-duplicate-<%= animal.id %>" class="hidden-form" data-confirm="Tier wirklich mit allen Stammdaten, Einträgen, Erinnerungen, Dokumenten und Bildern kopieren?"></form>
  <form method="post" action="/animals/<%= animal.id %>/delete" id="animal-delete-<%= animal.id %>" class="hidden-form" data-confirm="Tier wirklich endgültig löschen? Alle Einträge, Dokumente, Bilder und Erinnerungen werden gelöscht.">
    <input type="hidden" name="return_to" value="/animals" />
  </form>
<% } %>

<% if (!lifecycle.inRestingPlace) { %>
  <%- include('./_current-status', { openReminderCount, reminderStatsState, focusFacts, nextFocusLabel }) %>
<% } %>

<div class="row g-2 mb-3 animal-summary-layout animal-workflow-summary d-none">
  <div class="col-xl-6">
    <section class="card border-0 shadow-sm h-100 animal-summary-card">
      <div class="card-body">
        <div class="d-grid gap-2 h-100">
        <div>
          <p class="eyebrow mb-0">Heute im Fokus</p>
          <h3 class="h5 mb-1">Was bei <%= animal.name %> gerade wichtig ist</h3>
          <p class="small text-body-secondary mb-0">Die wichtigsten Punkte und nächsten Schritte auf einen Blick.</p>
        </div>
        <div class="row g-2 flex-grow-1">
          <div class="col-md-6 d-flex">
            <article class="card border bg-body-tertiary h-100">
              <div class="card-body p-3 d-grid gap-1">
                <span class="small text-body-secondary">Reminder-Stand</span>
                <strong><%= reminderStatsState.open %> offen · <%= reminderStatsState.done %> erledigt</strong>
                <small class="text-body-secondary"><%= reminderStatsState.overdue ? `${reminderStatsState.overdue} überfällig` : 'Keine überfälligen Erinnerungen' %></small>
              </div>
            </article>
          </div>
          <% focusFacts.forEach((fact) => { %>
            <div class="col-md-6 d-flex">
              <article class="card border bg-body-tertiary h-100 semantic-card <%= fact === 'Akte ist aktuell gut gepflegt' ? 'semantic-card--ok' : 'semantic-card--warning' %>">
                <div class="card-body p-3 d-grid gap-1">
                  <span class="small text-body-secondary">Hinweis</span>
                  <strong><%= fact %></strong>
                </div>
              </article>
            </div>
          <% }) %>
        </div>
        </div>
      </div>
    </section>
  </div>

  <div class="col-xl-6">
    <section class="card border-0 shadow-sm h-100 animal-summary-card">
      <div class="card-body">
        <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-3">
      <div>
        <p class="eyebrow mb-1">Nächste Schritte</p>
        <h3 class="h5 mb-1">Direkt erkennen, was in dieser Akte gerade fehlt oder ansteht</h3>
        <p class="text-body-secondary mb-0">Die wichtigsten Arbeits- und Prüfhinweise vor der vollständigen Dokumentation.</p>
      </div>
      <% if (!animalIsActive) { %>
        <span class="badge text-bg-secondary-subtle border"><%= lifecycle.inRestingPlace ? 'Lesen, Erinnern, Export' : 'Verlauf und Abschlussdaten' %></span>
      <% } %>
        </div>
        <div class="row g-2 animal-priority-grid">
      <div class="col-md-6 col-xl-3">
        <a href="#animal-medizin" class="card border bg-body-tertiary h-100 text-decoration-none animal-priority-link semantic-card <%= openReminderCount > 0 ? 'semantic-card--danger' : 'semantic-card--ok' %>">
          <div class="card-body p-3 d-grid gap-1">
            <span class="small text-body-secondary">Erinnerungen</span>
            <strong><%= openReminderCount ? `${openReminderCount} offen` : 'Alles ruhig' %></strong>
            <small class="text-body-secondary"><%= reminderStatsState.overdue ? `${reminderStatsState.overdue} überfällig` : 'Keine überfälligen Einträge' %></small>
          </div>
        </a>
      </div>
      <div class="col-md-6 col-xl-3">
        <a href="#animal-dokumente" class="card border bg-body-tertiary h-100 text-decoration-none animal-priority-link semantic-card <%= workflowSummaryState.missingRequiredCategories.length > 0 ? 'semantic-card--warning' : 'semantic-card--ok' %>">
          <div class="card-body p-3 d-grid gap-1">
            <span class="small text-body-secondary">Pflichtdokumente</span>
            <strong><%= workflowSummaryState.missingRequiredCategories.length ? `${workflowSummaryState.missingRequiredCategories.length} fehlen` : 'Vollständig' %></strong>
            <small class="text-body-secondary"><%= workflowSummaryState.missingRequiredCategories.length ? workflowSummaryState.missingRequiredCategories.join(', ') : 'Alle Pflichtkategorien vorhanden' %></small>
          </div>
        </a>
      </div>
      <div class="col-md-6 col-xl-3">
        <a href="#animal-stammdaten" class="card border bg-body-tertiary h-100 text-decoration-none animal-priority-link semantic-card <%= workflowSummaryState.isProfileIncomplete ? 'semantic-card--warning' : 'semantic-card--ok' %>">
          <div class="card-body p-3 d-grid gap-1">
            <span class="small text-body-secondary">Stammdaten</span>
            <strong><%= workflowSummaryState.isProfileIncomplete ? 'Ergänzen' : 'Vollständig' %></strong>
            <small class="text-body-secondary"><%= workflowSummaryState.isProfileIncomplete ? 'Geburts- oder Aufnahmedatum fehlt noch' : 'Die Grunddaten sind gepflegt' %></small>
          </div>
        </a>
      </div>
      <div class="col-md-6 col-xl-3">
        <a href="#animal-stammdaten" class="card border bg-body-tertiary h-100 text-decoration-none animal-priority-link semantic-card <%= !workflowSummaryState.hasVeterinarian ? 'semantic-card--warning' : 'semantic-card--ok' %>">
          <div class="card-body p-3 d-grid gap-1">
            <span class="small text-body-secondary">Betreuung</span>
            <strong><%= workflowSummaryState.hasVeterinarian ? 'Vorhanden' : 'Tierarzt fehlt' %></strong>
            <small class="text-body-secondary"><%= workflowSummaryState.hasVeterinarian ? 'Ansprechperson für medizinische Themen ist hinterlegt' : 'Bitte Tierarzt ergänzen oder Standardtierarzt setzen' %></small>
          </div>
        </a>
      </div>
        </div>
      </div>
    </section>
  </div>
</div>

<div class="row g-2 mb-3 animal-insight-layout d-none">
  <div class="col-lg-4">
    <section class="row row-cols-2 row-cols-lg-2 g-2 h-100 animal-stats-grid">
      <div class="col">
        <a href="#animal-dokumente" class="card border bg-body-tertiary h-100 text-decoration-none animal-priority-link">
          <div class="card-body p-3 d-grid gap-1">
            <span class="small text-uppercase text-body-secondary">Dokumente</span>
            <strong class="h4 mb-0"><%= related.documents.length %></strong>
          </div>
        </a>
      </div>
      <div class="col">
        <a href="#animal-dokumente" class="card border bg-body-tertiary h-100 text-decoration-none animal-priority-link">
          <div class="card-body p-3 d-grid gap-1">
            <span class="small text-uppercase text-body-secondary">Fotos</span>
            <strong class="h4 mb-0"><%= related.images.length %></strong>
          </div>
        </a>
      </div>
      <div class="col">
        <a href="#animal-medizin" class="card border bg-body-tertiary h-100 text-decoration-none animal-priority-link semantic-card <%= (reminderBuckets.overdue.length + reminderBuckets.open.length) > 0 ? 'semantic-card--danger' : 'semantic-card--ok' %>">
          <div class="card-body p-3 d-grid gap-1">
            <span class="small text-uppercase text-body-secondary">Offene Erinnerungen</span>
            <strong class="h4 mb-0"><%= reminderBuckets.overdue.length + reminderBuckets.open.length %></strong>
          </div>
        </a>
      </div>
      <div class="col">
        <a href="#animal-medizin" class="card border bg-body-tertiary h-100 text-decoration-none animal-priority-link">
          <div class="card-body p-3 d-grid gap-1">
            <span class="small text-uppercase text-body-secondary">Nächste Termine</span>
            <strong class="h4 mb-0"><%= (related.appointments || []).length + related.vaccinations.length %></strong>
          </div>
        </a>
      </div>
    </section>
  </div>

  <div class="col-lg-8">
    <section class="card border-0 shadow-sm h-100 animal-summary-card">
      <div class="card-body">
        <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-3">
      <div>
        <p class="eyebrow mb-1">Chronik</p>
        <h3 class="h5 mb-1">Was zuletzt in dieser Akte passiert ist</h3>
        <p class="text-body-secondary mb-0">Statuswechsel, Pflegehinweise und wichtige Änderungen.</p>
      </div>
      <span class="badge text-bg-secondary-subtle border"><%= activityLogState.length %> Einträge</span>
        </div>
        <% if (!activityLogState.length) { %>
          <p class="text-body-secondary mb-0">Noch keine Aktivität in der Chronik vorhanden.</p>
        <% } else { %>
          <div class="row g-2">
        <% activityLogState.forEach((entry) => { %>
          <div class="col-md-6 col-xl-4">
            <article class="card border bg-body-tertiary h-100">
              <div class="card-body p-3 d-grid gap-1">
                <strong><%= entry.title %></strong>
                <span class="small text-body-secondary"><%= formatDateTime(entry.at) %></span>
                <small class="text-body-secondary"><%= entry.details || 'Ohne weitere Details.' %></small>
              </div>
            </article>
          </div>
        <% }) %>
          </div>
        <% } %>
      </div>
    </section>
  </div>
</div>

<% if (hasVeterinarianContact && !lifecycle.inRestingPlace) { %>
  <div class="vet-contact-popover" data-vet-contact-popover="<%= animal.id %>" hidden>
    <div class="vet-contact-card" role="dialog" aria-modal="false" aria-label="Kontaktdaten Tierarzt">
      <div class="vet-contact-head">
        <div>
          <p class="eyebrow">Tierarzt</p>
          <h3><%= activeVeterinarianName %></h3>
        </div>
        <button type="button" class="vet-contact-close" data-vet-contact-close="<%= animal.id %>" aria-label="Kontaktdaten schließen">×</button>
      </div>
      <dl class="row g-2 mb-0 vet-contact-list">
        <div class="col-12">
          <div class="card border-0 bg-body-tertiary h-100">
            <div class="card-body p-3">
              <dt class="small text-body-secondary mb-1">Adresse</dt>
              <dd class="mb-0 fw-semibold"><%= activeVeterinarianAddress || 'Keine Adresse hinterlegt' %></dd>
            </div>
          </div>
        </div>
        <div class="col-md-6">
          <div class="card border-0 bg-body-tertiary h-100">
            <div class="card-body p-3">
              <dt class="small text-body-secondary mb-1">E-Mail</dt>
              <dd class="mb-0 fw-semibold">
            <% if (activeVeterinarianEmail) { %>
              <a href="mailto:<%= activeVeterinarianEmail %>"><%= activeVeterinarianEmail %></a>
            <% } else { %>
              Keine E-Mail hinterlegt
            <% } %>
              </dd>
            </div>
          </div>
        </div>
        <div class="col-md-6">
          <div class="card border-0 bg-body-tertiary h-100">
            <div class="card-body p-3">
              <dt class="small text-body-secondary mb-1">Telefon</dt>
              <dd class="mb-0 fw-semibold">
            <% if (activeVeterinarianPhone) { %>
              <a href="tel:<%= activeVeterinarianPhone.replace(/\s+/g, '') %>"><%= activeVeterinarianPhone %></a>
            <% } else { %>
              Keine Telefonnummer hinterlegt
            <% } %>
              </dd>
            </div>
          </div>
        </div>
      </dl>
    </div>
  </div>
<% } %>

<div class="card border-0 shadow-sm d-none mb-3">
  <div class="card-body d-grid gap-3">
    <div class="d-grid gap-1">
      <p class="eyebrow mb-0">Schneller Überblick</p>
      <strong>Auf dem Smartphone zuerst das Wichtigste, danach die tieferen Bereiche der Akte.</strong>
    </div>
    <div class="row g-2">
      <div class="col-12">
        <article class="card border bg-body-tertiary h-100">
          <div class="card-body p-3 d-grid gap-1">
            <span class="small text-body-secondary">Offene Aufgaben</span>
            <strong><%= openReminderCount %></strong>
            <small class="text-body-secondary"><%= openReminderCount ? 'Erinnerungen brauchen Rückmeldung' : 'Derzeit nichts offen' %></small>
          </div>
        </article>
      </div>
      <div class="col-12">
        <article class="card border bg-body-tertiary h-100">
          <div class="card-body p-3 d-grid gap-1">
            <span class="small text-body-secondary">Nächster Fokus</span>
            <strong><%= nextFocusLabel %></strong>
            <small class="text-body-secondary"><%= focusFacts[0] %></small>
          </div>
        </article>
      </div>
      <div class="col-12">
        <article class="card border bg-body-tertiary h-100">
          <div class="card-body p-3 d-grid gap-1">
            <span class="small text-body-secondary">Akte</span>
            <strong><%= related.documents.length %> Dokumente · <%= related.images.length %> Fotos</strong>
            <small class="text-body-secondary">Schneller Einstieg in Unterlagen und Nachweise</small>
          </div>
        </article>
      </div>
    </div>
  </div>
</div>

<% if (lifecycle.inRestingPlace) { %>
  <section class="card border-0 shadow-sm mb-3 animal-details-entry animal-memorial-details-entry">
    <div class="card-body p-3 d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-2">
      <div>
        <h3 class="h5 mb-1">Details</h3>
        <p class="small text-body-secondary mb-0">Timeline, Stammdaten, Dokumente und Fotos der vollständigen Akte.</p>
      </div>
      <button class="btn btn-outline-secondary" type="button" data-bs-toggle="collapse" data-bs-target="#animalRecordDetails" aria-expanded="false" aria-controls="animalRecordDetails">Details anzeigen</button>
    </div>
  </section>
  <div class="collapse" id="animalRecordDetails">
<% } %>
