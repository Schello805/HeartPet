<%- include('../partials/top', { pageTitle }) %>
<section data-drawer-fragment data-drawer-title="<%= pageTitle %>">
  <form method="post" action="<%= type === 'inventory' ? (item ? `/versorgung/bestand/${item.id}/update` : '/versorgung/bestand') : (item ? `/versorgung/kosten/${item.id}/update` : '/versorgung/kosten') %>" data-drawer-form>
    <input type="hidden" name="return_to" value="<%= returnTo %>" />
    <% if (type === 'inventory') { %>
      <div class="mb-3"><label class="form-label" for="care-name">Bezeichnung</label><input class="form-control" id="care-name" name="name" maxlength="120" required value="<%= item?.name || '' %>" placeholder="z. B. Katzenfutter" /></div>
      <div class="row g-3 mb-3"><div class="col-sm-6"><label class="form-label" for="care-category">Kategorie</label><select class="form-select" id="care-category" name="category"><% inventoryCategories.forEach((category) => { %><option value="<%= category %>" <%= (item?.category || 'Sonstiges') === category ? 'selected' : '' %>><%= category %></option><% }) %></select></div><div class="col-sm-6"><label class="form-label" for="care-unit">Einheit</label><select class="form-select" id="care-unit" name="unit"><% inventoryUnits.forEach((unit) => { %><option value="<%= unit %>" <%= (item?.unit || 'Stück') === unit ? 'selected' : '' %>><%= unit %></option><% }) %></select></div></div>
      <div class="row g-3 mb-3"><div class="col-sm-6"><label class="form-label" for="care-quantity">Aktueller Bestand</label><input class="form-control" id="care-quantity" name="quantity" type="number" min="0" step="0.01" required value="<%= item?.quantity ?? 0 %>" /></div><div class="col-sm-6"><label class="form-label" for="care-minimum">Mindestbestand</label><input class="form-control" id="care-minimum" name="minimum_quantity" type="number" min="0" step="0.01" required value="<%= item?.minimum_quantity ?? 0 %>" /></div></div>
      <div class="mb-3"><label class="form-label" for="care-expires">Haltbar bis (optional)</label><input class="form-control" id="care-expires" name="expires_on" type="date" value="<%= item?.expires_on || '' %>" /></div>
    <% } else { %>
      <div class="mb-3"><label class="form-label" for="care-description">Beschreibung</label><input class="form-control" id="care-description" name="description" maxlength="160" required value="<%= item?.description || '' %>" placeholder="z. B. Jahresimpfung" /></div>
      <div class="row g-3 mb-3"><div class="col-sm-6"><label class="form-label" for="care-expense-category">Kategorie</label><select class="form-select" id="care-expense-category" name="category"><% expenseCategories.forEach((category) => { %><option value="<%= category %>" <%= (item?.category || 'Sonstiges') === category ? 'selected' : '' %>><%= category %></option><% }) %></select></div><div class="col-sm-6"><label class="form-label" for="care-animal">Tier (optional)</label><select class="form-select" id="care-animal" name="animal_id"><option value="">Allgemein</option><% animals.forEach((animal) => { %><option value="<%= animal.id %>" <%= String(item?.animal_id || '') === String(animal.id) ? 'selected' : '' %>><%= animal.name %></option><% }) %></select></div></div>
      <div class="row g-3 mb-3"><div class="col-sm-6"><label class="form-label" for="care-amount">Betrag in Euro</label><input class="form-control" id="care-amount" name="amount" type="number" min="0" step="0.01" inputmode="decimal" required value="<%= item ? (item.amount_cents / 100).toFixed(2) : '' %>" /></div><div class="col-sm-6"><label class="form-label" for="care-date">Datum</label><input class="form-control" id="care-date" name="expense_date" type="date" required value="<%= item?.expense_date || today %>" /></div></div>
    <% } %>
    <div class="mb-3"><label class="form-label" for="care-notes">Bemerkung (optional)</label><textarea class="form-control" id="care-notes" name="notes" rows="3"><%= item?.notes || '' %></textarea></div>
    <div class="d-flex gap-2 justify-content-end"><button type="button" class="btn btn-outline-secondary" data-drawer-close>Abbrechen</button><button type="submit" class="btn btn-primary">Speichern</button></div>
  </form>
</section>
<%- include('../partials/bottom') %>
