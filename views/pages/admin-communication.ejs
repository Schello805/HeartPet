<%- include('../partials/top', { pageTitle }) %>
<% const resolvedInstanceTimezone = typeof instanceTimezone !== 'undefined' && instanceTimezone ? instanceTimezone : 'UTC'; %>

<form id="toggle-email-enabled-form" method="post" action="/admin/settings" class="hidden-form">
  <input type="hidden" name="_fields" value="reminder_email_enabled" />
  <input type="hidden" name="reminder_email_enabled" value="<%= settings.reminder_email_enabled === 'true' ? 'false' : 'true' %>" />
</form>

<form id="toggle-telegram-enabled-form" method="post" action="/admin/settings" class="hidden-form">
  <input type="hidden" name="_fields" value="reminder_telegram_enabled" />
  <input type="hidden" name="reminder_telegram_enabled" value="<%= settings.reminder_telegram_enabled === 'true' ? 'false' : 'true' %>" />
</form>

<form id="toggle-ntfy-enabled-form" method="post" action="/admin/settings" class="hidden-form">
  <input type="hidden" name="_fields" value="reminder_ntfy_enabled" />
  <input type="hidden" name="reminder_ntfy_enabled" value="<%= settings.reminder_ntfy_enabled === 'true' ? 'false' : 'true' %>" />
</form>

<div class="vstack gap-3">
  <section class="card border-0 bg-body-tertiary">
    <div class="card-body d-flex flex-column flex-lg-row justify-content-between align-items-start gap-3">
      <div>
        <p class="eyebrow mb-1">Benachrichtigungen</p>
        <h2 class="h4 mb-2">Erinnerungen, Versand und Tests</h2>
        <p class="text-body-secondary mb-0">Alles Wichtige für Browser, E-Mail, Telegram und ntfy liegt hier in einer festen Reihenfolge.</p>
      </div>
      <div class="d-flex flex-wrap gap-2">
        <span class="status-chip <%= communicationStatus.emailReady ? 'status-ok' : 'status-muted' %>">
          E-Mail <%= communicationStatus.emailReady ? 'bereit' : 'offen' %>
        </span>
        <span class="status-chip <%= communicationStatus.telegramReady ? 'status-ok' : 'status-muted' %>">
          Telegram <%= communicationStatus.telegramReady ? 'bereit' : 'offen' %>
        </span>
        <span class="status-chip <%= communicationStatus.ntfyReady ? 'status-ok' : 'status-muted' %>">
          ntfy <%= communicationStatus.ntfyReady ? 'bereit' : 'offen' %>
        </span>
      </div>
    </div>
  </section>

  <div class="row g-3">
    <div class="col-md-6 col-xl-3">
      <section class="card border-0 bg-body-tertiary h-100">
        <div class="card-body">
          <span class="small text-body-secondary d-block mb-1">Instanz-Zeitzone</span>
          <strong class="h6 d-block mb-1"><%= resolvedInstanceTimezone %></strong>
          <small class="text-body-secondary">Gilt für tägliche Zusammenfassungen und Cronjobs.</small>
        </div>
      </section>
    </div>
    <div class="col-md-6 col-xl-3">
      <section class="card border-0 bg-body-tertiary h-100">
        <div class="card-body">
          <span class="small text-body-secondary d-block mb-1">E-Mail-Test</span>
          <strong class="h6 d-block mb-1"><%= communicationStatus.emailLastSuccessfulCheckAt ? formatDateTime(communicationStatus.emailLastSuccessfulCheckAt) : 'Noch kein Test' %></strong>
          <small class="text-body-secondary">Letzter erfolgreicher SMTP-Check oder Testversand.</small>
        </div>
      </section>
    </div>
    <div class="col-md-6 col-xl-3">
      <section class="card border-0 bg-body-tertiary h-100">
        <div class="card-body">
          <span class="small text-body-secondary d-block mb-1">Telegram-Test</span>
          <strong class="h6 d-block mb-1"><%= communicationStatus.telegramLastSuccessfulCheckAt ? formatDateTime(communicationStatus.telegramLastSuccessfulCheckAt) : 'Noch kein Test' %></strong>
          <small class="text-body-secondary">Zeigt, ob der Bot zuletzt erfolgreich schreiben konnte.</small>
        </div>
      </section>
    </div>
    <div class="col-md-6 col-xl-3">
      <section class="card border-0 bg-body-tertiary h-100">
        <div class="card-body">
          <span class="small text-body-secondary d-block mb-1">Versandstatus</span>
          <strong class="h6 d-block mb-1"><%= settings.reminder_email_enabled === 'true' || settings.reminder_telegram_enabled === 'true' ? 'Mindestens ein Kanal aktiv' : 'Alle externen Kanäle aus' %></strong>
          <small class="text-body-secondary">Browser-Hinweise und tägliche Zusammenfassung werden separat unten gesteuert.</small>
        </div>
      </section>
    </div>
  </div>

  <section class="card border-0 bg-body-tertiary">
    <div class="card-body">
      <form method="post" action="/admin/settings" class="vstack gap-4">
        <input type="hidden" name="_fields" value="browser_notifications_enabled,daily_digest_enabled,daily_digest_time,daily_digest_only_when_open" />
        <div>
          <h3 class="h5 mb-1">1. Allgemeine Erinnerungen</h3>
          <p class="text-body-secondary mb-0">Lege fest, ob HeartPet zusätzlich im Browser erinnert und ob täglich eine Zusammenfassung verschickt werden soll.</p>
        </div>
        <div class="row g-3">
          <div class="col-12">
            <div class="form-check">
              <input class="form-check-input" type="checkbox" id="browser_notifications_enabled" name="browser_notifications_enabled" <%= settings.browser_notifications_enabled === 'true' ? 'checked' : '' %> />
              <label class="form-check-label" for="browser_notifications_enabled">Browser-Hinweise für offene Erinnerungen aktivieren</label>
            </div>
          </div>
          <div class="col-12">
            <div class="form-check">
              <input class="form-check-input" type="checkbox" id="daily_digest_enabled" name="daily_digest_enabled" <%= settings.daily_digest_enabled === 'true' ? 'checked' : '' %> />
              <label class="form-check-label" for="daily_digest_enabled">Tägliche Erinnerungs-Zusammenfassung aktivieren</label>
            </div>
          </div>
          <div class="col-md-6">
            <label class="form-label" for="daily_digest_time">Tägliche Zusammenfassung um</label>
            <input class="form-control" id="daily_digest_time" type="time" name="daily_digest_time" value="<%= settings.daily_digest_time || '07:30' %>" />
          </div>
          <div class="col-md-6 d-flex align-items-end">
            <div class="form-check mb-2">
              <input class="form-check-input" type="checkbox" id="daily_digest_only_when_open" name="daily_digest_only_when_open" <%= settings.daily_digest_only_when_open !== 'false' ? 'checked' : '' %> />
              <label class="form-check-label" for="daily_digest_only_when_open">Nur senden, wenn offene Erinnerungen vorhanden sind</label>
            </div>
          </div>
        </div>
        <div class="alert alert-secondary mb-0" role="alert">
          Die Uhrzeit gilt in der Zeitzone dieser Instanz: <strong><%= resolvedInstanceTimezone %></strong>.
        </div>
        <div class="d-flex justify-content-end">
          <button type="submit" class="btn btn-success">Allgemeine Regeln speichern</button>
        </div>
      </form>
    </div>
  </section>

  <section class="card border-0 bg-body-tertiary">
    <div class="card-body">
      <form method="post" action="/admin/settings" class="vstack gap-4">
        <input type="hidden" name="_fields" value="medication_reminder_lead_days,medication_reminder_repeat_count,vaccination_reminder_lead_days,vaccination_reminder_repeat_count,appointment_reminder_lead_days,appointment_reminder_repeat_count" />
        <div>
          <h3 class="h5 mb-1">2. Erinnerungsregeln je Ereignis</h3>
          <p class="text-body-secondary mb-0">Diese Werte gelten nur, wenn in der Tierakte bei Medikament, Impfung oder Termin wirklich eine Erinnerung gesetzt wurde.</p>
        </div>
        <div class="alert alert-secondary mb-0" role="alert">Bei mehreren Erinnerungen wird nach dem eingestellten Vorlauf täglich weiter erinnert.</div>
        <div class="row g-3">
          <div class="col-md-6">
            <label class="form-label" for="medication_reminder_lead_days">Medikamente: Tage vorher</label>
            <input class="form-control" id="medication_reminder_lead_days" type="number" min="0" step="1" name="medication_reminder_lead_days" value="<%= settings.medication_reminder_lead_days || '0' %>" />
          </div>
          <div class="col-md-6">
            <label class="form-label" for="medication_reminder_repeat_count">Medikamente: Anzahl Erinnerungen</label>
            <input class="form-control" id="medication_reminder_repeat_count" type="number" min="0" step="1" name="medication_reminder_repeat_count" value="<%= settings.medication_reminder_repeat_count || '0' %>" />
          </div>
          <div class="col-md-6">
            <label class="form-label" for="vaccination_reminder_lead_days">Impfungen: Tage vorher</label>
            <input class="form-control" id="vaccination_reminder_lead_days" type="number" min="0" step="1" name="vaccination_reminder_lead_days" value="<%= settings.vaccination_reminder_lead_days || '30' %>" />
          </div>
          <div class="col-md-6">
            <label class="form-label" for="vaccination_reminder_repeat_count">Impfungen: Anzahl Erinnerungen</label>
            <input class="form-control" id="vaccination_reminder_repeat_count" type="number" min="0" step="1" name="vaccination_reminder_repeat_count" value="<%= settings.vaccination_reminder_repeat_count || '1' %>" />
          </div>
          <div class="col-md-6">
            <label class="form-label" for="appointment_reminder_lead_days">Arzttermine: Tage vorher</label>
            <input class="form-control" id="appointment_reminder_lead_days" type="number" min="0" step="1" name="appointment_reminder_lead_days" value="<%= settings.appointment_reminder_lead_days || '1' %>" />
          </div>
          <div class="col-md-6">
            <label class="form-label" for="appointment_reminder_repeat_count">Arzttermine: Anzahl Erinnerungen</label>
            <input class="form-control" id="appointment_reminder_repeat_count" type="number" min="0" step="1" name="appointment_reminder_repeat_count" value="<%= settings.appointment_reminder_repeat_count || '1' %>" />
          </div>
        </div>
        <div class="d-flex justify-content-end">
          <button type="submit" class="btn btn-success">Ereignisregeln speichern</button>
        </div>
      </form>
    </div>
  </section>

  <section class="card border-0 bg-body-tertiary">
    <div class="card-body vstack gap-4">
      <div class="d-flex flex-column flex-lg-row justify-content-between align-items-start gap-3">
        <div>
          <h3 class="h5 mb-1">3. E-Mail</h3>
          <p class="text-body-secondary mb-0">SMTP-Zugang, Zieladresse und Tests für Mail-Erinnerungen.</p>
        </div>
        <div class="d-flex flex-wrap gap-2">
          <span class="status-chip <%= communicationStatus.emailReady ? 'status-ok' : 'status-muted' %>">
            <%= communicationStatus.emailReady ? 'Konfiguriert' : 'Nicht konfiguriert' %>
          </span>
          <button type="submit" form="toggle-email-enabled-form" class="status-chip <%= settings.reminder_email_enabled === 'true' ? 'status-active' : 'status-muted' %>">
            <%= settings.reminder_email_enabled === 'true' ? 'Aktiviert' : 'Deaktiviert' %>
          </button>
        </div>
      </div>

      <form method="post" action="/admin/settings" class="vstack gap-4">
        <input type="hidden" name="_fields" value="smtp_host,smtp_port,smtp_user,smtp_password,smtp_from,notification_email_to,smtp_secure" />
        <div class="row g-3">
          <div class="col-md-6">
            <label class="form-label" for="smtp_host">SMTP Host</label>
            <input class="form-control" id="smtp_host" type="text" name="smtp_host" value="<%= settings.smtp_host || '' %>" />
          </div>
          <div class="col-md-6">
            <label class="form-label" for="smtp_port">SMTP Port</label>
            <input class="form-control" id="smtp_port" type="number" name="smtp_port" value="<%= settings.smtp_port || '587' %>" />
          </div>
          <div class="col-md-6">
            <label class="form-label" for="smtp_user">SMTP Benutzer</label>
            <input class="form-control" id="smtp_user" type="email" name="smtp_user" value="<%= settings.smtp_user || '' %>" />
          </div>
          <div class="col-md-6">
            <label class="form-label" for="smtp_password">SMTP Passwort</label>
            <input class="form-control" id="smtp_password" type="password" name="smtp_password" value="<%= settings.smtp_password || '' %>" />
          </div>
          <div class="col-md-6">
            <label class="form-label" for="smtp_from">Absenderadresse</label>
            <input class="form-control" id="smtp_from" type="email" name="smtp_from" value="<%= settings.smtp_from || '' %>" />
          </div>
          <div class="col-md-6">
            <label class="form-label" for="notification_email_to">Empfänger für Erinnerungen / Tests</label>
            <input class="form-control" id="notification_email_to" type="email" name="notification_email_to" value="<%= settings.notification_email_to || '' %>" placeholder="leer = SMTP Benutzer verwenden" />
          </div>
          <div class="col-12">
            <div class="form-check">
              <input class="form-check-input" id="smtp_secure" type="checkbox" name="smtp_secure" <%= settings.smtp_secure === 'true' ? 'checked' : '' %> />
              <label class="form-check-label" for="smtp_secure">SMTPS / SSL direkt verwenden</label>
            </div>
          </div>
        </div>
        <div class="d-flex justify-content-end">
          <button type="submit" class="btn btn-success">E-Mail speichern</button>
        </div>
      </form>

      <section class="card border bg-body">
        <div class="card-body vstack gap-3">
          <div>
            <h4 class="h6 mb-1">Prüfen und testen</h4>
            <p class="text-body-secondary mb-0">Nach dem Speichern direkt prüfen, ob der Server erreichbar ist und Testmails sauber ankommen.</p>
          </div>
          <div class="d-flex flex-wrap gap-2">
            <form method="post" action="/admin/test-smtp-connection">
              <button type="submit" class="btn btn-outline-secondary">SMTP-Verbindung prüfen</button>
            </form>
            <form method="post" action="/admin/test-email">
              <button type="submit" class="btn btn-outline-secondary">SMTP-Testmail senden</button>
            </form>
          </div>
          <div class="alert alert-secondary mb-0" role="alert">
            Letzter erfolgreicher Test:
            <strong><%= communicationStatus.emailLastSuccessfulCheckAt ? formatDateTime(communicationStatus.emailLastSuccessfulCheckAt) : 'Noch kein erfolgreicher Test' %></strong>
          </div>
          <div class="alert alert-secondary mb-0" role="alert">
            Für stabile Zustellung sollten SPF, DKIM und DMARC für die Absender-Domain korrekt gesetzt sein.
          </div>
        </div>
      </section>
    </div>
  </section>

  <section class="card border-0 bg-body-tertiary">
    <div class="card-body vstack gap-4">
      <div class="d-flex flex-column flex-lg-row justify-content-between align-items-start gap-3">
        <div>
          <h3 class="h5 mb-1">4. Telegram</h3>
          <p class="text-body-secondary mb-0">Bot-Zugang, Chat-ID und direkter Test für Telegram-Erinnerungen.</p>
        </div>
        <div class="d-flex flex-wrap gap-2">
          <span class="status-chip <%= communicationStatus.telegramReady ? 'status-ok' : 'status-muted' %>">
            <%= communicationStatus.telegramReady ? 'Konfiguriert' : 'Nicht konfiguriert' %>
          </span>
          <button type="submit" form="toggle-telegram-enabled-form" class="status-chip <%= settings.reminder_telegram_enabled === 'true' ? 'status-active' : 'status-muted' %>">
            <%= settings.reminder_telegram_enabled === 'true' ? 'Aktiviert' : 'Deaktiviert' %>
          </button>
        </div>
      </div>

      <form id="telegram-settings-form" method="post" action="/admin/settings" class="vstack gap-4">
        <input type="hidden" name="_fields" value="telegram_bot_token,telegram_chat_id" />
        <section class="card border bg-body">
          <div class="card-body vstack gap-3">
            <div>
              <h4 class="h6 mb-1">BotFather-Anleitung</h4>
              <p class="text-body-secondary mb-2">Einmal sauber einrichten, danach laufen Telegram-Tests und Erinnerungen direkt über den Bot.</p>
              <div class="alert alert-secondary mb-0" role="alert">
                <ol class="mb-0 ps-3">
                  <li>In Telegram <strong>@BotFather</strong> öffnen.</li>
                  <li>Mit <strong>/newbot</strong> einen Bot erstellen und den Token kopieren.</li>
                  <li>Nur den Token selbst speichern. Das Präfix <strong>bot</strong> ergänzt HeartPet beim Aufruf automatisch.</li>
                  <li>Dem Bot einmal schreiben.</li>
                  <li>Im Browser <strong>https://api.telegram.org/botTOKEN/getUpdates</strong> öffnen und die <strong>chat.id</strong> auslesen.</li>
                  <li>Token und Chat ID hier speichern.</li>
                </ol>
              </div>
            </div>
            <div class="row g-3">
              <div class="col-md-6">
                <label class="form-label" for="telegram_bot_token">Telegram Bot Token</label>
                <input class="form-control" id="telegram_bot_token" type="text" name="telegram_bot_token" value="<%= settings.telegram_bot_token || '' %>" />
              </div>
              <div class="col-md-6">
                <label class="form-label" for="telegram_chat_id">Telegram Chat ID</label>
                <input class="form-control" id="telegram_chat_id" type="text" name="telegram_chat_id" value="<%= settings.telegram_chat_id || '' %>" />
              </div>
              <div class="col-12">
                <div class="alert alert-secondary mb-0" role="alert">Nur den echten Token aus BotFather eintragen. Das Wort <strong>bot</strong> gehört nicht zum gespeicherten Token.</div>
              </div>
            </div>
          </div>
        </section>

        <div class="d-flex justify-content-end">
          <button type="submit" class="btn btn-success">Telegram speichern</button>
        </div>
      </form>

      <section class="card border bg-body">
        <div class="card-body vstack gap-3">
          <div>
            <h4 class="h6 mb-1">Prüfen und testen</h4>
            <p class="text-body-secondary mb-0">Wenn Token und Chat-ID gespeichert sind, kannst du direkt eine Testnachricht senden.</p>
          </div>
          <div class="d-flex flex-wrap gap-2">
            <form id="telegram-test-form" method="post" action="/admin/test-telegram">
              <button type="submit" class="btn btn-outline-secondary">Telegram-Test senden</button>
            </form>
          </div>
          <div class="alert alert-secondary mb-0" role="alert">
            Letzter erfolgreicher Test:
            <strong><%= communicationStatus.telegramLastSuccessfulCheckAt ? formatDateTime(communicationStatus.telegramLastSuccessfulCheckAt) : 'Noch kein erfolgreicher Test' %></strong>
          </div>
        </div>
      </section>
    </div>
  </section>
</div>

<section class="card border-0 bg-body-tertiary">
  <div class="card-body vstack gap-4">
    <div class="d-flex flex-column flex-lg-row justify-content-between align-items-start gap-3">
      <div>
        <h3 class="h5 mb-1">5. ntfy</h3>
        <p class="text-body-secondary mb-0">Push-Nachrichten über ntfy.sh oder deinen eigenen ntfy-Server.</p>
      </div>
      <div class="d-flex flex-wrap gap-2">
        <span class="status-chip <%= communicationStatus.ntfyReady ? 'status-ok' : 'status-muted' %>"><%= communicationStatus.ntfyReady ? 'Konfiguriert' : 'Nicht konfiguriert' %></span>
        <button type="submit" form="toggle-ntfy-enabled-form" class="status-chip <%= settings.reminder_ntfy_enabled === 'true' ? 'status-active' : 'status-muted' %>"><%= settings.reminder_ntfy_enabled === 'true' ? 'Aktiviert' : 'Deaktiviert' %></button>
      </div>
    </div>
    <form method="post" action="/admin/settings" class="vstack gap-3">
      <input type="hidden" name="_fields" value="ntfy_server_url,ntfy_topic,ntfy_access_token" />
      <div class="row g-3">
        <div class="col-md-6">
          <label class="form-label" for="ntfy_server_url">ntfy-Server</label>
          <input class="form-control" id="ntfy_server_url" name="ntfy_server_url" type="url" value="<%= settings.ntfy_server_url || 'https://ntfy.sh' %>" placeholder="https://ntfy.sh" />
        </div>
        <div class="col-md-6">
          <label class="form-label" for="ntfy_topic">Topic</label>
          <input class="form-control" id="ntfy_topic" name="ntfy_topic" value="<%= settings.ntfy_topic || '' %>" placeholder="heartpet-mein-geheimes-topic" />
        </div>
        <div class="col-12">
          <label class="form-label" for="ntfy_access_token">Access-Token (optional)</label>
          <input class="form-control" id="ntfy_access_token" name="ntfy_access_token" type="password" value="<%= settings.ntfy_access_token || '' %>" autocomplete="new-password" />
          <div class="form-text">Für ntfy.sh genügt ein schwer zu erratendes Topic. Bei einem geschützten Topic oder eigenen Server zusätzlich den Access-Token eintragen.</div>
        </div>
      </div>
      <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
        <span class="text-body-secondary small">Letzter erfolgreicher Test: <strong><%= communicationStatus.ntfyLastSuccessfulCheckAt ? formatDateTime(communicationStatus.ntfyLastSuccessfulCheckAt) : 'Noch kein erfolgreicher Test' %></strong></span>
        <button type="submit" class="btn btn-success">ntfy speichern</button>
      </div>
    </form>
    <form method="post" action="/admin/test-ntfy">
      <button type="submit" class="btn btn-outline-secondary">ntfy-Test senden</button>
    </form>
  </div>
</section>

<%- include('../partials/bottom') %>
