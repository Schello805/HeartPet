<%- include('../partials/top', { pageTitle, pageClass: 'care-management-page' }) %>
<% const isAdmin = permissions.canManageAdmin; %>

<section class="card border-0 app-section-card mb-3">
  <div class="card-body p-3">
    <div class="d-flex flex-wrap justify-content-between align-items-start gap-3">
      <div><p class="eyebrow mb-1">Versorgung</p><h2 class="h5 mb-1">Bestände und Kosten</h2><p class="text-body-secondary mb-0">Futter, Medikamente und laufende Ausgaben gemeinsam im Blick behalten.</p></div>
      <a href="/calendar.ics" class="btn btn-outline-secondary">Kalender exportieren</a>
    </div>
  </div>
</section>

<div class="care-summary-grid mb-3">
  <article class="card border-0 app-metric-card"><div class="card-body p-3"><span class="small text-body-secondary">Niedriger Bestand</span><strong class="d-block fs-4"><%= summary.lowStockCount %></strong></div></article>
  <article class="card border-0 app-metric-card"><div class="card-body p-3"><span class="small text-body-secondary">Abgelaufen / bald fällig</span><strong class="d-block fs-4"><%= summary.expiringCount %></strong></div></article>
  <article class="card border-0 app-metric-card"><div class="card-body p-3"><span class="small text-body-secondary">Kosten diesen Monat</span><strong class="d-block fs-4"><%= formatCurrency(summary.monthCents) %></strong></div></article>
  <article class="card border-0 app-metric-card"><div class="card-body p-3"><span class="small text-body-secondary">Kosten dieses Jahr</span><strong class="d-block fs-4"><%= formatCurrency(summary.yearCents) %></strong></div></article>
</div>

<section class="card border-0 app-section-card mb-3" id="bestand">
  <div class="card-body p-3">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
      <div><h2 class="h5 mb-1">Bestand</h2><p class="small text-body-secondary mb-0">Mindestmengen und Ablaufdaten werden automatisch hervorgehoben.</p></div>
      <% if (isAdmin) { %><a class="btn btn-primary" href="/versorgung/bestand/new" data-drawer="care-management">+ Bestand</a><% } %>
    </div>
    <% if (!inventory.length) { %>
      <div class="empty-state">Noch keine Bestände erfasst.<% if (isAdmin) { %> Lege Futter, Medikamente oder Verbrauchsmaterial an.<% } %></div>
    <% } else { %>
      <div class="care-card-grid">
        <% inventory.forEach((item) => { const expiresSoon = item.expires_on && new Date(`${item.expires_on}T23:59:59`) <= new Date(Date.now() + 30 * 86400000); %>
          <article class="card h-100 <%= item.is_low ? 'care-item-warning' : '' %>">
            <div class="card-body p-3">
              <div class="d-flex justify-content-between align-items-start gap-2"><div><span class="badge text-bg-secondary-subtle border mb-2"><%= item.category %></span><h3 class="h6 mb-1"><%= item.name %></h3></div><strong><%= Number(item.quantity).toLocaleString('de-DE') %> <%= item.unit %></strong></div>
              <div class="small text-body-secondary">Mindestbestand: <%= Number(item.minimum_quantity).toLocaleString('de-DE') %> <%= item.unit %></div>
              <% if (item.expires_on) { %><div class="small mt-1 <%= expiresSoon ? 'text-danger fw-semibold' : 'text-body-secondary' %>">Haltbar bis <%= formatDate(item.expires_on) %></div><% } %>
              <% if (item.is_low) { %><div class="app-status-pill is-warning mt-2">Nachkaufen</div><% } %>
              <% if (item.notes) { %><p class="small mt-2 mb-0"><%= item.notes %></p><% } %>
              <% if (isAdmin) { %><div class="d-flex gap-2 mt-3"><a class="btn btn-outline-secondary btn-sm" href="/versorgung/bestand/<%= item.id %>/edit" data-drawer="care-management">Bearbeiten</a><form method="post" action="/versorgung/bestand/<%= item.id %>/delete" data-confirm="Diesen Bestand wirklich entfernen?" data-confirm-modal><button class="btn btn-outline-danger btn-sm" type="submit">Löschen</button></form></div><% } %>
            </div>
          </article>
        <% }) %>
      </div>
    <% } %>
  </div>
</section>

<section class="card border-0 app-section-card" id="kosten">
  <div class="card-body p-3">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
      <div><h2 class="h5 mb-1">Kosten</h2><p class="small text-body-secondary mb-0">Die letzten 100 Ausgaben, optional einem Tier zugeordnet.</p></div>
      <% if (isAdmin) { %><a class="btn btn-primary" href="/versorgung/kosten/new" data-drawer="care-management">+ Kosten</a><% } %>
    </div>
    <% if (!expenses.length) { %>
      <div class="empty-state">Noch keine Kosten erfasst.</div>
    <% } else { %>
      <div class="table-responsive care-expense-table"><table class="table align-middle mb-0"><thead><tr><th>Datum</th><th>Beschreibung</th><th>Kategorie</th><th>Tier</th><th class="text-end">Betrag</th><% if (isAdmin) { %><th><span class="visually-hidden">Aktionen</span></th><% } %></tr></thead><tbody>
        <% expenses.forEach((item) => { %><tr><td><%= formatDate(item.expense_date) %></td><td><strong><%= item.description %></strong><% if (item.notes) { %><span class="small text-body-secondary d-block"><%= item.notes %></span><% } %></td><td><%= item.category %></td><td><%= item.animal_name || 'Allgemein' %></td><td class="text-end fw-semibold"><%= formatCurrency(item.amount_cents) %></td><% if (isAdmin) { %><td><div class="d-flex justify-content-end gap-1"><a class="btn btn-outline-secondary btn-sm" href="/versorgung/kosten/<%= item.id %>/edit" data-drawer="care-management">Bearbeiten</a><form method="post" action="/versorgung/kosten/<%= item.id %>/delete" data-confirm="Diese Kostenposition wirklich entfernen?" data-confirm-modal><button class="btn btn-outline-danger btn-sm" type="submit">Löschen</button></form></div></td><% } %></tr><% }) %>
      </tbody></table></div>
    <% } %>
  </div>
</section>

<%- include('../partials/bottom') %>
