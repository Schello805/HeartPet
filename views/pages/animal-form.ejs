<%- include('../partials/top', { pageTitle }) %>
<%
  const currentStatus = animal?.status || 'Aktiv';
  const statusWorkflow = {
    Aktiv: {
      title: 'Aktiver Bestand',
      tone: 'success',
      intro: 'Das Tier bleibt im aktiven Bestand und kann normal weiter gepflegt werden.',
      bullets: [
        'Erinnerungen, Termine und Alltags-Einträge bleiben aktiv.',
        'Das Tier erscheint weiter unter „Meine Tiere“.',
      ],
      confirmLabel: '',
    },
    Vermittelt: {
      title: 'Wechsel in die Historie',
      tone: 'warning',
      intro: 'Das Tier wird aus dem aktiven Bestand genommen und in die Historie verschoben.',
      bullets: [
        'Offene Erinnerungen werden geschlossen.',
        'Das Tier erscheint danach nur noch unter „Historie“.',
      ],
      confirmLabel: 'Ich bestätige, dass dieses Tier als vermittelt in die Historie wechseln soll.',
    },
    Verkauft: {
      title: 'Wechsel in die Historie',
      tone: 'warning',
      intro: 'Das Tier wird aus dem aktiven Bestand genommen und als verkauft archiviert.',
      bullets: [
        'Offene Erinnerungen werden geschlossen.',
        'Das Tier erscheint danach nur noch unter „Historie“.',
      ],
      confirmLabel: 'Ich bestätige, dass dieses Tier als verkauft in die Historie wechseln soll.',
    },
    Verstorben: {
      title: 'Wechsel in die Ruhestätte',
      tone: 'secondary',
      intro: 'Das Tier wird aus dem aktiven Bestand genommen und würdevoll in die Ruhestätte verschoben.',
      bullets: [
        'Offene Erinnerungen werden geschlossen.',
        'Das Tier erscheint danach nur noch unter „Ruhestätte“.',
      ],
      confirmLabel: 'Ich bestätige, dass dieses Tier als verstorben in die Ruhestätte wechseln soll.',
    },
  };
  const currentTransitionConfig = {
    Aktiv: {
      nameLabel: '',
      nameRequired: false,
      dateLabel: '',
      dateRequired: false,
      noteLabel: '',
      helper: '',
    },
    Vermittelt: {
      nameLabel: 'Vermittelt an',
      nameRequired: true,
      dateLabel: 'Vermittelt am',
      dateRequired: true,
      noteLabel: 'Übergabehinweis',
      helper: 'Halte fest, an wen das Tier vermittelt wurde und wann die Übergabe stattgefunden hat.',
    },
    Verkauft: {
      nameLabel: 'Verkauft an',
      nameRequired: true,
      dateLabel: 'Verkauft am',
      dateRequired: true,
      noteLabel: 'Verkaufshinweis',
      helper: 'Halte Käufer und Verkaufsdatum fest, damit die Historie nachvollziehbar bleibt.',
    },
    Verstorben: {
      nameLabel: 'Ort / Zusammenhang',
      nameRequired: false,
      dateLabel: 'Abschied am',
      dateRequired: true,
      noteLabel: 'Erinnerungsnotiz',
      helper: 'Ein stiller Eintrag für Abschiedsdatum und eine würdige Erinnerung.',
    },
  };
%>

<section class="drawer-fragment card border-0 bg-body-tertiary" data-drawer-fragment="animal-form" data-drawer-title="<%= animal ? 'Tier bearbeiten' : 'Neues Tier anlegen' %>">
  <div class="card-body">
    <h2 class="h4 mb-4"><%= animal ? 'Tier bearbeiten' : 'Neues Tier anlegen' %></h2>

    <form method="post" action="<%= animal ? `/animals/${animal.id}/update` : '/animals' %>" class="vstack gap-4" data-drawer-form="animal">
      <input type="hidden" name="return_to" value="<%= typeof returnTo !== 'undefined' ? returnTo : '/animals' %>" />
      <input type="hidden" name="original_status" value="<%= currentStatus %>" />

      <section class="card border bg-body">
        <div class="card-body">
          <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-3">
            <div>
              <h3 class="h5 mb-1">Direkt starten</h3>
              <p class="text-body-secondary mb-0">Name und Tierart reichen für den Start. Alles andere kannst du jetzt oder später ergänzen.</p>
            </div>
            <span class="badge text-bg-secondary-subtle border">Pflicht zuerst</span>
          </div>
          <div class="row g-3">
            <div class="col-md-6">
              <label class="form-label" for="animal-name">Name</label>
              <input class="form-control" id="animal-name" type="text" name="name" required value="<%= animal?.name || '' %>" />
            </div>
            <div class="col-md-6">
              <label class="form-label" for="animal-species">Tierart</label>
              <input
                class="form-control"
                id="animal-species"
                type="text"
                name="species_name"
                required
                list="species-suggestions"
                data-species-autocomplete="true"
                autocomplete="off"
                value="<%= animal?.species_name || '' %>"
                placeholder="Vorhandene Tierart wählen oder neue eingeben"
                title="Beginne zu tippen. Bestehende Tierarten werden vorgeschlagen. Wenn die Tierart noch nicht existiert, wird sie beim Speichern automatisch angelegt."
              />
              <datalist id="species-suggestions">
                <% species.forEach((item) => { %>
                  <option value="<%= item.name %>"></option>
                <% }) %>
              </datalist>
              <div class="form-text">Vorhandene Tierarten werden vorgeschlagen. Neue Einträge legt HeartPet beim Speichern automatisch an.</div>
            </div>
            <div class="col-md-6">
              <label class="form-label" for="animal-status">Status</label>
              <select class="form-select" id="animal-status" name="status" data-animal-status-select>
                <% ['Aktiv', 'Vermittelt', 'Verkauft', 'Verstorben'].forEach((status) => { %>
                  <option value="<%= status %>" <%= currentStatus === status ? 'selected' : '' %>><%= status %></option>
                <% }) %>
              </select>
              <div class="form-text">Aktive Tiere erscheinen im Bestand. Vermittelte und verkaufte Tiere wechseln in die Historie. Verstorbene Tiere erscheinen ausschließlich in der Ruhestätte.</div>
            </div>
            <div class="col-md-6">
              <label class="form-label" for="animal-sex">Geschlecht</label>
              <select class="form-select" id="animal-sex" name="sex">
                <option value="">Unbekannt</option>
                <option value="Weiblich" <%= animal?.sex === 'Weiblich' ? 'selected' : '' %>>Weiblich</option>
                <option value="Männlich" <%= animal?.sex === 'Männlich' ? 'selected' : '' %>>Männlich</option>
              </select>
            </div>
            <div class="col-md-6">
              <label class="form-label" for="animal-birth-date">Geburtsdatum</label>
              <input class="form-control" id="animal-birth-date" type="date" name="birth_date" value="<%= animal?.birth_date || '' %>" />
            </div>
            <div class="col-md-6">
              <label class="form-label" for="animal-intake-date">Aufnahmedatum</label>
              <input class="form-control" id="animal-intake-date" type="date" name="intake_date" value="<%= animal?.intake_date || '' %>" />
            </div>
          </div>
        </div>
      </section>

      <section class="card border bg-body" data-status-workflow data-original-status="<%= currentStatus %>">
        <div class="card-body vstack gap-3">
          <div class="d-flex flex-wrap justify-content-between align-items-start gap-2">
            <div>
              <h3 class="h5 mb-1">Statuswechsel</h3>
              <p class="text-body-secondary mb-0">HeartPet zeigt dir direkt, was beim gewählten Status als Nächstes passiert.</p>
            </div>
            <span class="status-chip status-<%= statusWorkflow[currentStatus].tone %>" data-status-workflow-chip><%= currentStatus %></span>
          </div>

          <% Object.entries(statusWorkflow).forEach(([statusName, config]) => { %>
            <div class="alert alert-<%= config.tone %> mb-0 <%= currentStatus === statusName ? '' : 'd-none' %>" role="alert" data-status-panel="<%= statusName %>">
              <strong class="d-block mb-2"><%= config.title %></strong>
              <p class="mb-2"><%= config.intro %></p>
              <ul class="mb-0 ps-3">
                <% config.bullets.forEach((bullet) => { %>
                  <li><%= bullet %></li>
                <% }) %>
              </ul>
            </div>
          <% }) %>

          <div class="<%= currentStatus === 'Aktiv' ? 'd-none' : '' %>" data-status-confirm-wrap>
            <div class="form-check">
              <input
                class="form-check-input"
                type="checkbox"
                id="status-transition-confirmed"
                name="status_transition_confirmed"
                value="true"
                data-status-confirm-input
                <%= currentStatus === 'Aktiv' ? '' : 'required' %>
              />
              <label class="form-check-label" for="status-transition-confirmed" data-status-confirm-label>
                <%= statusWorkflow[currentStatus].confirmLabel %>
              </label>
            </div>
          </div>

          <section class="<%= currentStatus === 'Aktiv' ? 'd-none' : '' %> card border bg-body" data-status-detail-wrap>
            <div class="card-body">
              <% Object.entries(currentTransitionConfig).forEach(([statusName, config]) => { %>
                <div class="<%= currentStatus === statusName ? '' : 'd-none' %>" data-status-detail-panel="<%= statusName %>">
                  <% if (statusName !== 'Aktiv') { %>
                    <div class="mb-3">
                      <strong class="d-block mb-1">Abschluss dokumentieren</strong>
                      <p class="text-body-secondary mb-0"><%= config.helper %></p>
                    </div>
                    <div class="row g-3">
                      <div class="col-md-6 <%= config.nameLabel ? '' : 'd-none' %>">
                        <label class="form-label" for="status-context-name"><%= config.nameLabel || 'Details' %></label>
                        <input
                          class="form-control"
                          id="status-context-name"
                          type="text"
                          name="status_context_name"
                          value="<%= animal?.status_context_name || '' %>"
                          data-status-detail-name
                          <%= currentStatus === statusName && config.nameRequired ? 'required' : '' %>
                        />
                      </div>
                      <div class="col-md-6">
                        <label class="form-label" for="status-context-date"><%= config.dateLabel || 'Datum' %></label>
                        <input
                          class="form-control"
                          id="status-context-date"
                          type="date"
                          name="status_context_date"
                          value="<%= animal?.status_context_date || '' %>"
                          data-status-detail-date
                          <%= currentStatus === statusName && config.dateRequired ? 'required' : '' %>
                        />
                      </div>
                      <div class="col-12">
                        <label class="form-label" for="memorial-note"><%= config.noteLabel || 'Notiz' %></label>
                        <textarea class="form-control" id="memorial-note" name="memorial_note" rows="4" data-status-detail-note><%= animal?.memorial_note || '' %></textarea>
                      </div>
                    </div>
                  <% } %>
                </div>
              <% }) %>
            </div>
          </section>
        </div>
      </section>

      <section class="accordion animal-form-optional" id="animalFormOptionalAccordion">
        <div class="accordion-item">
          <h3 class="accordion-header" id="animalFormOptionalHeading">
            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#animalFormOptionalBody" aria-expanded="false" aria-controls="animalFormOptionalBody">
              Mehr Angaben (später möglich)
            </button>
          </h3>
          <div id="animalFormOptionalBody" class="accordion-collapse collapse" aria-labelledby="animalFormOptionalHeading" data-bs-parent="#animalFormOptionalAccordion">
            <div class="accordion-body">
              <div class="row g-3">
                <div class="col-md-6">
                  <label class="form-label" for="animal-source">Herkunft</label>
                  <input class="form-control" id="animal-source" type="text" name="source" value="<%= animal?.source || '' %>" placeholder="Züchter, Fundtier, Vorbesitzer" />
                </div>
                <div class="col-md-6">
                  <label class="form-label" for="animal-breed">Rasse / Unterart</label>
                  <input class="form-control" id="animal-breed" type="text" name="breed" value="<%= animal?.breed || '' %>" />
                </div>
                <div class="col-md-6">
                  <label class="form-label" for="animal-color">Farbe</label>
                  <input class="form-control" id="animal-color" type="text" name="color" value="<%= animal?.color || '' %>" />
                </div>
                <div class="col-md-6">
                  <label class="form-label" for="animal-weight">Gewicht in kg</label>
                  <input class="form-control" id="animal-weight" type="number" step="0.01" name="weight_kg" value="<%= animal?.weight_kg || '' %>" />
                </div>
                <div class="col-12">
                  <label class="form-label" for="animal-chip">Mikrochip / Kennzeichen</label>
                  <input class="form-control" id="animal-chip" type="text" name="microchip_number" value="<%= animal?.microchip_number || '' %>" />
                </div>
                <div class="col-12">
                  <label class="form-label" for="animal-vet">Tierarzt für dieses Tier</label>
                  <select class="form-select" id="animal-vet" name="veterinarian_id" title="Wenn du hier nichts auswählst, verwendet HeartPet automatisch den Standardtierarzt der hinterlegten Tierart.">
                    <option value="">Standard je Tierart verwenden</option>
                    <% veterinarians.forEach((item) => { %>
                      <option value="<%= item.id %>" <%= String(animal?.veterinarian_id || '') === String(item.id) ? 'selected' : '' %>><%= item.name %><%= item.city ? ` (${item.city})` : '' %></option>
                    <% }) %>
                  </select>
                  <div class="form-text">Nur auswählen, wenn dieses Tier vom Standard der Tierart abweichen soll.</div>
                </div>
                <div class="col-12">
                  <label class="form-label" for="animal-notes">Allgemeine Notizen</label>
                  <textarea class="form-control" id="animal-notes" name="notes" rows="5"><%= animal?.notes || '' %></textarea>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <div class="d-flex flex-column flex-lg-row justify-content-between align-items-start align-items-lg-center gap-3 pt-2 border-top">
        <p class="text-body-secondary small mb-0"><%= animal ? 'Du kannst jederzeit weitere Angaben ergänzen oder den Status des Tiers anpassen.' : 'Nach dem Speichern landest du direkt wieder in der Tierübersicht oder in der gewünschten Akte.' %></p>
        <div class="d-flex flex-wrap gap-2">
          <button type="submit" class="btn btn-success"><%= animal ? 'Änderungen speichern' : 'Tier anlegen' %></button>
          <% if (animal) { %>
            <a href="/animals/<%= animal.id %>" class="btn btn-outline-secondary">Zurück zur Akte</a>
          <% } else { %>
            <a href="/animals" class="btn btn-outline-secondary">Abbrechen</a>
          <% } %>
        </div>
      </div>
    </form>
  </div>
</section>

<%- include('../partials/bottom') %>
