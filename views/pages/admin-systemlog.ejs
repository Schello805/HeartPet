<%- include('../partials/top', { pageTitle }) %>

<div class="vstack gap-3">
  <section class="card border-0 bg-body-tertiary">
    <div class="card-body d-flex flex-column flex-lg-row justify-content-between align-items-start gap-3">
      <div>
        <p class="eyebrow mb-1">Systemlog</p>
        <h2 class="h4 mb-2">Zustand, Versand und Änderungen</h2>
        <p class="text-body-secondary mb-0">Hier siehst du auf einen Blick, ob die Instanz ruhig läuft, welche Benachrichtigungen fehlgeschlagen sind und welche Änderungen zuletzt protokolliert wurden.</p>
      </div>
      <span class="status-chip <%= overview.notificationErrors24h ? 'status-warning' : 'status-ok' %>">
        <%= overview.notificationErrors24h ? `${overview.notificationErrors24h} Fehler in 24h` : 'Keine Fehler in 24h' %>
      </span>
    </div>
  </section>

  <div class="row g-3">
    <div class="col-sm-6 col-xl-3">
      <section class="card border-0 bg-body-tertiary h-100">
        <div class="card-body">
          <span class="small text-body-secondary d-block mb-1">Aktive Tiere</span>
          <strong class="h4 d-block mb-1"><%= overview.activeAnimals %></strong>
          <small class="text-body-secondary">Bestand mit aktiver Akte</small>
        </div>
      </section>
    </div>
    <div class="col-sm-6 col-xl-3">
      <section class="card border-0 bg-body-tertiary h-100">
        <div class="card-body">
          <span class="small text-body-secondary d-block mb-1">Offene Erinnerungen</span>
          <strong class="h4 d-block mb-1"><%= overview.openReminders %></strong>
          <small class="text-body-secondary">Nur aktive Tiere</small>
        </div>
      </section>
    </div>
    <div class="col-sm-6 col-xl-3">
      <section class="card border-0 bg-body-tertiary h-100">
        <div class="card-body">
          <span class="small text-body-secondary d-block mb-1">Instanz-Zeitzone</span>
          <strong class="h6 d-block mb-1"><%= overview.instanceTimezone %></strong>
          <small class="text-body-secondary">Für Cronjobs und Zusammenfassungen</small>
        </div>
      </section>
    </div>
    <div class="col-sm-6 col-xl-3">
      <section class="card border-0 bg-body-tertiary h-100">
        <div class="card-body">
          <span class="small text-body-secondary d-block mb-1">Letzte Benachrichtigung</span>
          <strong class="h6 d-block mb-1"><%= overview.lastNotificationAt ? formatDateTime(overview.lastNotificationAt) : 'Noch kein Versand' %></strong>
          <small class="text-body-secondary">
            E-Mail <%= overview.emailReady && overview.emailEnabled ? 'aktiv' : 'inaktiv' %> · Telegram <%= overview.telegramReady && overview.telegramEnabled ? 'aktiv' : 'inaktiv' %>
          </small>
        </div>
      </section>
    </div>
  </div>

  <section class="card border-0 bg-body-tertiary">
    <div class="card-body">
      <div class="d-flex flex-column flex-lg-row justify-content-between align-items-start gap-3 mb-3">
        <div>
          <h3 class="h5 mb-1">Mail- und Benachrichtigungslog</h3>
          <p class="text-body-secondary mb-0">Filtere gezielt nach Kanal, um Versandprobleme oder erfolgreiche Tests schneller zu sehen.</p>
        </div>
      </div>

      <form method="get" action="/admin/systemlog" class="row g-3 align-items-end mb-4">
        <div class="col-md-4">
          <label class="form-label" for="systemlog-level">Kanal</label>
          <select class="form-select" id="systemlog-level" name="level">
            <option value="all" <%= filters.level === 'all' ? 'selected' : '' %>>Alle</option>
            <option value="email" <%= filters.level === 'email' ? 'selected' : '' %>>E-Mail</option>
            <option value="telegram" <%= filters.level === 'telegram' ? 'selected' : '' %>>Telegram</option>
          </select>
        </div>
        <div class="col-md-auto d-flex flex-wrap gap-2">
          <button type="submit" class="btn btn-primary">Filtern</button>
          <a href="/admin/systemlog" class="btn btn-outline-secondary">Zurücksetzen</a>
        </div>
      </form>

      <% if (!notificationLogs.length) { %>
        <div class="card border bg-body">
          <div class="card-body">
            <strong class="d-block mb-1">Noch keine Benachrichtigungs-Logs</strong>
            <p class="text-body-secondary mb-0">Sobald E-Mail- oder Telegram-Versand stattfindet, erscheinen die Einträge hier im Verlauf.</p>
          </div>
        </div>
      <% } else { %>
        <div class="table-responsive">
          <table class="table align-middle mb-0">
            <thead>
              <tr>
                <th>Zeit</th>
                <th>Kanal</th>
                <th>Typ</th>
                <th>Empfänger</th>
                <th>Status</th>
                <th>Fehler</th>
              </tr>
            </thead>
            <tbody>
              <% notificationLogs.forEach((item) => { %>
                <tr>
                  <td><%= formatDateTime(item.created_at) %></td>
                  <td><%= item.channel %></td>
                  <td><%= item.notification_type %></td>
                  <td><%= item.recipient || '-' %></td>
                  <td><span class="status-chip status-<%= item.status %>"><%= item.status %></span></td>
                  <td><%= item.error_message || '-' %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>
  </section>

  <section class="card border-0 bg-body-tertiary">
    <div class="card-body">
      <div class="mb-3">
        <h3 class="h5 mb-1">Audit-Log</h3>
        <p class="text-body-secondary mb-0">Zeigt Änderungen durch Nutzer, Systemreaktionen und relevante Folgeaktionen der App.</p>
      </div>

      <% if (!auditLogs.length) { %>
        <div class="card border bg-body">
          <div class="card-body">
            <strong class="d-block mb-1">Noch keine Audit-Einträge</strong>
            <p class="text-body-secondary mb-0">Sobald in der App Aktionen protokolliert werden, erscheinen sie hier automatisch.</p>
          </div>
        </div>
      <% } else { %>
        <div class="table-responsive">
          <table class="table align-middle mb-0">
            <thead>
              <tr>
                <th>Zeit</th>
                <th>Benutzer</th>
                <th>Aktion</th>
                <th>Objekt</th>
                <th>Details</th>
              </tr>
            </thead>
            <tbody>
              <% auditLogs.forEach((item) => { %>
                <tr>
                  <td><%= formatDateTime(item.created_at) %></td>
                  <td><%= item.actor_email || '-' %></td>
                  <td><%= item.action %></td>
                  <td><%= item.entity_type || '-' %> <%= item.entity_id || '' %></td>
                  <td><code><%= item.details || '-' %></code></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>
  </section>
</div>

<%- include('../partials/bottom') %>
