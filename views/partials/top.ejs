<!DOCTYPE html>
<html lang="de">
  <head>
    <% const resolvedAppLogoUrl = typeof appLogoUrl !== 'undefined' && appLogoUrl ? appLogoUrl : '/static/images/logo-heartpet.png'; %>
    <% const resolvedAppName = appSettings.app_name || "HeartPet"; %>
    <% const defaultSeoMeta = typeof seoMeta !== 'undefined' && seoMeta ? seoMeta : {}; %>
    <% const pageSeo = typeof seo !== 'undefined' && seo ? seo : {}; %>
    <% const mergedSeo = Object.assign({}, defaultSeoMeta, pageSeo); %>
    <% const resolvedAppBaseUrl = typeof appBaseUrl !== 'undefined' && appBaseUrl ? appBaseUrl.replace(/\/+$/, '') : ''; %>
    <% const absoluteLogoUrl = /^https?:\/\//i.test(resolvedAppLogoUrl) ? resolvedAppLogoUrl : `${resolvedAppBaseUrl}${resolvedAppLogoUrl.startsWith('/') ? '' : '/'}${resolvedAppLogoUrl}`; %>
    <% const canonicalUrl = mergedSeo.canonicalUrl || ''; %>
    <% const metaDescription = mergedSeo.description || `${resolvedAppName} bündelt Tierakten, Dokumente, Erinnerungen und Verwaltungsaufgaben in einer Oberfläche.`; %>
    <% const robotsValue = mergedSeo.robots || 'noindex,nofollow'; %>
    <% const ogType = mergedSeo.type || 'website'; %>
    <% const fullTitle = `${pageTitle} | ${resolvedAppName}`; %>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= fullTitle %></title>
    <meta name="description" content="<%= metaDescription %>" />
    <meta name="robots" content="<%= robotsValue %>" />
    <% if (canonicalUrl) { %>
      <link rel="canonical" href="<%= canonicalUrl %>" />
    <% } %>
    <meta property="og:locale" content="de_DE" />
    <meta property="og:site_name" content="<%= mergedSeo.siteName || resolvedAppName %>" />
    <meta property="og:type" content="<%= ogType %>" />
    <meta property="og:title" content="<%= fullTitle %>" />
    <meta property="og:description" content="<%= metaDescription %>" />
    <% if (canonicalUrl) { %>
      <meta property="og:url" content="<%= canonicalUrl %>" />
    <% } %>
    <meta property="og:image" content="<%= mergedSeo.imageUrl || absoluteLogoUrl %>" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="<%= fullTitle %>" />
    <meta name="twitter:description" content="<%= metaDescription %>" />
    <meta name="twitter:image" content="<%= mergedSeo.imageUrl || absoluteLogoUrl %>" />
    <script>
      try {
        if (sessionStorage.getItem("heartpet-nav-loaded")) {
          document.documentElement.classList.add("no-page-anim");
        }
      } catch (error) {}
    </script>
    <link rel="icon" type="image/png" sizes="any" href="<%= resolvedAppLogoUrl %>" />
    <link rel="shortcut icon" type="image/png" href="<%= resolvedAppLogoUrl %>" />
    <link rel="apple-touch-icon" href="<%= resolvedAppLogoUrl %>" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css" integrity="sha384-LN+7fdVzj6u52u30Kp6M/trliBMCMKTyK833zpbD+pXdCLuTusPj697FH4R/5mcr" crossorigin="anonymous" />
    <link rel="stylesheet" href="/static/css/theme-foundation.css" />
    <link rel="stylesheet" href="/static/css/theme-layout.css" />
    <link rel="stylesheet" href="/static/css/theme-components.css" />
  </head>
  <body class="bootstrap-app<%= typeof pageClass !== 'undefined' && pageClass ? ` ${pageClass}` : '' %>" data-bs-theme="light">
    <div class="app-shell">
      <aside class="app-sidebar d-none d-lg-flex flex-column bg-body border-end">
        <div class="app-sidebar-brand">
          <img class="brand-logo" src="<%= resolvedAppLogoUrl %>" alt="HeartPet Logo" />
          <div class="brand-text">
            <strong><%= appSettings.app_name || "HeartPet" %></strong>
            <span><%= appSettings.organization_name || "Tierverwaltung auf einen Blick" %></span>
          </div>
        </div>

        <div class="app-sidebar-nav-wrap px-3 py-3">
          <%- include('./sidebar-nav', { navScope: 'desktop' }) %>
        </div>

        <div class="app-sidebar-footer mt-auto px-3 py-3 border-top">
          <div class="small-label">Eingeloggt als</div>
          <% const displayName = String(currentUser?.name || "").trim(); %>
          <strong><%= displayName || "-" %></strong>
          <form method="post" action="/logout" class="mt-3">
            <button type="submit" class="btn btn-outline-secondary w-100">Abmelden</button>
          </form>
        </div>
      </aside>

      <div class="app-main">
        <div class="toast-viewport" aria-live="polite" aria-atomic="true">
          <% if (flash) { %>
            <div class="flash toast flash-<%= flash.type %>" data-toast>
              <div class="toast-body">
                <strong class="toast-title"><%= flash.type === 'error' ? 'Fehler' : 'Erfolg' %></strong>
                <div class="toast-message"><%= flash.message %></div>
              </div>
              <button type="button" class="toast-close" data-toast-close aria-label="Meldung schließen">×</button>
            </div>
          <% } %>
        </div>

        <header class="navbar app-mobile-topbar d-lg-none sticky-top px-3 py-2">
          <a class="app-mobile-brand" href="/" aria-label="Zum Dashboard">
            <img src="<%= resolvedAppLogoUrl %>" alt="" width="38" height="38" />
          </a>
          <div class="d-flex flex-column align-items-start flex-grow-1 mx-2 overflow-hidden">
            <strong class="fs-6 lh-sm text-truncate w-100"><%= pageTitle %></strong>
            <span class="small text-body-secondary text-truncate w-100"><%= appSettings.app_name || "HeartPet" %></span>
          </div>
          <% if (permissions.canEditAnimals && currentPath === '/') { %>
            <a href="/animals/new" class="btn btn-primary btn-sm" data-drawer="animal-form">Neu</a>
          <% } %>
        </header>

        <main class="main-content">
          <div class="container-fluid app-main-container">
            <header class="page-header mb-3 d-none d-lg-block">
              <div class="page-header-body">
                <div class="d-grid gap-1 flex-grow-1 text-start">
                  <h1 class="mb-0"><%= pageTitle %></h1>
                </div>
                <div class="d-flex align-items-center justify-content-end flex-shrink-0 ms-auto">
                  <% if (permissions.canEditAnimals && currentPath === '/') { %>
                    <a href="/animals/new" class="btn btn-primary btn-sm px-3" data-drawer="animal-form">Neues Tier</a>
                  <% } %>
                </div>
              </div>
            </header>

            <div class="main-content-inner">
              <div class="offcanvas offcanvas-bottom app-mobile-offcanvas d-lg-none" tabindex="-1" id="mobileNavOffcanvas" aria-labelledby="mobileNavOffcanvasLabel">
                <div class="offcanvas-header border-bottom">
                  <div>
                    <h5 class="offcanvas-title mb-1" id="mobileNavOffcanvasLabel">Mehr</h5>
                    <p class="mb-0 small text-body-secondary">Konto, Hilfe und Verwaltung</p>
                  </div>
                  <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Schließen"></button>
                </div>
                <div class="offcanvas-body d-flex flex-column gap-4">
                  <% if (permissions.canManageAdmin) { %>
                    <section aria-labelledby="mobile-admin-nav-title">
                      <h6 class="mb-2" id="mobile-admin-nav-title">Verwaltung</h6>
                      <nav class="mobile-admin-nav" aria-label="Mobile Verwaltung">
                        <a class="mobile-admin-nav-item <%= currentPath === '/admin/allgemein' ? 'active' : '' %>" href="/admin/allgemein"><span aria-hidden="true">⚙</span><span>Allgemein</span></a>
                        <a class="mobile-admin-nav-item <%= currentPath === '/admin/stall' ? 'active' : '' %>" href="/admin/stall"><span aria-hidden="true">🏠</span><span>Stall</span></a>
                        <a class="mobile-admin-nav-item <%= currentPath === '/admin/benachrichtigungen' ? 'active' : '' %>" href="/admin/benachrichtigungen"><span aria-hidden="true">🔔</span><span>Benachrichtigungen</span></a>
                        <a class="mobile-admin-nav-item <%= currentPath === '/admin/stammdaten' ? 'active' : '' %>" href="/admin/stammdaten"><span aria-hidden="true">▦</span><span>Stammdaten</span></a>
                        <a class="mobile-admin-nav-item <%= currentPath === '/admin/benutzer' ? 'active' : '' %>" href="/admin/benutzer"><span aria-hidden="true">👤</span><span>Benutzer</span></a>
                        <a class="mobile-admin-nav-item <%= currentPath === '/admin/import' ? 'active' : '' %>" href="/admin/import"><span aria-hidden="true">⇩</span><span>Import</span></a>
                        <a class="mobile-admin-nav-item <%= currentPath === '/admin/systemlog' ? 'active' : '' %>" href="/admin/systemlog"><span aria-hidden="true">≡</span><span>Systemlog</span></a>
                      </nav>
                    </section>
                  <% } %>
                  <div class="row g-2">
                    <div class="col-6"><a class="btn btn-outline-secondary w-100 text-start p-3" href="/hilfe"><strong class="d-block">Hilfe</strong><span class="small">Anleitungen</span></a></div>
                    <div class="col-6"><a class="btn btn-outline-secondary w-100 text-start p-3" href="/kontakt"><strong class="d-block">Kontakt</strong><span class="small">Rückfragen</span></a></div>
                  </div>

                  <div class="app-mobile-account mt-auto">
                    <div class="small-label">Eingeloggt als</div>
                    <% const mobileDisplayName = String(currentUser?.name || "").trim(); %>
                    <strong><%= mobileDisplayName || "-" %></strong>
                    <form method="post" action="/logout" class="mt-3">
                      <button type="submit" class="btn btn-outline-secondary w-100">Abmelden</button>
                    </form>
                  </div>
                </div>
              </div>

              <nav class="app-mobile-bottom-nav d-lg-none" aria-label="Mobile Hauptnavigation">
                <a class="app-mobile-nav-item <%= currentPath === '/' ? 'active' : '' %>" href="/">
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 11.5 12 4l9 7.5v8a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1z"/></svg>
                  <span>Start</span>
                </a>
                <a class="app-mobile-nav-item <%= currentPath === '/animals' || /^\/animals\/\d+/.test(currentPath || '') ? 'active' : '' %>" href="/animals">
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8.4 11.3c1.2 0 2.1-1.2 2.1-2.7S9.6 6 8.4 6 6.3 7.2 6.3 8.6s.9 2.7 2.1 2.7Zm7.2 0c1.2 0 2.1-1.2 2.1-2.7S16.8 6 15.6 6s-2.1 1.2-2.1 2.6.9 2.7 2.1 2.7ZM5.5 15c1 0 1.8-1 1.8-2.2s-.8-2.2-1.8-2.2-1.8 1-1.8 2.2S4.5 15 5.5 15Zm13 0c1 0 1.8-1 1.8-2.2s-.8-2.2-1.8-2.2-1.8 1-1.8 2.2.8 2.2 1.8 2.2ZM12 12.2c-2.7 0-5.2 2.5-5.2 4.8 0 1.8 1.5 3 3.3 3 .7 0 1.3-.3 1.9-.3s1.2.3 1.9.3c1.8 0 3.3-1.2 3.3-3 0-2.3-2.5-4.8-5.2-4.8Z"/></svg>
                  <span>Tiere</span>
                </a>
                <a class="app-mobile-nav-item <%= currentPath === '/animals/historie' ? 'active' : '' %>" href="/animals/historie">
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5a7 7 0 1 1-6.5 4.4M3 5v5h5M12 8v4l3 2"/></svg>
                  <span>Historie</span>
                </a>
                <button class="app-mobile-nav-item <%= (currentPath || '').startsWith('/admin') ? 'active' : '' %>" type="button" data-bs-toggle="offcanvas" data-bs-target="#mobileNavOffcanvas" aria-controls="mobileNavOffcanvas">
                  <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="5" cy="12" r="1.5"/><circle cx="12" cy="12" r="1.5"/><circle cx="19" cy="12" r="1.5"/></svg>
                  <span>Mehr</span>
                </button>
              </nav>
