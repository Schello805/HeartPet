            </div>
          </div>
        </main>
      </div>

      <div class="offcanvas offcanvas-end drawer-panel" tabindex="-1" id="app-drawer" aria-labelledby="drawer-title">
        <div class="offcanvas-header drawer-header">
          <h5 class="offcanvas-title mb-0" id="drawer-title">Bearbeiten</h5>
          <button type="button" class="btn-close btn-close-white drawer-close" data-bs-dismiss="offcanvas" aria-label="Fenster schließen"></button>
        </div>
        <div class="offcanvas-body drawer-body" data-drawer-body></div>
      </div>

      <div class="modal fade" id="app-confirm-modal" tabindex="-1" aria-labelledby="app-confirm-modal-title" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-sm">
          <div class="modal-content border-0 shadow-lg">
            <div class="modal-body p-4 text-center">
              <div class="app-confirm-icon mx-auto mb-3" aria-hidden="true" data-confirm-modal-icon><%- include('./ui-icon', { name: 'warning' }) %></div>
              <h2 class="h5 mb-2" id="app-confirm-modal-title">Aktion bestätigen</h2>
              <p class="text-body-secondary mb-4" data-confirm-modal-message></p>
              <div class="app-confirm-progress mb-4 d-none" data-confirm-modal-progress role="status" aria-live="polite">
                <strong class="d-block">Aktion wird ausgeführt</strong>
                <span class="small text-body-secondary">Bitte dieses Fenster kurz geöffnet lassen.</span>
                <span class="app-confirm-progress-dots" aria-hidden="true"><i></i><i></i><i></i></span>
              </div>
              <div class="d-grid gap-2" data-confirm-modal-actions>
                <button type="button" class="btn btn-primary" data-confirm-modal-submit>Bestätigen</button>
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Abbrechen</button>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="modal fade" id="event-veterinarian-modal" tabindex="-1" aria-labelledby="event-veterinarian-modal-title" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-sm">
          <div class="modal-content border-0 shadow-lg">
            <div class="modal-body p-4">
              <h2 class="h5 mb-2" id="event-veterinarian-modal-title">Tierarzt fehlt</h2>
              <p class="text-body-secondary mb-3">Wähle den behandelnden Tierarzt aus oder entferne den Haken „Durch Tierarzt“.</p>
              <label class="form-label" for="event-veterinarian-modal-select">Tierarzt</label>
              <select class="form-select mb-4" id="event-veterinarian-modal-select" data-event-veterinarian-modal-select></select>
              <div class="d-grid gap-2">
                <button type="button" class="btn btn-primary" data-event-veterinarian-apply disabled>Tierarzt übernehmen und speichern</button>
                <button type="button" class="btn btn-outline-secondary" data-event-veterinarian-remove>Haken entfernen und speichern</button>
                <button type="button" class="btn btn-link text-body-secondary" data-bs-dismiss="modal">Zurück zum Formular</button>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="modal fade" id="vaccination-completion-modal" tabindex="-1" aria-labelledby="vaccination-completion-modal-title" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-sm">
          <div class="modal-content border-0 shadow-lg">
            <form method="post" data-vaccination-completion-form>
              <div class="modal-body p-4">
                <h2 class="h5 mb-2" id="vaccination-completion-modal-title">Impfung als erledigt markieren</h2>
                <p class="text-body-secondary mb-3" data-vaccination-completion-title></p>
                <label class="form-label" for="vaccination-completion-date">Wann wurde geimpft?</label>
                <input class="form-control mb-4" id="vaccination-completion-date" type="date" name="vaccination_date" required data-vaccination-completion-date />
                <div class="d-grid gap-2">
                  <button type="submit" class="btn btn-primary">Impfung speichern</button>
                  <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Abbrechen</button>
                </div>
              </div>
            </form>
          </div>
        </div>
      </div>

      <div class="modal fade" id="app-install-help-modal" tabindex="-1" aria-labelledby="app-install-help-title" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-sm">
          <div class="modal-content border-0 shadow-lg">
            <div class="modal-body p-4">
              <h2 class="h5 mb-2" id="app-install-help-title">HeartPet installieren</h2>
              <p class="text-body-secondary mb-3" data-app-install-help-text></p>
              <ol class="app-install-steps mb-4" data-app-install-help-steps></ol>
              <button type="button" class="btn btn-primary w-100" data-bs-dismiss="modal">Verstanden</button>
            </div>
          </div>
        </div>
      </div>

      <% if (permissions.canManageAdmin && typeof runtimeFeatures !== 'undefined' && runtimeFeatures.updateStatus) { %>
      <div class="modal fade" id="app-update-modal" tabindex="-1" aria-labelledby="app-update-modal-title" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-sm">
          <div class="modal-content border-0 shadow-lg">
            <div class="modal-body p-4">
              <h2 class="h5 mb-2" id="app-update-modal-title">HeartPet aktualisieren</h2>
              <p class="text-body-secondary mb-3">Auf GitHub ist Version <strong data-update-latest-version></strong> verfügbar. Führe auf dem HeartPet-Server diesen Befehl aus:</p>
              <code class="d-block p-3 rounded bg-body-tertiary text-break mb-3" data-update-command>cd /opt/HeartPet &amp;&amp; ./scripts/update.sh</code>
              <div class="d-grid gap-2">
                <button type="button" class="btn btn-primary" data-update-copy>Konsolenbefehl kopieren</button>
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Schließen</button>
              </div>
            </div>
          </div>
        </div>
      </div>
      <% } %>

    </div>

    <footer class="app-footer">
      <div class="container-fluid">
        <div class="d-flex flex-wrap gap-3 justify-content-center justify-content-lg-start align-items-center">
          <a href="/hilfe">Hilfe</a>
          <% if (permissions.canManageAdmin) { %><a href="/admin/allgemein">Verwaltung</a><% } %>
          <span class="text-body-secondary">Version <%= typeof appRevision !== 'undefined' ? appRevision : 'dev' %></span>
          <% if (permissions.canManageAdmin && typeof runtimeFeatures !== 'undefined' && runtimeFeatures.updateStatus) { %><button type="button" class="btn btn-link btn-sm p-0 d-none" data-update-indicator data-bs-toggle="modal" data-bs-target="#app-update-modal">Update verfügbar</button><% } %>
        </div>
      </div>
    </footer>
    <script src="/static/vendor/bootstrap/bootstrap.bundle.min.js?v=<%= encodeURIComponent(typeof appRevision !== 'undefined' ? appRevision : 'dev') %>"></script>
    <script src="/static/js/features.js?v=<%= encodeURIComponent(typeof appRevision !== 'undefined' ? appRevision : 'dev') %>"></script>
    <script src="/static/js/password-visibility.js?v=<%= encodeURIComponent(typeof appRevision !== 'undefined' ? appRevision : 'dev') %>"></script>
    <script src="/static/js/device-features.js?v=<%= encodeURIComponent(typeof appRevision !== 'undefined' ? appRevision : 'dev') %>"></script>
    <script src="/static/js/dashboard-customizer.js?v=<%= encodeURIComponent(typeof appRevision !== 'undefined' ? appRevision : 'dev') %>"></script>
    <script src="/static/js/form-validation.js?v=<%= encodeURIComponent(typeof appRevision !== 'undefined' ? appRevision : 'dev') %>"></script>
    <script src="/static/js/animal-status.js?v=<%= encodeURIComponent(typeof appRevision !== 'undefined' ? appRevision : 'dev') %>"></script>
    <script src="/static/js/global-search.js?v=<%= encodeURIComponent(typeof appRevision !== 'undefined' ? appRevision : 'dev') %>"></script>
    <script src="/static/js/drawer.js?v=<%= encodeURIComponent(typeof appRevision !== 'undefined' ? appRevision : 'dev') %>"></script>
    <script src="/static/js/quick-entry.js?v=<%= encodeURIComponent(typeof appRevision !== 'undefined' ? appRevision : 'dev') %>"></script>
    <script src="/static/js/app.js?v=<%= encodeURIComponent(typeof appRevision !== 'undefined' ? appRevision : 'dev') %>"></script>
  </body>
</html>
