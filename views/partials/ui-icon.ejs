  <% } else if (iconName === 'video') { %><rect x="3" y="6" width="13" height="12" rx="2"/><path d="m16 10 5-3v10l-5-3"/>
  <% } else if (iconName === 'open') { %><path d="M5 20h14M7 20V8h10v12M9 11h6M9 14h6"/><path d="m8 5 4-3 4 3"/>
  <% } else if (iconName === 'close') { %><path d="M5 20h14M7 20V8h10v12M9 11h6M9 14h6"/><path d="m8 2 4 3 4-3"/>
